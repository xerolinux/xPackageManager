# Maintainer: Your Name <your.email@example.com>
#
# Build with ./build.sh (in this directory). On systems whose repos don't provide
# `downgrade` / `appimageupdate`, build.sh first builds those from the standalone
# PKGBUILDs under deps/ (real, separately-removable packages with their OWN
# versions - never the AUR), then builds this. Clean with: ./build.sh --clean
pkgname=xpm-gui
pkgver=0.7.1
pkgrel=1
pkgdesc="A modern package manager for Arch Linux supporting pacman, Flatpak and AppImage"
arch=('x86_64')
url="https://github.com/xerolinux/xPackageManager"
license=('GPL-3.0-or-later')
depends=(
    'pacman'
    'flatpak'
    'polkit'
    'fontconfig'
    'freetype2'
    'qt6-base'
    'curl'
    'misc-hooks'
    'desktop-file-utils'
    'fuse2'
    'fuse3'
    'zenity'
    'downgrade'        # repo package, or built by build.sh from deps/downgrade
    'appimageupdate'   # provided by appimageupdate-git (repo or deps/appimageupdate-git)
)
makedepends=('rust' 'cargo' 'qt6-base')
optdepends=(
    'archlinux-appstream-data: application icons for repo packages that are not installed'
    'noto-fonts: Noto Sans, the UI font (falls back to the system sans-serif)'
    'sccache: faster incremental Rust builds'
    'mold: faster linker (cuts link time significantly)'
    'kdialog: native file picker for AppImage install (KDE)'
)
provides=('xpackagemanager')
conflicts=('xpackagemanager-git')
options=('!debug')
source=()
sha256sums=()

# Project root is one directory up from packaging/
_projectdir="$startdir/.."

build() {
    cd "$_projectdir"

    # Use Qt6 for native system theme integration
    export QMAKE=qmake6

    # Strip -flto flags from C/CXX flags — LTO breaks the cpp crate's
    # struct metadata extraction used by qttypes (Slint Qt backend)
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    export CFLAGS="${CFLAGS//-flto/}"
    export CXXFLAGS="${CXXFLAGS//-flto/}"

    # Use sccache if available for faster incremental builds
    command -v sccache &>/dev/null && export RUSTC_WRAPPER=sccache

    # Use mold linker if available — dramatically cuts link time
    if command -v mold &>/dev/null; then
        export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=mold"
    fi

    # On low-memory machines with no swap, building several crates at once on
    # top of the big xpm-ui crate can trip the OOM-killer (SIGKILL). If under
    # ~10GB total RAM, serialize crate compilation to keep peak memory down.
    _memkb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "${_memkb:-0}" -gt 0 ] && [ "$_memkb" -lt 10485760 ]; then
        export CARGO_BUILD_JOBS=1
        echo "==> Low RAM detected ($((_memkb/1024))MB): building with -j1 to avoid OOM"
    fi

    # Build with the 'pkg' profile: no LTO + 16 codegen units, tuned for low
    # peak memory (see Cargo.toml). Near-identical runtime speed; builds on
    # constrained machines without OOM.
    cargo build --profile pkg --bin xpackagemanager
}

package() {
    cd "$_projectdir"

    install -Dm755 "target/pkg/xpackagemanager" "$pkgdir/usr/bin/xpackagemanager"
    install -Dm644 "packaging/xpackagemanager.desktop" "$pkgdir/usr/share/applications/xpackagemanager.desktop"
    install -Dm644 "packaging/xPM.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/xpackagemanager.png"
    install -Dm644 "packaging/x-alpm-package.xml" "$pkgdir/usr/share/mime/packages/x-alpm-package.xml"
    install -Dm644 "packaging/org.xpackagemanager.policy" "$pkgdir/usr/share/polkit-1/actions/org.xpackagemanager.policy"

    rm -rf target/pkg
}

post_install() {
    update-mime-database /usr/share/mime &>/dev/null || true
    update-desktop-database -q || true
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor &>/dev/null || true
}

post_upgrade() {
    post_install
}

post_remove() {
    post_install
}
