    function open-flatpak-detail(pkg: PackageData) {
        current-flatpak-id = pkg.name;
        flatpak-detail-installed = pkg.installed;
        flatpak-detail-name = pkg.display-name;
        flatpak-detail-summary = pkg.description;
        flatpak-detail-description = "";
        flatpak-detail-developer = "";
        flatpak-detail-version = "";
        flatpak-detail-version-date = "";
        flatpak-detail-license = "";
        flatpak-detail-url-homepage = "";
        flatpak-detail-url-bug = "";
        flatpak-detail-url-translate = "";
        flatpak-detail-url-vcs = "";
        flatpak-detail-url-donate = "";
        flatpak-detail-url-help = "";
        flatpak-detail-download-size = "";
        flatpak-detail-installed-size = "";
        flatpak-detail-installs = "";
        flatpak-detail-verified = false;
        flatpak-detail-tags = [];
        flatpak-releases = [];
        flatpak-shots = [];
        flatpak-shot-index = 0;
        flatpak-detail-icon = @image-url("");
        flatpak-addons = [];
        flatpak-addons-installed = [];
        root.load-flatpak-detail(pkg.name);
        root.load-flatpak-icon(pkg.name);
        show-flatpak-detail = true;
    }

    function get-list() -> [PackageData] {
        if view == 0 { return installed-packages; }
        if view == 1 { return update-packages; }
        if view == 10 { return remote-apps; }
        if view == 8 { return repo-packages; }
        return [];
    }

    Rectangle {
        x: 0;
        y: 0;
        width: sidebar-vl.preferred-width;
        height: parent.height;
        background: Cat.sidebar;

        sidebar-vl := VerticalLayout {
            padding: 12px;
            spacing: 2px;

            VerticalLayout {
                alignment: center;
                spacing: 6px;
                padding-bottom: 4px;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("xerolinux.png");
                        width: 100px;
                        height: 100px;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "XeroLinux";
                        font-size: Cat.fs22;
                        font-weight: 800;
                        letter-spacing: 0.3px;
                        color: Cat.mauve;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: @tr("Package Manager GUI");
                            font-size: Cat.fs12;
                            font-weight: 700;
                            color: Cat.text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(XPM)";
                            font-size: Cat.fs11;
                            font-weight: 600;
                            color: Cat.overlay0;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 8px; }
            HorizontalLayout {
                padding-left: 10px;
                SectionLabel { section-title: @tr("LIBRARY"); }
            }
            Rectangle { height: 4px; }

            NavButton {
                icon-path: icon-home;
                label: @tr("Home");
                tooltip-text: @tr("Overview, quick actions and cache management");
                active: view == 9;
                clicked => { view = 9; }
            }

            if setting-flatpak-enabled: NavButton {
                icon-path: icon-flatpak;
                label: @tr("Flatpaks");
                tooltip-text: @tr("Browse and install Flatpak applications");
                active: view == 10;
                clicked => {
                    view = 10; selected-index = -1; show-flatpak-detail = false;
                    if flatpak-remotes.length == 0 { root.browse-remote(""); }
                }
            }

            NavButton {
                icon-path: icon-folder;
                label: @tr("Packages");
                tooltip-text: @tr("Browse and install packages from Arch repositories");
                active: view == 7 || view == 8;
                clicked => {
                    view = 7; repos-view = 0; selected-index = -1;
                    if pacman-repos.length == 0 { root.load-pacman-repos(); }
                    if repo-packages.length == 0 && !repo-loading { root.browse-repo(""); }
                }
            }

            if setting-appimage-enabled: NavButton {
                icon-path: icon-image;
                label: @tr("AppImages");
                tooltip-text: @tr("Install and manage AppImages");
                active: view == 14;
                clicked => {
                    view = 14; selected-index = -1;
                    root.load-installed-appimages();
                    if catalog-appimages.length == 0 { root.load-appimage-catalog(); }
                }
            }

            NavButton {
                icon-path: icon-rss;
                label: @tr("Arch News");
                tooltip-text: @tr("View latest Arch Linux news and announcements");
                active: view == 13;
                clicked => {
                    view = 13;
                    if arch-news-items.length == 0 { root.refresh-arch-news(); }
                }
            }

            Rectangle { height: 6px; }
            Rectangle { height: 1px; background: Cat.divider; }
            Rectangle { height: 6px; }

            NavButton {
                icon-path: icon-wrench;
                label: @tr("Troubleshooting");
                tooltip-text: @tr("Fix orphaned packages and manage ignored packages");
                active: view == 11;
                clicked => { view = 11; root.read-ignorepkg(); }
            }

            NavButton {
                icon-path: icon-gear;
                label: @tr("Settings & Tweaks");
                tooltip-text: @tr("Configure pacman settings, parallel downloads and held packages");
                active: view == 5;
                clicked => { view = 5; root.read-holdpkg(); }
            }

            Rectangle { vertical-stretch: 1; }

            if total-update-count > 0: NavButton {
                icon-path: icon-arrow-up;
                label: @tr("Updates");
                tooltip-text: @tr("View and install available package updates");
                badge: total-update-count;
                active: view == 1;
                clicked => { view = 1; selected-index = -1; }
            }

            sync-btn := Rectangle {
                property <bool> checking: busy || loading;
                height: 31px;
                border-radius: 8px;
                background: sync-btn.checking ? Cat.mauve.with-alpha(0.5) : (sync-touch.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85));
                animate background { duration: 100ms; }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    if sync-btn.checking: VerticalLayout {
                        alignment: center;
                        LoadingCircle { diameter: 16px; dot-color: Cat.crust; }
                    }
                    Text {
                        text: sync-btn.checking ? @tr("Checking…") : @tr("Check for Updates");
                        font-size: Cat.fs13;
                        font-weight: 600;
                        color: Cat.crust;
                        vertical-alignment: center;
                    }
                }

                sync-touch := TouchArea {
                    mouse-cursor: sync-btn.checking ? default : pointer;
                    clicked => { if !sync-btn.checking { root.sync-databases(); } }
                }
            }

            Rectangle { height: 8px; }

            HorizontalLayout {
                padding-left: 4px;
                spacing: 4px;

                Text {
                    text: stats.pacman-count + " pacman";
                    font-size: Cat.fs13;
                    color: Cat.overlay1;
                }
                if setting-flatpak-enabled: Text {
                    text: "/";
                    font-size: Cat.fs13;
                    color: Cat.overlay0;
                }
                if setting-flatpak-enabled: Text {
                    text: stats.flatpak-count + " flatpak";
                    font-size: Cat.fs13;
                    color: Cat.overlay1;
                }
                if setting-appimage-enabled: Text {
                    text: "/";
                    font-size: Cat.fs13;
                    color: Cat.overlay0;
                }
                if setting-appimage-enabled: Text {
                    text: installed-appimages.length + " appimage";
                    font-size: Cat.fs13;
                    color: Cat.overlay1;
                }
            }
        }
    }

    Rectangle {
        x: sidebar-vl.preferred-width;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Cat.divider;
    }

    Rectangle {
        x: sidebar-vl.preferred-width + 1px;
        y: 0;
        width: parent.width - sidebar-vl.preferred-width - 1px;
        height: parent.height;
        clip: true;

        Rectangle {
            visible: view == 9;
            x: parent.width - self.width - 10px;
            y: 10px;
            width: 82px;
            height: 26px;
            z: 10;
            border-radius: 7px;
            background: Cat.surface0.with-alpha(0.85);
            border-width: 1px;
            border-color: Cat.surface1;

            HorizontalLayout {
                padding: 0px; spacing: 0px;

                Rectangle {
                    width: 26px; height: 26px; border-radius: 6px;
                    background: fs-dec-ta.has-hover ? Cat.surface1 : transparent;
                    animate background { duration: 60ms; }
                    Text { text: "A-"; font-size: 10px; font-weight: 700; color: Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; }
                    fs-dec-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if Cat.font-scale > 0.72 {
                                Cat.font-scale = round((Cat.font-scale - 0.1) * 10) / 10;
                                root.save-font-scale(Cat.font-scale);
                            }
                        }
                    }
                }

                Rectangle { width: 1px; height: 14px; y: 6px; background: Cat.surface1; }

                Rectangle {
                    width: 28px; height: 26px;
                    Text {
                        text: Cat.font-scale == 1.0 ? "1×"
                            : Cat.font-scale == 0.9 ? "0.9×"
                            : Cat.font-scale == 0.8 ? "0.8×"
                            : Cat.font-scale == 1.1 ? "1.1×"
                            : Cat.font-scale == 1.2 ? "1.2×"
                            : Cat.font-scale == 1.3 ? "1.3×"
                            : Cat.font-scale == 1.4 ? "1.4×"
                            : "?×";
                        font-size: 9px; font-weight: 600;
                        color: Cat.font-scale == 1.0 ? Cat.overlay1 : Cat.mauve;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                Rectangle { width: 1px; height: 14px; y: 6px; background: Cat.surface1; }

                Rectangle {
                    width: 26px; height: 26px; border-radius: 6px;
                    background: fs-inc-ta.has-hover ? Cat.surface1 : transparent;
                    animate background { duration: 60ms; }
                    Text { text: "A+"; font-size: 10px; font-weight: 700; color: Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; }
                    fs-inc-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if Cat.font-scale < 1.48 {
                                Cat.font-scale = round((Cat.font-scale + 0.1) * 10) / 10;
                                root.save-font-scale(Cat.font-scale);
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: (view == 11 || view == 12) ? 0px : 24px;
            padding-top: (view == 11 || view == 12) ? 0px : 20px;
            spacing: 12px;

            if view != 11 && view != 12 && view != 15: HorizontalLayout {
                spacing: 12px;

                Text {
                    text: view == 9 ? "Home" :
                          view == 0 ? "Installed" :
                          view == 1 ? "Updates" :
                          view == 2 ? "Search Results" :
                          view == 5 ? "Settings" :
                          view == 7 ? "Packages" :
                          view == 8 ? selected-repo :
                          view == 10 ? (show-flatpak-detail ? flatpak-detail-name : "Flatpaks") :
                          view == 14 ? "AppImages" :
                          view == 13 ? "Arch News" : "";
                    font-size: Cat.fs22;
                    font-weight: 700;
                    color: Cat.text;
                }

                Rectangle { horizontal-stretch: 1; }

                if (view == 0 || view == 1 || view == 8) || (view == 10 && !show-flatpak-detail): Text {
                    text: view == 10
                        ? (flatpak-total-matches + " packages")
                        : view == 1
                            ? @tr("{n} update" | "{n} updates" % total-update-count)
                            : view == 0
                                ? (stats.pacman-count + " packages")
                                : (get-list().length + " packages");
                    font-size: Cat.fs13;
                    color: Cat.overlay0;
                    vertical-alignment: center;
                }

                if view == 1 && total-update-count > 0: Rectangle {
                    height: 32px;
                    width: upd-all-lbl.preferred-width + 28px;
                    border-radius: 8px;
                    background: busy ? Cat.surface0 : (upd-all-touch.has-hover ? Cat.green : Cat.green.with-alpha(0.9));
                    animate background { duration: 100ms; }

                    upd-all-lbl := Text {
                        text: @tr("Update All");
                        font-size: Cat.fs13;
                        font-weight: 700;
                        color: busy ? Cat.overlay0 : Cat.crust;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    upd-all-touch := TouchArea {
                        mouse-cursor: busy ? default : pointer;
                        clicked => { if !busy { root.update-all(); } }
                    }
                }

                if view == 0: RefreshButton {
                    clicked => { root.refresh(); }
                }

                if view == 7 || view == 8: RefreshButton {
                    loading: repo-loading;
                    enabled: !repo-loading;
                    clicked => {
                        root.load-pacman-repos();
                        root.browse-repo(view == 8 ? selected-repo : "");
                    }
                }


                if view == 13: Btn {
                    label: arch-news-loading ? "Loading..." : "Refresh";
                    enabled: !arch-news-loading;
                    clicked => { root.refresh-arch-news(); }
                }
            }

            if view != 11 && view != 12 && view != 15: Rectangle { height: 1px; background: Cat.divider; }

            if view == 0: VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 62px;
                    background: transparent;

                    TouchArea { clicked => { inst-ti.focus(); } }

                    Rectangle {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        height: 42px;
                        border-radius: 10px;
                        background: inst-ti.has-focus ? Cat.surface1 : Cat.surface0;
                        border-width: 1.5px;
                        border-color: inst-ti.has-focus ? Cat.blue.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                        clip: true;
                        animate background { duration: 80ms; }
                        animate border-color { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                    icon-color: inst-ti.has-focus ? Cat.blue : Cat.subtext0;
                                    width: 16px;
                                    height: 16px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;

                                inst-ti := TextInput {
                                    width: 100%; height: 100%;
                                    text <=> installed-filter-text;
                                    font-size: Cat.fs15;
                                    color: Cat.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Cat.blue.with-alpha(0.3);
                                    selection-foreground-color: Cat.text;
                                    edited => { root.filter-installed(self.text); }
                                    accepted => { root.filter-installed(self.text); }
                                }

                                if installed-filter-text == "" && !inst-ti.has-focus: Text {
                                    width: 100%; height: 100%;
                                    text: @tr("Filter installed...");
                                    font-size: Cat.fs15;
                                    color: Cat.subtext0.with-alpha(0.5);
                                    vertical-alignment: center;
                                }
                            }

                            if installed-filter-text != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 20px; height: 20px; border-radius: 10px;
                                    background: clr-touch.has-hover ? Cat.surface2 : Cat.surface1;
                                    animate background { duration: 60ms; }
                                    NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.subtext0; width: 10px; height: 10px; x: 5px; y: 5px; }
                                    clr-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { installed-filter-text = ""; root.filter-installed(""); }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 62px;
                    background: transparent;

                    TouchArea { clicked => { all-pkg-ti.focus(); } }

                    Rectangle {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        height: 42px;
                        border-radius: 10px;
                        background: all-pkg-ti.has-focus ? Cat.surface1 : Cat.surface0;
                        border-width: 1.5px;
                        border-color: all-pkg-ti.has-focus ? Cat.mauve.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                        clip: true;
                        animate background { duration: 80ms; }
                        animate border-color { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                    icon-color: all-pkg-ti.has-focus ? Cat.mauve : Cat.subtext0;
                                    width: 16px;
                                    height: 16px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;

                                all-pkg-ti := TextInput {
                                    width: 100%; height: 100%;
                                    text <=> search-text;
                                    font-size: Cat.fs15;
                                    color: Cat.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Cat.mauve.with-alpha(0.3);
                                    selection-foreground-color: Cat.text;
                                    accepted => {
                                        if search-text != "" {
                                            view = 2;
                                            root.search(search-text);
                                        }
                                    }
                                }

                                if search-text == "" && !all-pkg-ti.has-focus: Text {
                                    width: 100%; height: 100%;
                                    text: @tr("Search all packages...");
                                    font-size: Cat.fs15;
                                    color: Cat.subtext0.with-alpha(0.5);
                                    vertical-alignment: center;
                                }
                            }

                            if search-text != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 20px; height: 20px; border-radius: 10px;
                                    background: all-clr.has-hover ? Cat.surface2 : Cat.surface1;
                                    animate background { duration: 60ms; }
                                    NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.subtext0; width: 10px; height: 10px; x: 5px; y: 5px; }
                                    all-clr := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { search-text = ""; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !loading && view == 2 && search-installed.length == 0 && search-available.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 8px;

                NavIcon {
                    d: icon-search;
                    icon-color: Cat.surface2;
                    width: 32px;
                    height: 29px;
                    x: (parent.width - 32px) / 2;
                }

                Text {
                    text: @tr("Search for packages");
                    font-size: Cat.fs15;
                    color: Cat.overlay0;
                    horizontal-alignment: center;
                }
            }

            if loading && (view == 0 || view == 1): VerticalLayout {
                vertical-stretch: 1;
                spacing: 1px;
                for i in [0, 1, 2, 3, 4, 5, 6, 7]: Rectangle {
                    height: 47px;
                    background: Math.mod(i, 2) == 0 ? Cat.surface0.with-alpha(0.15) : transparent;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 120px; height: 12px; border-radius: 4px; background: Cat.surface0.with-alpha(0.5); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 60px; height: 10px; border-radius: 4px; background: Cat.surface0.with-alpha(0.35); }
                        }
                    }
                }
            }

            if !loading && (view == 0 || view == 1) && get-list().length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 8px;

                NavIcon {
                    d: icon-package;
                    icon-color: Cat.surface2;
                    width: 32px;
                    height: 29px;
                    x: (parent.width - 32px) / 2;
                }

                Text {
                    text: @tr("No packages found");
                    font-size: Cat.fs15;
                    color: Cat.overlay0;
                    horizontal-alignment: center;
                }
            }

            if !loading && view == 0 && installed-packages.length > 0: VerticalLayout {
                vertical-stretch: 1;

                ListView {
                    vertical-stretch: 1;
                    for p[i] in installed-packages: PackageRow {
                        pkg: p;
                        show-separator: i < installed-packages.length - 1;
                        show-checkbox: multi-select-mode;
                        install => { root.request-install(p.name, p.backend); }
                        remove => { root.request-remove(p.name, p.backend); }
                        toggle-selected(val) => { root.toggle-package-selected(p.name, p.backend, val); }
                    }
                }

                if total-pages > 1: Paginator {
                    current-page: root.current-page;
                    total-pages: root.total-pages;
                    go-to-page(p) => { root.current-page = p; root.load-page(p); }
                }
            }

            if !loading && view == 1 && total-update-count > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    if update-packages.length > 0: Rectangle {
                        height: 29px;
                        background: Cat.surface0.with-alpha(0.4);
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            spacing: 8px;
                            VerticalLayout { alignment: center;
                                Text { text: @tr("NATIVE PACKAGES"); font-size: Cat.fs10; font-weight: 700; color: Cat.mauve; letter-spacing: 0.8px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout { alignment: center;
                                Text { text: @tr("{n} update" | "{n} updates" % update-packages.length); font-size: Cat.fs12; color: Cat.overlay1; }
                            }
                        }
                    }
                    if update-packages.length > 0: VerticalLayout {
                        spacing: 0px;
                        for p[i] in update-packages: PackageRow {
                            pkg: p;
                            show-separator: i < update-packages.length - 1;
                            show-checkbox: false;
                            show-action-button: false;
                            install => { }
                            remove => { }
                        }
                    }

                    if flatpak-update-packages.length > 0: Rectangle {
                        height: 29px;
                        background: Cat.surface0.with-alpha(0.4);
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            spacing: 8px;
                            VerticalLayout { alignment: center;
                                Text { text: @tr("FLATPAKS"); font-size: Cat.fs10; font-weight: 700; color: Cat.blue; letter-spacing: 0.8px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout { alignment: center;
                                Text { text: @tr("{n} update" | "{n} updates" % flatpak-update-packages.length); font-size: Cat.fs12; color: Cat.overlay1; }
                            }
                        }
                    }
                    if flatpak-update-packages.length > 0: VerticalLayout {
                        spacing: 0px;
                        for p[i] in flatpak-update-packages: PackageRow {
                            pkg: p;
                            show-separator: i < flatpak-update-packages.length - 1;
                            show-checkbox: false;
                            show-action-button: true;
                            install => { root.request-update(p.name, p.backend); }
                            remove => { }
                        }
                    }

                    if appimage-update-packages.length > 0: Rectangle {
                        height: 29px;
                        background: Cat.surface0.with-alpha(0.4);
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            spacing: 8px;
                            VerticalLayout { alignment: center;
                                Text { text: @tr("APPIMAGES"); font-size: Cat.fs10; font-weight: 700; color: Cat.peach; letter-spacing: 0.8px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout { alignment: center;
                                Text { text: @tr("{n} update" | "{n} updates" % appimage-update-packages.length); font-size: Cat.fs12; color: Cat.overlay1; }
                            }
                        }
                    }
                    if appimage-update-packages.length > 0: VerticalLayout {
                        spacing: 0px;
                        for p[i] in appimage-update-packages: PackageRow {
                            pkg: p;
                            show-separator: i < appimage-update-packages.length - 1;
                            show-checkbox: false;
                            show-action-button: true;
                            install => { root.update-appimage(p.name); }
                            remove => { }
                        }
                    }
                }
            }

            if !loading && view == 1 && total-update-count == 0: VerticalLayout {
                vertical-stretch: 1; alignment: center;
                Text { text: @tr("System is up to date"); font-size: Cat.fs15; color: Cat.overlay0; horizontal-alignment: center; }
            }

            if view == 10: VerticalLayout {
                vertical-stretch: 1;
                spacing: 0;

                Rectangle {
                    height: 40px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 0;

                        Rectangle {
                            width: 90px;
                            height: parent.height;
                            Text {
                                text: @tr("Browse");
                                font-size: Cat.fs15;
                                font-weight: flatpak-tab == 0 ? 700 : 500;
                                color: flatpak-tab == 0 ? Cat.mauve : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                width: parent.width;
                                background: flatpak-tab == 0 ? Cat.mauve : transparent;
                                animate background { duration: 120ms; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { flatpak-tab = 0; show-flatpak-detail = false; }
                            }
                        }

                        Rectangle {
                            width: 100px;
                            height: parent.height;
                            Text {
                                text: @tr("Installed");
                                font-size: Cat.fs15;
                                font-weight: flatpak-tab == 1 ? 700 : 500;
                                color: flatpak-tab == 1 ? Cat.green : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                width: parent.width;
                                background: flatpak-tab == 1 ? Cat.green : transparent;
                                animate background { duration: 120ms; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    flatpak-tab = 1;
                                    show-flatpak-detail = false;
                                    if installed-flatpaks.length == 0 { root.load-installed-flatpaks(); }
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Refresh the current flatpak list (re-pull appstream).
                        if flatpak-tab == 0: VerticalLayout {
                            alignment: center;
                            padding-right: flatpak-remote-count > 1 ? 8px : 14px;
                            RefreshButton {
                                loading: remote-apps-loading;
                                enabled: !remote-apps-loading;
                                clicked => { show-flatpak-detail = false; flatpak-page = 0; root.refresh-flatpaks(); }
                            }
                        }

                        // Remote selector. Shown only when more than one remote is
                        // enabled; with just Flathub it collapses to a static label.
                        if flatpak-tab == 0 && flatpak-remote-count > 1: VerticalLayout {
                            alignment: center;
                            padding-right: 14px;
                            Rectangle {
                                width: rem-sel-lbl.preferred-width + 58px;
                                height: 30px;
                                border-radius: 8px;
                                background: rem-sel-ta.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.7);
                                border-width: 1px;
                                border-color: rem-sel-ta.has-hover ? Cat.overlay0.with-alpha(0.4) : Cat.surface0;
                                animate background, border-color { duration: 80ms; }
                                HorizontalLayout {
                                    padding-left: 11px; padding-right: 9px;
                                    spacing: 7px;
                                    VerticalLayout {
                                        alignment: center;
                                        NavIcon { d: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4 4 0 003 15z"; icon-color: Cat.mauve.with-alpha(0.8); width: 14px; height: 14px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        rem-sel-lbl := Text {
                                            text: selected-remote;
                                            font-size: Cat.fs13;
                                            font-weight: 600;
                                            color: Cat.subtext0;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        NavIcon { d: "M6 9l6 6 6-6"; icon-color: Cat.overlay1; width: 12px; height: 12px; }
                                    }
                                }
                                rem-sel-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { remote-popup.show(); }
                                }
                                remote-popup := PopupWindow {
                                    x: parent.width - 200px;
                                    y: parent.height + 4px;
                                    width: 200px;
                                    height: Math.min(remote-list-layout.preferred-height + 8px, 320px);
                                    Rectangle {
                                        background: Cat.surface0;
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: Cat.overlay0.with-alpha(0.3);
                                        ScrollView {
                                            remote-list-layout := VerticalLayout {
                                                padding: 4px;
                                                spacing: 2px;
                                                for r[ri] in flatpak-remotes: Rectangle {
                                                    height: 32px;
                                                    border-radius: 6px;
                                                    background: rem-opt-ta.has-hover ? Cat.surface1
                                                        : (r == selected-remote ? Cat.surface1.with-alpha(0.6) : transparent);
                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px; padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: r;
                                                            font-size: Cat.fs13;
                                                            color: r == selected-remote ? Cat.mauve : Cat.text;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                        if r == selected-remote: VerticalLayout {
                                                            alignment: center;
                                                            NavIcon { d: "M20 6L9 17l-5-5"; icon-color: Cat.mauve; width: 13px; height: 13px; }
                                                        }
                                                    }
                                                    rem-opt-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            selected-remote = r;
                                                            show-flatpak-detail = false;
                                                            flatpak-page = 0;
                                                            root.browse-remote(r);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: Cat.surface0;
                    }
                }

                if flatpak-tab == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;

                Rectangle {
                    height: 62px;
                    background: transparent;

                    TouchArea { clicked => { fk-ti.focus(); } }

                    Rectangle {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        height: 42px;
                        border-radius: 10px;
                        background: fk-ti.has-focus ? Cat.surface1 : Cat.surface0;
                        border-width: 1.5px;
                        border-color: fk-ti.has-focus ? Cat.blue.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                        clip: true;
                        animate background { duration: 80ms; }
                        animate border-color { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                    icon-color: fk-ti.has-focus ? Cat.blue : Cat.subtext0;
                                    width: 16px;
                                    height: 16px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;

                                fk-ti := TextInput {
                                    width: 100%; height: 100%;
                                    text <=> flatpak-search;
                                    font-size: Cat.fs15;
                                    color: Cat.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Cat.blue.with-alpha(0.3);
                                    selection-foreground-color: Cat.text;
                                    accepted => {
                                        show-flatpak-detail = false;
                                        flatpak-page = 0;
                                        root.filter-flatpak(selected-flatpak-category, self.text);
                                    }
                                    edited => {
                                        show-flatpak-detail = false;
                                        flatpak-page = 0;
                                        root.filter-flatpak(selected-flatpak-category, self.text);
                                    }
                                }

                                if flatpak-search == "" && !fk-ti.has-focus: Text {
                                    width: 100%; height: 100%;
                                    text: selected-remote == "" ? @tr("Search apps...") : @tr("Search {} apps...", selected-remote);
                                    font-size: Cat.fs15;
                                    color: Cat.subtext0.with-alpha(0.5);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;

                    HorizontalLayout {
                        alignment: center;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;

                        for cat[ci] in flatpak-categories: CategoryPill {
                            label: cat;
                            active: selected-flatpak-category == cat;
                            clicked => {
                                selected-flatpak-category = cat;
                                show-flatpak-detail = false;
                                flatpak-page = 0;
                                root.filter-flatpak(cat, flatpak-search);
                            }
                        }
                    }
                }

                if !show-flatpak-detail: HorizontalLayout {
                    height: 34px;
                    alignment: center;

                    Rectangle {
                        height: 26px;
                        width: addon-pill-lbl.preferred-width + addon-pill-icon.width + 24px;
                        border-radius: 8px;
                        background: Cat.mauve.with-alpha(0.1);
                        border-width: 1px;
                        border-color: Cat.mauve.with-alpha(0.2);

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                            VerticalLayout { alignment: center;
                                addon-pill-icon := NavIcon {
                                    d: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5";
                                    icon-color: Cat.mauve.with-alpha(0.7);
                                    width: 13px; height: 13px;
                                }
                            }
                            addon-pill-lbl := Text {
                                text: @tr("Apps with add-ons are marked  + Add-ons. Install add-ons via the app's info page.");
                                font-size: Cat.fs13;
                                color: Cat.mauve.with-alpha(0.85);
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if remote-apps-loading || !flatpak-store-ready: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 0;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 320px;
                            border-radius: 10px;
                            background: Cat.crust.with-alpha(0.7);
                            border-width: 1px;
                            border-color: Cat.mauve.with-alpha(0.18);
                            clip: true;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Cat.red.with-alpha(0.7); }
                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Cat.yellow.with-alpha(0.7); }
                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Cat.green.with-alpha(0.7); }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "appstream.xml"; font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center; }
                                }

                                VerticalLayout {
                                    spacing: 5px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "$"; font-size: Cat.fs14; color: Cat.mauve; vertical-alignment: center; }
                                        Text { text: "flatpak remote-info flathub"; font-size: Cat.fs14; color: Cat.text; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "›"; font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; }
                                        Text { text: @tr("Parsing appstream metadata..."); font-size: Cat.fs14; color: Cat.subtext0; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "›"; font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; }
                                        Text { text: @tr("Indexing application catalogue"); font-size: Cat.fs14; color: Cat.subtext0; vertical-alignment: center; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 3px;
                                        border-radius: 2px;
                                        background: Cat.surface1;
                                        y: 8px;

                                        Rectangle {
                                            height: 3px;
                                            border-radius: 2px;
                                            background: @linear-gradient(90deg, Cat.mauve 0%, Cat.blue 100%);
                                            width: 60px;
                                            animate width { duration: 900ms; easing: ease-in-out; }
                                        }
                                    }

                                    LoadingCircle { diameter: 14px; }
                                }

                                Text {
                                    text: remote-apps-loading ? "Fetching from remote..." : "Building index...";
                                    font-size: Cat.fs10;
                                    color: Cat.overlay0;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                if !remote-apps-loading && show-flatpak-detail: ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: bk-lbl.preferred-width + 28px;
                                    height: 31px;
                                    border-radius: 8px;
                                    background: bk-touch.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.7);
                                    border-width: 1px;
                                    border-color: Cat.surface0;
                                    animate background { duration: 80ms; }
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center; spacing: 6px;
                                            NavIcon { d: "M19 12H5M12 19l-7-7 7-7"; icon-color: Cat.subtext0; width: 13px; height: 13px; }
                                            bk-lbl := Text { text: @tr("All Apps"); font-size: Cat.fs13; color: Cat.subtext0; }
                                        }
                                    }
                                    bk-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            show-flatpak-detail = false;
                                            flatpak-shots = [];
                                            flatpak-detail-icon = @image-url("");
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle {
                                    width: rem-d-lbl.preferred-width + 14px;
                                    height: 31px;
                                    border-radius: 8px;
                                    background: Cat.surface0.with-alpha(0.5);
                                    rem-d-lbl := Text {
                                        text: selected-remote;
                                        font-size: Cat.fs15;
                                        color: Cat.overlay1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }


                        FpCard {
                            HorizontalLayout {
                                padding: 22px;
                                spacing: 20px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 16px;

                                HorizontalLayout {
                                    spacing: 20px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 96px;
                                            height: 96px;
                                            border-radius: 22px;
                                            clip: true;
                                            background: Cat.surface0;

                                            if flatpak-detail-icon.width > 0: Image {
                                                source: flatpak-detail-icon;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: contain;
                                            }
                                            if flatpak-detail-icon.width == 0: NavIcon {
                                                d: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4";
                                                icon-color: Cat.mauve.with-alpha(0.6);
                                                width: 44px;
                                                height: 44px;
                                                x: 26px;
                                                y: 26px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        alignment: center;

                                        Text {
                                            text: flatpak-detail-name;
                                            font-size: Cat.fs25;
                                            font-weight: 800;
                                            color: Cat.text;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            if flatpak-detail-developer != "": Text {
                                                text: flatpak-detail-developer;
                                                font-size: Cat.fs14;
                                                font-weight: 600;
                                                color: Cat.subtext0;
                                                vertical-alignment: center;
                                            }
                                            if flatpak-detail-verified: Rectangle {
                                                width: ver-lbl.preferred-width + 30px;
                                                height: 22px;
                                                border-radius: 11px;
                                                background: Cat.green.with-alpha(0.16);
                                                border-width: 1px;
                                                border-color: Cat.green.with-alpha(0.4);
                                                HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 5px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        NavIcon { d: "M20 6L9 17l-5-5"; icon-color: Cat.green; width: 11px; height: 11px; }
                                                    }
                                                    ver-lbl := Text { text: @tr("Verified"); font-size: Cat.fs12; font-weight: 700; color: Cat.green; vertical-alignment: center; }
                                                }
                                            }
                                        }

                                        if flatpak-detail-summary != "": Text {
                                            text: flatpak-detail-summary;
                                            font-size: Cat.fs15;
                                            color: Cat.subtext0;
                                            wrap: word-wrap;
                                        }
                                    }

                                }

                                if flatpak-detail-tags.length > 0: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for tag in flatpak-detail-tags: Rectangle {
                                        width: tag-lbl.preferred-width + 18px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: Cat.mauve.with-alpha(0.1);
                                        border-width: 1px;
                                        border-color: Cat.mauve.with-alpha(0.25);
                                        tag-lbl := Text {
                                            text: tag;
                                            font-size: Cat.fs13;
                                            color: Cat.mauve;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                    if !flatpak-detail-installed: Rectangle {
                                        width: 132px;
                                        height: 38px;
                                        border-radius: 10px;
                                        background: inst-touch.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.88);
                                        animate background { duration: 80ms; }
                                        fp-inst-lbl := Text { text: @tr("Install"); font-size: Cat.fs16; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; y: -1px; height: parent.height; }
                                        inst-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                flatpak-detail-installed = true;
                                                root.request-install(current-flatpak-id, 1);
                                            }
                                        }
                                    }
                                    if flatpak-detail-installed: Rectangle {
                                        width: 132px;
                                        height: 38px;
                                        border-radius: 10px;
                                        background: rm-touch.has-hover ? Cat.red : Cat.red.with-alpha(0.85);
                                        animate background { duration: 80ms; }
                                        fp-rm-lbl := Text { text: @tr("Remove"); font-size: Cat.fs16; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; y: -1px; height: parent.height; }
                                        rm-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.fp-confirm-id = current-flatpak-id;
                                                root.fp-confirm-name = flatpak-detail-name;
                                                root.fp-confirm-open = true;
                                            }
                                        }
                                    }

                                    if flatpak-addons.length > 0 || flatpak-addons-installed.length > 0: Rectangle {
                                        width: 132px;
                                        height: 31px;
                                        border-radius: 10px;
                                        property <bool> all-installed: flatpak-addons.length == 0;
                                        property <bool> some-installed: flatpak-addons-installed.length > 0 && flatpak-addons.length > 0;
                                        background: all-installed
                                            ? Cat.green.with-alpha(0.15)
                                            : some-installed
                                                ? Cat.peach.with-alpha(0.15)
                                                : Cat.surface0.with-alpha(0.6);
                                        border-width: 1px;
                                        border-color: all-installed
                                            ? Cat.green.with-alpha(0.3)
                                            : some-installed
                                                ? Cat.peach.with-alpha(0.3)
                                                : Cat.surface1;
                                        animate background { duration: 80ms; }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 7px; height: 7px; border-radius: 3.5px;
                                                    background: all-installed ? Cat.green
                                                        : some-installed ? Cat.peach : Cat.overlay0;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                padding-bottom: 2px;
                                                fp-addons-lbl := Text {
                                                    text: @tr("Add-Ons");
                                                    font-size: Cat.fs13; font-weight: 600;
                                                    color: all-installed ? Cat.green
                                                        : some-installed ? Cat.peach : Cat.subtext0;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        addon-btn-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show-addons-modal = true; }
                                        }
                                    }
                                    }
                            }
                        }

                        if flatpak-shots.length > 0: FpCard {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                Rectangle {
                                    height: 380px;
                                    border-radius: 12px;
                                    clip: true;
                                    background: Cat.crust;
                                    property <image> cur-image: flatpak-shots[clamp(flatpak-shot-index, 0, flatpak-shots.length - 1)].image;

                                    if cur-image.width > 0: Image {
                                        source: cur-image;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: contain;
                                    }
                                    if cur-image.width == 0: HorizontalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            LoadingCircle { diameter: 20px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: @tr("Loading screenshot…"); font-size: Cat.fs13; color: Cat.overlay1; }
                                        }
                                    }
                                    if flatpak-shots.length > 1: FpArrow {
                                        x: 14px;
                                        y: (parent.height - self.height) / 2;
                                        forward: false;
                                        clicked => { flatpak-shot-index = flatpak-shot-index > 0 ? flatpak-shot-index - 1 : flatpak-shots.length - 1; }
                                    }
                                    if flatpak-shots.length > 1: FpArrow {
                                        x: parent.width - self.width - 14px;
                                        y: (parent.height - self.height) / 2;
                                        forward: true;
                                        clicked => { flatpak-shot-index = flatpak-shot-index < flatpak-shots.length - 1 ? flatpak-shot-index + 1 : 0; }
                                    }
                                }

                                if flatpak-shots[clamp(flatpak-shot-index, 0, flatpak-shots.length - 1)].caption != "": Text {
                                    text: flatpak-shots[clamp(flatpak-shot-index, 0, flatpak-shots.length - 1)].caption;
                                    font-size: Cat.fs13;
                                    color: Cat.overlay2;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                if flatpak-shots.length > 1: HorizontalLayout {
                                    alignment: center;
                                    spacing: 7px;
                                    for dot[i] in flatpak-shots: Rectangle {
                                        width: i == flatpak-shot-index ? 22px : 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: i == flatpak-shot-index ? Cat.mauve : Cat.overlay0;
                                        animate width { duration: 120ms; }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { flatpak-shot-index = i; }
                                        }
                                    }
                                }
                            }
                        }

                        FpCard {
                            VerticalLayout {
                                padding: 22px;
                                spacing: 12px;
                                Text { text: @tr("About this app"); font-size: Cat.fs16; font-weight: 700; color: Cat.text; }
                                Text {
                                    text: flatpak-detail-description != "" ? flatpak-detail-description : @tr("No description available.");
                                    font-size: Cat.fs14;
                                    color: flatpak-detail-description != "" ? Cat.text : Cat.overlay0;
                                    wrap: word-wrap;
                                    opacity: 0.92;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 12px;
                            Text { text: @tr("Information"); font-size: Cat.fs16; font-weight: 700; color: Cat.text; }
                            HorizontalLayout {
                                spacing: 12px;
                                if flatpak-detail-version != "": FpTile { label: @tr("VERSION"); value: flatpak-detail-version; accent: Cat.mauve; }
                                if flatpak-detail-version == "": Rectangle { horizontal-stretch: 1; }
                                if flatpak-detail-version-date != "": FpTile { label: @tr("UPDATED"); value: flatpak-detail-version-date; }
                                if flatpak-detail-version-date == "": Rectangle { horizontal-stretch: 1; }
                                if flatpak-detail-license != "": FpTile { label: @tr("LICENSE"); value: flatpak-detail-license; accent: Cat.green; }
                                if flatpak-detail-license == "": Rectangle { horizontal-stretch: 1; }
                                if flatpak-detail-installs != "": FpTile { label: @tr("INSTALLS"); value: flatpak-detail-installs; accent: Cat.blue; }
                                if flatpak-detail-installs == "": Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                if flatpak-detail-download-size != "": FpTile { label: @tr("DOWNLOAD SIZE"); value: flatpak-detail-download-size; accent: Cat.teal; }
                                if flatpak-detail-download-size == "": Rectangle { horizontal-stretch: 1; }
                                if flatpak-detail-installed-size != "": FpTile { label: @tr("INSTALLED SIZE"); value: flatpak-detail-installed-size; accent: Cat.peach; }
                                if flatpak-detail-installed-size == "": Rectangle { horizontal-stretch: 1; }
                                FpTile { label: @tr("REMOTE"); value: selected-remote; }
                                FpTile { label: @tr("APP ID"); value: current-flatpak-id; }
                            }
                        }

                        if flatpak-releases.length > 0: FpCard {
                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;
                                Text { text: @tr("What's new"); font-size: Cat.fs16; font-weight: 700; color: Cat.text; }
                                for rel[i] in flatpak-releases: VerticalLayout {
                                    spacing: 6px;
                                    if i > 0: Rectangle { height: 1px; background: Cat.divider; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text {
                                            text: @tr("Version {0}", rel.version);
                                            font-size: Cat.fs14;
                                            font-weight: 700;
                                            color: i == 0 ? Cat.mauve : Cat.text;
                                            vertical-alignment: center;
                                        }
                                        if rel.date != "": Text {
                                            text: "·  " + rel.date;
                                            font-size: Cat.fs13;
                                            color: Cat.overlay1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if rel.notes != "": Text {
                                        text: rel.notes;
                                        font-size: Cat.fs13;
                                        color: Cat.subtext0;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if flatpak-detail-url-homepage != "" || flatpak-detail-url-bug != "" || flatpak-detail-url-translate != "" || flatpak-detail-url-vcs != "" || flatpak-detail-url-donate != "" || flatpak-detail-url-help != "": FpCard {
                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;
                                Text { text: @tr("Links"); font-size: Cat.fs16; font-weight: 700; color: Cat.text; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    if flatpak-detail-url-homepage != "": FpLink {
                                        label: @tr("Project Website");
                                        icon-d: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6";
                                        accent: Cat.blue;
                                        clicked => { root.open-url(flatpak-detail-url-homepage); }
                                    }
                                    if flatpak-detail-url-help != "": FpLink {
                                        label: @tr("Help");
                                        icon-d: "M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zM9.1 9a3 3 0 015.8 1c0 2-3 2.5-3 4m.1 3h.01";
                                        accent: Cat.sapphire;
                                        clicked => { root.open-url(flatpak-detail-url-help); }
                                    }
                                    if flatpak-detail-url-bug != "": FpLink {
                                        label: @tr("Report an Issue");
                                        icon-d: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
                                        accent: Cat.peach;
                                        clicked => { root.open-url(flatpak-detail-url-bug); }
                                    }
                                    if flatpak-detail-url-translate != "": FpLink {
                                        label: @tr("Contribute Translations");
                                        icon-d: "M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129";
                                        accent: Cat.teal;
                                        clicked => { root.open-url(flatpak-detail-url-translate); }
                                    }
                                    if flatpak-detail-url-vcs != "": FpLink {
                                        label: @tr("Source Code");
                                        icon-d: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4";
                                        accent: Cat.mauve;
                                        clicked => { root.open-url(flatpak-detail-url-vcs); }
                                    }
                                    if flatpak-detail-url-donate != "": FpLink {
                                        label: @tr("Donate");
                                        icon-d: "M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z";
                                        accent: Cat.pink;
                                        clicked => { root.open-url(flatpak-detail-url-donate); }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 8px; }
                    }
                }

                if !remote-apps-loading && flatpak-store-ready && !show-flatpak-detail: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;

                    Rectangle {
                        height: 65px;
                        clip: true;

                        NavIcon {
                            d: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5";
                            icon-color: Cat.mauve.with-alpha(0.07);
                            width: 44px;
                            height: 40px;
                            x: parent.width - 54px;
                            y: (parent.height - 44px) / 2;
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                width: 44px;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: @tr("APPLICATION");
                                font-size: Cat.fs10;
                                font-weight: 700;
                                color: Cat.overlay0;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("STATUS");
                                font-size: Cat.fs10;
                                font-weight: 700;
                                color: Cat.overlay0;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                                width: 70px;
                                horizontal-alignment: center;
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Cat.surface0;
                            opacity: 0.6;
                        }
                    }

                    if remote-apps.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text { text: @tr("No apps found."); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 0;

                            for pkg[i] in remote-apps: Rectangle {
                                height: 66px;
                                background: fk-row-touch.has-hover ? Cat.surface0.with-alpha(0.4) : transparent;
                                animate background { duration: 60ms; }

                                fk-row-touch := TouchArea {
                                    clicked => {
                                        root.open-flatpak-detail(pkg);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        CheckBox {
                                            checked: pkg.selected;
                                            toggled(val) => {
                                                root.toggle-flatpak-selected(pkg.name, val);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        PkgIcon {
                                            name: "flatpak:" + pkg.name;
                                            size: 42px;
                                            fallback-initial: pkg.required-by;
                                            category: pkg.installed-size;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: pkg.display-name;
                                            font-size: Cat.fs15;
                                            font-weight: 600;
                                            color: Cat.text;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            if pkg.description != "": Text {
                                                text: pkg.description;
                                                font-size: Cat.fs13;
                                                color: Cat.subtext0;
                                                opacity: 0.9;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            if pkg.explicit: Rectangle {
                                                width: addon-tag-lbl.preferred-width + 12px;
                                                height: 14px;
                                                border-radius: 4px;
                                                background: Cat.mauve.with-alpha(0.12);
                                                border-width: 1px;
                                                border-color: Cat.mauve.with-alpha(0.3);
                                                addon-tag-lbl := Text {
                                                    text: @tr("+ Add-ons");
                                                    font-size: Cat.fs9;
                                                    font-weight: 700;
                                                    color: Cat.mauve.with-alpha(0.85);
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: pkg.installed ? 80px : 96px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: pkg.installed
                                                ? Cat.red.with-alpha(0.15)
                                                : Cat.mauve.with-alpha(0.15);

                                            Text {
                                                text: pkg.installed ? "Remove" : "Info / Install";
                                                font-size: Cat.fs13;
                                                font-weight: 600;
                                                color: pkg.installed ? Cat.red : Cat.mauve;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if pkg.installed {
                                                        root.fp-confirm-id = pkg.name;
                                                        root.fp-confirm-name = pkg.display-name;
                                                        root.fp-confirm-open = true;
                                                    } else {
                                                        root.open-flatpak-detail(pkg);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    x: 16px;
                                    y: parent.height - 1px;
                                    width: parent.width - 32px;
                                    height: 1px;
                                    background: Cat.surface0;
                                    opacity: 0.5;
                                }
                            }

                        }
                    }

                    if flatpak-total-matches > flatpak-per-page: Paginator {
                        current-page: flatpak-page;
                        total-pages: Math.ceil(flatpak-total-matches / flatpak-per-page);
                        go-to-page(p) => {
                            flatpak-page = p;
                            root.filter-flatpak(selected-flatpak-category, flatpak-search);
                        }
                    }
                }
                }

                if flatpak-tab == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;

                    Rectangle {
                        height: 62px;
                        background: transparent;

                        TouchArea { clicked => { ifk-search-ti.focus(); } }

                        Rectangle {
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            height: 42px;
                            border-radius: 10px;
                            background: ifk-search-ti.has-focus ? Cat.surface1 : Cat.surface0;
                            border-width: 1.5px;
                            border-color: ifk-search-ti.has-focus ? Cat.green.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                            clip: true;
                            animate background { duration: 80ms; }
                            animate border-color { duration: 80ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    NavIcon {
                                        d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                        icon-color: ifk-search-ti.has-focus ? Cat.green : Cat.subtext0;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 42px;

                                    ifk-search-ti := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> installed-flatpak-filter;
                                        font-size: Cat.fs15;
                                        color: Cat.text;
                                        single-line: true;
                                        vertical-alignment: center;
                                        selection-background-color: Cat.green.with-alpha(0.3);
                                        selection-foreground-color: Cat.text;
                                        edited => { root.filter-installed-flatpaks(self.text); }
                                    }

                                    if installed-flatpak-filter == "" && !ifk-search-ti.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: @tr("Filter installed Flatpaks...");
                                        font-size: Cat.fs15;
                                        color: Cat.subtext0.with-alpha(0.5);
                                        vertical-alignment: center;
                                    }
                                }

                                if installed-flatpak-filter != "": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px; height: 20px; border-radius: 10px;
                                        background: ifk-clr.has-hover ? Cat.surface2 : Cat.surface1;
                                        animate background { duration: 60ms; }
                                        NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.subtext0; width: 10px; height: 10px; x: 5px; y: 5px; }
                                        ifk-clr := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { installed-flatpak-filter = ""; root.filter-installed-flatpaks(""); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 38px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 1;
                                text: @tr("INSTALLED FLATPAKS");
                                font-size: Cat.fs10;
                                font-weight: 700;
                                color: Cat.overlay0;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: mgr-perm-row.preferred-width;
                                    height: 30px;
                                    border-radius: 8px;
                                    background: mgr-perm-ta.has-hover ? Cat.mauve.with-alpha(0.18) : Cat.surface0.with-alpha(0.6);
                                    border-width: 1px;
                                    border-color: mgr-perm-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.55);
                                    animate background, border-color { duration: 80ms; }
                                    mgr-perm-row := HorizontalLayout {
                                        alignment: center;
                                        padding-left: 12px; padding-right: 13px; spacing: 7px;
                                        VerticalLayout {
                                            alignment: center;
                                            NavIcon {
                                                d: "M19 11H5a2 2 0 00-2 2v7a2 2 0 002 2h14a2 2 0 002-2v-7a2 2 0 00-2-2zM7 11V7a5 5 0 0110 0v4";
                                                icon-color: Cat.mauve; width: 13px; height: 14px;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            mgr-perm-lbl := Text {
                                                text: @tr("Manage Permissions");
                                                font-size: Cat.fs12;
                                                font-weight: 600;
                                                color: Cat.text;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    mgr-perm-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.perm-single-app = false; root.open-flatpak-perms-manager(); }
                                    }
                                }
                            }

                            Text {
                                text: installed-flatpaks.length + " apps";
                                font-size: Cat.fs14;
                                color: Cat.overlay0;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Cat.surface0;
                            opacity: 0.6;
                        }
                    }

                    if installed-flatpaks.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;

                        NavIcon {
                            d: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4";
                            icon-color: Cat.surface2;
                            width: 32px;
                            height: 29px;
                            x: (parent.width - 32px) / 2;
                        }

                        Text {
                            text: @tr("No installed flatpaks");
                            font-size: Cat.fs15;
                            color: Cat.overlay0;
                            horizontal-alignment: center;
                        }
                    }

                    if installed-flatpaks.length > 0: ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 0;

                            for pkg[i] in installed-flatpaks: Rectangle {
                                height: 66px;
                                background: ifk-touch.has-hover ? Cat.surface0.with-alpha(0.4) : transparent;
                                animate background { duration: 60ms; }

                                ifk-touch := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        PkgIcon {
                                            name: "flatpak:" + pkg.name;
                                            size: 42px;
                                            fallback-initial: pkg.required-by;
                                            category: "System";
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: pkg.display-name;
                                            font-size: Cat.fs15;
                                            font-weight: 600;
                                            color: Cat.text;
                                            overflow: elide;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ifk-ver.preferred-width + 16px;
                                            height: 22px;
                                            border-radius: 5px;
                                            background: Cat.surface0.with-alpha(0.7);
                                            ifk-ver := Text {
                                                text: pkg.version;
                                                font-size: Cat.fs14;
                                                color: Cat.subtext0;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 64px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: ifk-info-touch.has-hover ? Cat.blue.with-alpha(0.25) : Cat.blue.with-alpha(0.12);
                                            border-width: 1px;
                                            border-color: Cat.blue.with-alpha(0.35);
                                            animate background { duration: 60ms; }
                                            VerticalLayout { alignment: center; Text { text: @tr("Info"); font-size: Cat.fs15; font-weight: 600; color: Cat.blue; horizontal-alignment: center; } }
                                            ifk-info-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    pkg-info-name = pkg.display-name;
                                                    pkg-info-subtitle = @tr("Installed files");
                                                    pkg-info-files = "";
                                                    pkg-info-loading = true;
                                                    pkg-info-open = true;
                                                    root.load-flatpak-info(pkg.name);
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 64px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: ifk-perm-touch.has-hover ? Cat.mauve.with-alpha(0.25) : Cat.mauve.with-alpha(0.12);
                                            border-width: 1px;
                                            border-color: Cat.mauve.with-alpha(0.35);
                                            animate background { duration: 60ms; }
                                            VerticalLayout { alignment: center; Text { text: @tr("Perms"); font-size: Cat.fs15; font-weight: 600; color: Cat.mauve; horizontal-alignment: center; } }
                                            ifk-perm-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.perm-single-app = true; root.open-flatpak-perms(pkg.name, pkg.display-name); }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 72px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: ifk-rm-touch.has-hover
                                                ? Cat.red.with-alpha(0.28)
                                                : Cat.red.with-alpha(0.15);
                                            animate background { duration: 60ms; }

                                            Text {
                                                text: @tr("Remove");
                                                font-size: Cat.fs15;
                                                font-weight: 600;
                                                color: Cat.red;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            ifk-rm-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.fp-confirm-id = pkg.name;
                                                    root.fp-confirm-name = pkg.display-name;
                                                    root.fp-confirm-open = true;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    x: 16px;
                                    y: parent.height - 1px;
                                    width: parent.width - 32px;
                                    height: 1px;
                                    background: Cat.surface0;
                                    opacity: 0.5;
                                }
                            }
                        }
                    }
                }

            }

            if view == 14: VerticalLayout {
                init => {
                    root.load-installed-appimages();
                    if catalog-appimages.length == 0 { root.load-appimage-catalog(); }
                }
                vertical-stretch: 1;
                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(ai-warn-text.preferred-width + 20px + 8px + 24px, parent.width);
                        border-radius: 8px;
                        background: Cat.red.with-alpha(0.08);
                        border-width: 1px;
                        border-color: Cat.red.with-alpha(0.35);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 8px;
                            VerticalLayout { alignment: center; WarnBadge { size: 20px; } }
                            ai-warn-text := Text {
                                text: @tr("Use AppImages At Your Own Risk ! No Support Provided.");
                                font-size: Cat.fs14;
                                color: Cat.red;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle {
                            width: 120px;
                            height: parent.height;
                            Text {
                                text: @tr("Browse");
                                font-size: Cat.fs15;
                                font-weight: appimage-tab == 0 ? 700 : 500;
                                color: appimage-tab == 0 ? Cat.mauve : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle { y: parent.height - 2px; height: 2px; background: appimage-tab == 0 ? Cat.mauve : transparent; }
                            TouchArea { mouse-cursor: pointer; clicked => { appimage-tab = 0; } }
                        }
                        Rectangle {
                            width: 120px;
                            height: parent.height;
                            Text {
                                text: @tr("Installed");
                                font-size: Cat.fs15;
                                font-weight: appimage-tab == 1 ? 700 : 500;
                                color: appimage-tab == 1 ? Cat.mauve : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle { y: parent.height - 2px; height: 2px; background: appimage-tab == 1 ? Cat.mauve : transparent; }
                            TouchArea { mouse-cursor: pointer; clicked => { appimage-tab = 1; root.load-installed-appimages(); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Cat.divider; }
                }

                if appimage-tab == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: Cat.surface0;
                        border-width: 1px;
                        border-color: ai-search-ti.has-focus ? Cat.mauve : Cat.surface1;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                NavIcon { d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"; icon-color: ai-search-ti.has-focus ? Cat.mauve : Cat.subtext0; width: 16px; height: 16px; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                ai-search-debounce := Timer {
                                    interval: 1s;
                                    running: false;
                                    triggered => {
                                        ai-search-debounce.running = false;
                                        root.filter-appimage-catalog(root.appimage-search, root.appimage-page);
                                    }
                                }
                                ai-search-ti := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> appimage-search;
                                    font-size: Cat.fs14;
                                    color: Cat.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Cat.mauve.with-alpha(0.3);
                                    edited => {
                                        root.appimage-page = 0;
                                        ai-search-debounce.running = false;
                                        ai-search-debounce.running = true;
                                    }
                                }
                                if appimage-search == "" && !ai-search-ti.has-focus: Text {
                                    width: 100%;
                                    height: 100%;
                                    text: @tr("Search the AppImage catalog…");
                                    font-size: Cat.fs14;
                                    color: Cat.subtext0.with-alpha(0.5);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                        // Source selector. Shown only when more than one source is
                        // configured; otherwise the single source is implied.
                        if appimage-sources.length > 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: ai-src-lbl.preferred-width + 58px;
                                height: 32px;
                                border-radius: 8px;
                                background: ai-src-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                border-width: 1px;
                                border-color: ai-src-ta.has-hover ? Cat.overlay0.with-alpha(0.4) : Cat.surface1;
                                animate background, border-color { duration: 80ms; }
                                HorizontalLayout {
                                    padding-left: 11px; padding-right: 9px;
                                    spacing: 7px;
                                    VerticalLayout {
                                        alignment: center;
                                        NavIcon { d: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4 4 0 003 15z"; icon-color: Cat.mauve.with-alpha(0.8); width: 14px; height: 14px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        ai-src-lbl := Text {
                                            text: selected-appimage-source == "" ? "All" : selected-appimage-source;
                                            font-size: Cat.fs13;
                                            font-weight: 600;
                                            color: Cat.subtext0;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        NavIcon { d: "M6 9l6 6 6-6"; icon-color: Cat.overlay1; width: 12px; height: 12px; }
                                    }
                                }
                                ai-src-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { ai-src-popup.show(); }
                                }
                                ai-src-popup := PopupWindow {
                                    x: parent.width - 200px;
                                    y: parent.height + 4px;
                                    width: 200px;
                                    height: Math.min(ai-src-list.preferred-height + 8px, 320px);
                                    Rectangle {
                                        background: Cat.surface0;
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: Cat.overlay0.with-alpha(0.3);
                                        ScrollView {
                                            ai-src-list := VerticalLayout {
                                                padding: 4px;
                                                spacing: 2px;
                                                Rectangle {
                                                    height: 32px;
                                                    border-radius: 6px;
                                                    background: ai-all-ta.has-hover ? Cat.surface1
                                                        : (selected-appimage-source == "All" || selected-appimage-source == "" ? Cat.surface1.with-alpha(0.6) : transparent);
                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px; padding-right: 10px;
                                                        Text {
                                                            text: @tr("All Sources");
                                                            font-size: Cat.fs13;
                                                            color: (selected-appimage-source == "All" || selected-appimage-source == "") ? Cat.mauve : Cat.text;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                    ai-all-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.browse-appimage-source("All"); }
                                                    }
                                                }
                                                for s[si] in appimage-sources: Rectangle {
                                                    height: 32px;
                                                    border-radius: 6px;
                                                    background: ai-src-opt-ta.has-hover ? Cat.surface1
                                                        : (s.name == selected-appimage-source ? Cat.surface1.with-alpha(0.6) : transparent);
                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px; padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: s.name;
                                                            font-size: Cat.fs13;
                                                            color: s.name == selected-appimage-source ? Cat.mauve : Cat.text;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                        if s.name == selected-appimage-source: VerticalLayout {
                                                            alignment: center;
                                                            NavIcon { d: "M20 6L9 17l-5-5"; icon-color: Cat.mauve; width: 13px; height: 13px; }
                                                        }
                                                    }
                                                    ai-src-opt-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.browse-appimage-source(s.name); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout { alignment: center;
                            RefreshButton {
                                loading: appimage-catalog-loading;
                                enabled: !appimage-catalog-loading;
                                clicked => { root.reload-appimage-catalog(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: Cat.surface0;
                            border-width: 1px;
                            border-color: ai-url-ti.has-focus ? Cat.mauve : Cat.surface1;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    ai-url-ti := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> appimage-url-input;
                                        font-size: Cat.fs13;
                                        color: Cat.text;
                                        single-line: true;
                                        vertical-alignment: center;
                                        selection-background-color: Cat.mauve.with-alpha(0.3);
                                        accepted => { root.install-appimage-url(appimage-url-input); appimage-url-input = ""; }
                                    }
                                    if appimage-url-input == "" && !ai-url-ti.has-focus: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: @tr("…or paste a direct .AppImage download URL");
                                        font-size: Cat.fs13;
                                        color: Cat.subtext0.with-alpha(0.5);
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        VerticalLayout { alignment: center; Btn { label: @tr("Install URL"); primary: true; width: 104px; horizontal-stretch: 0; clicked => { root.install-appimage-url(appimage-url-input); appimage-url-input = ""; } } }
                        VerticalLayout { alignment: center; Btn { label: @tr("Install File"); width: 104px; horizontal-stretch: 0; clicked => { root.install-appimage-file(); } } }
                    }

                    if !appimage-catalog-loading && appimage-catalog-total > 0: Text {
                        text: "Showing " + (appimage-page * appimage-per-page + 1)
                            + "–" + min((appimage-page + 1) * appimage-per-page, appimage-catalog-total)
                            + " of " + appimage-catalog-total + " apps";
                        font-size: Cat.fs11;
                        color: Cat.overlay0;
                    }

                    if appimage-catalog-loading: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            LoadingCircle { diameter: 32px; }
                        }
                        Text { text: @tr("Loading Apps… Might take a while"); font-size: Cat.fs15; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    if !appimage-catalog-loading && catalog-appimages.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text { text: @tr("No matching AppImages."); font-size: Cat.fs15; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    if !appimage-catalog-loading && catalog-appimages.length > 0: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0;
                            for card[i] in catalog-appimages: Rectangle {
                                height: 60px;
                                clip: true;
                                background: cat-row-ta.has-hover ? Cat.surface0.with-alpha(0.5) : transparent;
                                init => { root.load-appimage-icon(card.github); }
                                cat-row-ta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        if card.has-icon: Image {
                                            source: card.icon;
                                            width: 40px;
                                            height: 40px;
                                            image-fit: contain;
                                        }
                                        if !card.has-icon: AppAvatar {
                                            initial: card.initial;
                                            category: card.category;
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 10px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: card.name; font-size: Cat.fs14; font-weight: 600; color: Cat.text; overflow: elide; }
                                        Text { text: card.description; font-size: Cat.fs11; color: Cat.subtext0; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        if card.installed: Btn { label: @tr("Remove"); danger: true; width: 90px; horizontal-stretch: 0; clicked => { root.remove-appimage(card.installed-id); } }
                                        if !card.installed: Btn { label: @tr("Install"); primary: true; width: 90px; horizontal-stretch: 0; clicked => { root.install-appimage-catalog(card.github); } }
                                    }
                                }
                                Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Cat.divider; }
                            }
                        }
                    }

                    if !appimage-catalog-loading && appimage-catalog-total > appimage-per-page: HorizontalLayout {
                        height: 36px;
                        spacing: 10px;
                        alignment: center;
                        Btn {
                            label: @tr("‹ Prev");
                            width: 90px;
                            horizontal-stretch: 0;
                            enabled: appimage-page > 0;
                            clicked => {
                                root.appimage-page = appimage-page - 1;
                                root.filter-appimage-catalog(appimage-search, root.appimage-page);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Page " + (appimage-page + 1) + " / "
                                    + Math.ceil(appimage-catalog-total / appimage-per-page);
                                font-size: Cat.fs12;
                                color: Cat.subtext0;
                                horizontal-alignment: center;
                            }
                        }
                        Btn {
                            label: @tr("Next ›");
                            width: 90px;
                            horizontal-stretch: 0;
                            enabled: (appimage-page + 1) * appimage-per-page < appimage-catalog-total;
                            clicked => {
                                root.appimage-page = appimage-page + 1;
                                root.filter-appimage-catalog(appimage-search, root.appimage-page);
                            }
                        }
                    }
                }

                if appimage-tab == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    if installed-appimages.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text { text: @tr("No AppImages installed yet."); font-size: Cat.fs15; color: Cat.overlay0; horizontal-alignment: center; }
                    }


                    if installed-appimages.length > 0: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0;
                            for pkg[i] in installed-appimages: Rectangle {
                                height: 64px;
                                clip: true;
                                background: ai-row-ta.has-hover ? Cat.surface0.with-alpha(0.5) : transparent;
                                ai-row-ta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        if pkg.has-icon: Image { source: pkg.icon; width: 40px; height: 40px; image-fit: contain; }
                                        if !pkg.has-icon: AppAvatar { initial: pkg.initial; category: ""; width: 40px; height: 40px; border-radius: 10px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: pkg.name; font-size: Cat.fs14; font-weight: 600; color: Cat.text; overflow: elide; }
                                        Text { text: pkg.detail; font-size: Cat.fs11; color: Cat.subtext0; overflow: elide; }
                                    }
                                    if pkg.update-available: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ua-lbl.preferred-width + 16px;
                                            height: 18px;
                                            border-radius: 5px;
                                            background: Cat.green.with-alpha(0.18);
                                            border-width: 1px;
                                            border-color: Cat.green.with-alpha(0.4);
                                            ua-lbl := Text {
                                                text: @tr("New version");
                                                x: 8px;
                                                font-size: Cat.fs9;
                                                font-weight: 700;
                                                color: Cat.green;
                                                vertical-alignment: center;
                                                height: 100%;
                                            }
                                        }
                                    }
                                    if !pkg.supports-update: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 6px;
                                            background: warn-ta.has-hover ? Cat.yellow.with-alpha(0.18) : transparent;
                                            WarnBadge { size: 18px; x: 5px; y: 5px; }
                                            warn-ta := TouchArea { mouse-cursor: pointer; }
                                            if warn-ta.has-hover || warn-ta.pressed: Rectangle {
                                                x: -warn-tt-lbl.preferred-width - 28px;
                                                y: (parent.height - 26px) / 2;
                                                width: warn-tt-lbl.preferred-width + 16px;
                                                height: 26px;
                                                background: Cat.surface2;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: Cat.overlay0;
                                                drop-shadow-color: Cat.crust.with-alpha(0.4);
                                                drop-shadow-blur: 6px;
                                                drop-shadow-offset-y: 2px;
                                                warn-tt-lbl := Text {
                                                    text: @tr("Reinstall for Update Required.");
                                                    font-size: Cat.fs12;
                                                    color: Cat.text;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }
                                        }
                                    }
                                    if !pkg.supports-update: VerticalLayout { alignment: center; Btn { label: @tr("Reinstall"); primary: true; width: 88px; horizontal-stretch: 0; clicked => { root.reinstall-appimage(pkg.id); } } }
                                    VerticalLayout { alignment: center; Btn { label: @tr("Remove"); danger: true; width: 86px; horizontal-stretch: 0; clicked => { root.remove-appimage(pkg.id); } } }
                                }
                                Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Cat.divider; }
                            }
                        }
                    }
                }
            }

            if view == 7 || view == 8: VerticalLayout {
                vertical-stretch: 1;
                spacing: 0;

                Rectangle {
                    height: 40px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 0;

                        Rectangle {
                            width: 90px;
                            height: parent.height;
                            Text {
                                text: @tr("Browse");
                                font-size: Cat.fs14;
                                font-weight: repos-view == 0 ? 700 : 500;
                                color: repos-view == 0 ? Cat.blue : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                width: parent.width;
                                background: repos-view == 0 ? Cat.blue : transparent;
                                animate background { duration: 120ms; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { repos-view = 0; }
                            }
                        }

                        Rectangle {
                            width: 100px;
                            height: parent.height;
                            Text {
                                text: @tr("Installed");
                                font-size: Cat.fs14;
                                font-weight: repos-view == 1 ? 700 : 500;
                                color: repos-view == 1 ? Cat.mauve : Cat.overlay1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                width: parent.width;
                                background: repos-view == 1 ? Cat.mauve : transparent;
                                animate background { duration: 120ms; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    repos-view = 1;
                                    if installed-grouped.length == 0 { root.load-installed-grouped(); }
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: Cat.surface0;
                    }
                }

                if repos-view == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;

                Rectangle {
                    height: 62px;
                    background: transparent;

                    TouchArea { clicked => { rs-ti.focus(); } }

                    Rectangle {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        height: 42px;
                        border-radius: 10px;
                        background: rs-ti.has-focus ? Cat.surface1 : Cat.surface0;
                        border-width: 1.5px;
                        border-color: rs-ti.has-focus ? Cat.blue.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                        clip: true;
                        animate background { duration: 80ms; }
                        animate border-color { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                    icon-color: rs-ti.has-focus ? Cat.blue : Cat.subtext0;
                                    width: 16px;
                                    height: 16px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;

                                rs-ti := TextInput {
                                    width: 100%; height: 100%;
                                    text <=> repo-search;
                                    font-size: Cat.fs15;
                                    color: Cat.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Cat.blue.with-alpha(0.3);
                                    selection-foreground-color: Cat.text;
                                    accepted => { root.filter-repo(self.text); }
                                    edited => { root.filter-repo(self.text); }
                                }

                                if repo-search == "" && !rs-ti.has-focus: Text {
                                    width: 100%; height: 100%;
                                    text: selected-repo != "" ? "Search in " + selected-repo + "..." : "Search all packages...";
                                    font-size: Cat.fs15;
                                    color: Cat.subtext0.with-alpha(0.5);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 50px;

                    if pacman-repos.length == 0: HorizontalLayout {
                        padding-left: 14px;
                        spacing: 8px;
                        alignment: center;
                        NavIcon {
                            d: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15";
                            icon-color: Cat.overlay0;
                            width: 14px;
                            height: 14px;
                        }
                        Text { text: @tr("Loading repositories..."); font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center; }
                    }

                    if pacman-repos.length > 0: HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding: 10px;

                        Rectangle {
                            width: all-pill-lbl.preferred-width + 28px;
                            height: 30px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: selected-repo == "" ? Cat.blue.with-alpha(0.5) : Cat.surface1;
                            background: selected-repo == "" ? Cat.blue.with-alpha(0.12) :
                                        (all-pill-ta.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.5));
                            animate background { duration: 70ms; }
                            all-pill-lbl := Text {
                                text: @tr("All");
                                font-size: Cat.fs14;
                                font-weight: selected-repo == "" ? 700 : 400;
                                color: selected-repo == "" ? Cat.blue : Cat.subtext0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            all-pill-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    selected-repo = "";
                                    view = 8;
                                    repo-search = "";
                                    root.browse-repo("");
                                }
                            }
                        }

                        for repo[i] in pacman-repos: Rectangle {
                            width: rp-lbl.preferred-width + 28px;
                            height: 30px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: selected-repo == repo ? Cat.blue.with-alpha(0.5) : Cat.surface1;
                            background: selected-repo == repo ? Cat.blue.with-alpha(0.12) :
                                        (rp-t.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.5));
                            animate background { duration: 70ms; }

                            rp-lbl := Text {
                                text: repo;
                                font-size: Cat.fs14;
                                font-weight: selected-repo == repo ? 700 : 400;
                                color: selected-repo == repo ? Cat.blue : Cat.subtext0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            rp-t := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    selected-repo = repo;
                                    view = 8;
                                    show-repo-detail = false;
                                    repo-search = "";
                                    root.browse-repo(repo);
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;

                    if repo-loading: VerticalLayout {
                        vertical-stretch: 1; alignment: center; spacing: 8px;
                        LoadingCircle { diameter: 24px; x: (parent.width - 24px) / 2; }
                        Text { text: selected-repo != "" ? "Loading " + selected-repo + "..." : "Loading packages..."; font-size: Cat.fs13; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    if !repo-loading: Rectangle {
                        height: 30px;
                        background: Cat.surface0.with-alpha(0.5);
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 12px;
                            Text { text: @tr("Name"); font-size: Cat.fs14; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.5px; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle { width: 120px; Text { text: @tr("Version"); font-size: Cat.fs14; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.5px; vertical-alignment: center; horizontal-alignment: right; } }
                            Rectangle { width: 80px; Text { text: @tr("Repo"); font-size: Cat.fs14; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.5px; vertical-alignment: center; horizontal-alignment: right; } }
                            Rectangle { width: 90px; Text { text: @tr("Action"); font-size: Cat.fs14; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.5px; vertical-alignment: center; horizontal-alignment: center; } }
                        }
                    }

                    if !repo-loading && repo-packages.length == 0: VerticalLayout {
                        vertical-stretch: 1; alignment: center;
                        Text { text: @tr("No packages found"); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    if !repo-loading && repo-packages.length > 0: ListView {
                        vertical-stretch: 1;
                        for p[i] in repo-packages: RepoRow {
                            pkg: p;
                            show-checkbox: multi-select-mode;
                            toggle-selected(val) => { root.toggle-package-selected(p.name, p.backend, val); }
                            install => { root.request-install(p.name, p.backend); }
                            remove => { root.request-remove(p.name, p.backend); }
                            show-tree => {
                                dep-tree-pkg = p.name;
                                dep-tree-tab = 0;
                                dep-tree-nodes = [];
                                dep-reqby-nodes = [];
                                dep-tree-loading = true;
                                view = 12;
                                root.load-dep-tree(p.name);
                            }
                            show-info => {
                                pkg-info-name = p.name;
                                pkg-info-subtitle = @tr("Installed files");
                                pkg-info-files = "";
                                pkg-info-loading = true;
                                pkg-info-open = true;
                                root.load-pkg-info(p.name);
                            }
                        }
                    }

                    if !repo-loading && repo-total-matches > repo-per-page: Paginator {
                        current-page: repo-page;
                        total-pages: Math.ceil(repo-total-matches / repo-per-page);
                        go-to-page(p) => { repo-page = p; root.goto-repo-page(p); }
                    }
                }
            }

            if !loading && view == 2 && (search-installed.length > 0 || search-available.length > 0): ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 0px;

                    if search-installed.length > 0: VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 29px;
                            background: Cat.green.with-alpha(0.06);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout { alignment: center;
                                    NavIcon {
                                        d: "M20 6L9 17l-5-5";
                                        icon-color: Cat.green;
                                        width: 14px;
                                        height: 14px;
                                    }
                                }

                                Text {
                                    text: @tr("Installed ({0})", search-installed.length);
                                    font-size: Cat.fs15;
                                    font-weight: 700;
                                    color: Cat.green;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for p[i] in search-installed: PackageRow {
                            pkg: p;
                            show-separator: i < search-installed.length - 1;
                            show-checkbox: multi-select-mode;
                            install => { root.request-install(p.name, p.backend); }
                            remove => { root.request-remove(p.name, p.backend); }
                            toggle-selected(val) => { root.toggle-package-selected(p.name, p.backend, val); }
                        }
                    }

                    if search-available.length > 0: VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 29px;
                            background: Cat.blue.with-alpha(0.06);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout { alignment: center;
                                    NavIcon {
                                        d: icon-package;
                                        icon-color: Cat.blue;
                                        width: 14px;
                                        height: 14px;
                                    }
                                }

                                Text {
                                    text: @tr("Available ({0})", search-available.length);
                                    font-size: Cat.fs15;
                                    font-weight: 700;
                                    color: Cat.blue;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for p[i] in search-available: PackageRow {
                            pkg: p;
                            show-separator: i < search-available.length - 1;
                            show-checkbox: multi-select-mode;
                            install => { root.request-install(p.name, p.backend); }
                            remove => { root.request-remove(p.name, p.backend); }
                            toggle-selected(val) => { root.toggle-package-selected(p.name, p.backend, val); }
                        }
                    }
                }
                }

                if repos-view == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;

                    Rectangle {
                        height: 62px;
                        background: transparent;

                        TouchArea { clicked => { ni-search-ti.focus(); } }

                        Rectangle {
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            height: 42px;
                            border-radius: 10px;
                            background: ni-search-ti.has-focus ? Cat.surface1 : Cat.surface0;
                            border-width: 1.5px;
                            border-color: ni-search-ti.has-focus ? Cat.mauve.with-alpha(0.7) : Cat.overlay0.with-alpha(0.25);
                            clip: true;
                            animate background { duration: 80ms; }
                            animate border-color { duration: 80ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    NavIcon {
                                        d: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0";
                                        icon-color: ni-search-ti.has-focus ? Cat.mauve : Cat.subtext0;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 42px;

                                    ni-search-ti := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> installed-grouped-filter;
                                        font-size: Cat.fs15;
                                        color: Cat.text;
                                        single-line: true;
                                        vertical-alignment: center;
                                        selection-background-color: Cat.mauve.with-alpha(0.3);
                                        selection-foreground-color: Cat.text;
                                        edited => { root.filter-installed-grouped(self.text); }
                                        accepted => { root.filter-installed-grouped(self.text); }
                                    }

                                    if installed-grouped-filter == "" && !ni-search-ti.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: @tr("Filter installed packages...");
                                        font-size: Cat.fs15;
                                        color: Cat.subtext0.with-alpha(0.5);
                                        vertical-alignment: center;
                                    }
                                }

                                if installed-grouped-filter != "": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px; height: 20px; border-radius: 10px;
                                        background: ni-clr.has-hover ? Cat.surface2 : Cat.surface1;
                                        animate background { duration: 60ms; }
                                        NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.subtext0; width: 10px; height: 10px; x: 5px; y: 5px; }
                                        ni-clr := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { installed-grouped-filter = ""; root.filter-installed-grouped(""); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;
                            alignment: center;

                            for opt[idx] in ["All", "Explicit", "Deps"]: Rectangle {
                                property <bool> active: installed-explicit-filter == idx;
                                width: pill-lbl.preferred-width + 16px;
                                height: 22px;
                                border-radius: 6px;
                                background: active
                                    ? (idx == 1 ? Cat.mauve : idx == 2 ? Cat.sapphire : Cat.surface1)
                                    : (pill-ta.has-hover ? Cat.surface1.with-alpha(0.6) : Cat.surface0.with-alpha(0.5));
                                animate background { duration: 80ms; }
                                pill-lbl := Text {
                                    text: opt;
                                    font-size: Cat.fs15;
                                    font-weight: active ? 700 : 400;
                                    color: active ? Cat.crust : Cat.subtext0;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                pill-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        installed-explicit-filter = idx;
                                        root.apply-explicit-filter(idx);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Cat.surface0;
                            opacity: 0.6;
                        }
                    }

                    if installed-grouped.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        LoadingCircle { diameter: 20px; x: (parent.width - 20px) / 2; }
                        Text { text: @tr("Loading..."); font-size: Cat.fs13; color: Cat.overlay0; horizontal-alignment: center; }
                    }

                    if installed-grouped.length > 0: ListView {
                        vertical-stretch: 1;

                            for pkg[i] in installed-grouped: Rectangle {
                                height: pkg.backend == -1 ? 32px : 66px;
                                background: pkg.backend != -1 && ri-touch.has-hover
                                    ? Cat.surface0.with-alpha(0.35) : transparent;
                                animate background { duration: 60ms; }

                                ri-touch := TouchArea {}

                                if pkg.backend == -1: HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ri-repo-lbl.preferred-width + 14px;
                                            height: 18px;
                                            border-radius: 5px;
                                            background: Cat.surface1.with-alpha(0.7);
                                            ri-repo-lbl := Text {
                                                text: pkg.name;
                                                font-size: Cat.fs10;
                                                font-weight: 700;
                                                color: pkg.repository == "core" ? Cat.blue :
                                                       pkg.repository == "extra" ? Cat.mauve :
                                                       pkg.repository == "multilib" ? Cat.teal :
                                                       pkg.repository == "aur" ? Cat.peach :
                                                       Cat.overlay1;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                letter-spacing: 0.5px;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 1px;
                                        y: parent.height / 2;
                                        background: Cat.surface1.with-alpha(0.4);
                                    }
                                }

                                if pkg.backend != -1: HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 14px;

                                    VerticalLayout {
                                        alignment: center;
                                        PkgIcon {
                                            name: pkg.name;
                                            size: 42px;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: pkg.display-name;
                                            font-size: Cat.fs15;
                                            font-weight: 600;
                                            color: Cat.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: pkg.description;
                                            font-size: Cat.fs13;
                                            color: Cat.subtext0;
                                            opacity: 0.9;
                                            overflow: elide;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ri-ver.preferred-width + 14px;
                                            height: 20px;
                                            border-radius: 5px;
                                            background: Cat.surface0.with-alpha(0.7);
                                            ri-ver := Text {
                                                text: pkg.version;
                                                font-size: Cat.fs12;
                                                color: Cat.subtext0;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        visible: pkg.explicit;
                                        Rectangle {
                                            width: ri-explicit-lbl.preferred-width + 16px;
                                            height: 20px;
                                            border-radius: 5px;
                                            background: Cat.mauve.with-alpha(0.18);
                                            border-width: 1px;
                                            border-color: Cat.mauve.with-alpha(0.4);
                                            ri-explicit-lbl := Text {
                                                text: @tr("Explicit");
                                                font-size: Cat.fs13;
                                                font-weight: 600;
                                                color: Cat.mauve;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ri-tree-lbl.preferred-width + 20px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: ri-tr-touch.has-hover
                                                ? Cat.sapphire.with-alpha(0.28)
                                                : Cat.sapphire.with-alpha(0.15);
                                            animate background { duration: 60ms; }
                                            ri-tree-lbl := Text {
                                                text: @tr("Tree");
                                                font-size: Cat.fs15;
                                                font-weight: 600;
                                                color: Cat.sapphire;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            ri-tr-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    dep-tree-pkg = pkg.name;
                                                    dep-tree-tab = 0;
                                                    dep-tree-nodes = [];
                                                    dep-reqby-nodes = [];
                                                    dep-tree-loading = true;
                                                    view = 12;
                                                    root.load-dep-tree(pkg.name);
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ri-dg-lbl.preferred-width + 20px;
                                            height: 31px;
                                            border-radius: 6px;
                                            background: ri-dg-touch.has-hover
                                                ? Cat.yellow.with-alpha(0.28)
                                                : Cat.yellow.with-alpha(0.15);
                                            animate background { duration: 60ms; }
                                            ri-dg-lbl := Text {
                                                text: @tr("Downgrade");
                                                font-size: Cat.fs14;
                                                font-weight: 600;
                                                color: Cat.yellow;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            ri-dg-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.downgrade-package(pkg.name); }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: ri-rm-lbl.preferred-width + 20px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: ri-rm-touch.has-hover
                                                ? Cat.red.with-alpha(0.28)
                                                : Cat.red.with-alpha(0.15);
                                            animate background { duration: 60ms; }
                                            ri-rm-lbl := Text {
                                                text: @tr("Remove");
                                                font-size: Cat.fs15;
                                                font-weight: 600;
                                                color: Cat.red;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            ri-rm-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.request-remove(pkg.name, pkg.backend); }
                                            }
                                        }
                                    }
                                }

                                if pkg.backend != -1: Rectangle {
                                    x: 16px;
                                    y: parent.height - 1px;
                                    width: parent.width - 32px;
                                    height: 1px;
                                    background: Cat.surface0;
                                    opacity: 0.4;
                                }
                            }
                    }

                    if !installed-grouped-all-loaded: Rectangle {
                        height: 40px;
                        background: Cat.surface0.with-alpha(0.3);
                        border-width: 1px;
                        border-color: Cat.surface1;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M19 9l-7 7-7-7";
                                    icon-color: load-all-ta.has-hover ? Cat.blue : Cat.overlay1;
                                    width: 14px;
                                    height: 14px;
                                }
                            }

                            Text {
                                text: @tr("Load All Installed Packages");
                                font-size: Cat.fs13;
                                font-weight: 500;
                                color: load-all-ta.has-hover ? Cat.blue : Cat.subtext0;
                                vertical-alignment: center;
                                animate color { duration: 80ms; }
                            }
                        }

                        load-all-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                installed-grouped-all-loaded = true;
                                root.load-all-installed-grouped();
                            }
                        }
                    }
                }

            }

            if view == 5: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 4px;
                    spacing: 22px;
                    alignment: start;


                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { section-title: @tr("GENERAL"); }

                        HorizontalLayout {
                            spacing: 8px;
                            SettingsRow {
                                horizontal-stretch: 1;
                                accent: Cat.teal;
                                label: @tr("Flatpak Support");
                                subtitle: @tr("Enable Flatpak package management");
                                checked: setting-flatpak-enabled;
                                toggled(val) => {
                                    setting-flatpak-enabled = val;
                                    if !val && view == 10 { view = 9; }
                                    root.save-settings();
                                }
                            }
                            SettingsRow {
                                horizontal-stretch: 1;
                                accent: Cat.blue;
                                label: @tr("AppImage Support");
                                subtitle: @tr("Unsupported, use at own risk");
                                checked: setting-appimage-enabled;
                                toggled(val) => {
                                    setting-appimage-enabled = val;
                                    if !val && view == 14 { view = 9; }
                                    if val {
                                        root.load-installed-appimages();
                                        if catalog-appimages.length == 0 { root.load-appimage-catalog(); }
                                    }
                                    root.save-settings();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            SettingsRow {
                                horizontal-stretch: 1;
                                accent: Cat.mauve;
                                label: @tr("Check Updates on Startup");
                                subtitle: @tr("Sync databases on launch");
                                checked: setting-check-updates-on-start;
                                toggled(val) => { setting-check-updates-on-start = val; root.save-settings(); }
                            }
                            SettingsRow {
                                horizontal-stretch: 1;
                                accent: Cat.green;
                                label: @tr("Auto-clean Cache");
                                subtitle: @tr("Run paccache after upgrade");
                                checked: setting-auto-clean-cache;
                                toggled(val) => { setting-auto-clean-cache = val; root.save-settings(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            SettingsRow {
                                horizontal-stretch: 1;
                                accent: Cat.peach;
                                label: @tr("Notify on Updates");
                                subtitle: @tr("Desktop notify-send on startup");
                                checked: setting-notify-on-updates;
                                toggled(val) => { setting-notify-on-updates = val; root.save-settings(); }
                            }
                            SettingsLinkRow {
                                horizontal-stretch: 1;
                                accent: Cat.sapphire;
                                label: @tr("Parallel Downloads");
                                subtitle: @tr("Current: {0}", setting-parallel-downloads);
                                clicked => { root.show-pd-modal = true; }
                            }
                        }

                        if setting-flatpak-enabled || setting-appimage-enabled: VerticalLayout {
                            padding-top: 14px;
                            SectionLabel { section-title: @tr("REMOTE MANAGER"); }
                        }

                        if setting-flatpak-enabled: Rectangle {
                            height: 66px;
                            border-radius: 8px;
                            background: fp-rem-ta.has-hover ? Cat.teal.with-alpha(0.14) : Cat.teal.with-alpha(0.07);
                            border-width: 1.5px;
                            border-color: Cat.teal.with-alpha(0.5);
                            animate background { duration: 80ms; }

                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 10px;
                                VerticalLayout { alignment: center;
                                    NavIcon { d: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4 4 0 003 15z"; icon-color: Cat.teal; width: 15px; height: 15px; }
                                }
                                Text { text: @tr("Manage Flatpak Remotes"); font-size: Cat.fs14; font-weight: 500; color: Cat.text; vertical-alignment: center; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center;
                                    NavIcon { d: "M9 18l6-6-6-6"; icon-color: Cat.overlay0; width: 14px; height: 14px; }
                                }
                            }
                            fp-rem-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.load-flatpak-remotes(); root.show-flatpak-remotes-modal = true; }
                            }
                        }

                        if setting-appimage-enabled: Rectangle {
                            height: 66px;
                            border-radius: 8px;
                            background: aim-mgr-ta.has-hover ? Cat.blue.with-alpha(0.14) : Cat.blue.with-alpha(0.07);
                            border-width: 1.5px;
                            border-color: Cat.blue.with-alpha(0.5);
                            animate background { duration: 80ms; }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 10px;
                                VerticalLayout { alignment: center;
                                    NavIcon { d: icon-image; icon-color: Cat.blue; width: 15px; height: 15px; }
                                }
                                Text { text: @tr("Manage AppImages (location & sources)"); font-size: Cat.fs14; font-weight: 500; color: Cat.text; vertical-alignment: center; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center;
                                    NavIcon { d: "M9 18l6-6-6-6"; icon-color: Cat.overlay0; width: 14px; height: 14px; }
                                }
                            }
                            aim-mgr-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-appimage-mgr-modal = true; }
                            }
                        }


                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { section-title: @tr("PACMAN MANAGER"); }

                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 66px;
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                background: rm-btn1-ta.has-hover ? Cat.green.with-alpha(0.14) : Cat.green.with-alpha(0.07);
                                border-width: 1.5px;
                                border-color: Cat.green.with-alpha(0.5);
                                clip: true;
                                animate background { duration: 80ms; }

                                VerticalLayout {
                                    alignment: center;
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: center;
                                        NavIcon {
                                            d: "M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11";
                                            icon-color: Cat.green;
                                            width: 16px; height: 16px;
                                        }
                                    }
                                    Text {
                                        text: @tr("Enable / Disable");
                                        font-size: Cat.fs12; font-weight: 600;
                                        color: Cat.text; horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Toggle repos on/off");
                                        font-size: Cat.fs10;
                                        color: Cat.subtext0; horizontal-alignment: center;
                                    }
                                }

                                rm-btn1-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.repo-mgr-loading = true;
                                        root.show-repo-enable-modal = true;
                                        root.load-repo-list();
                                    }
                                }
                            }

                            Rectangle {
                                height: 66px;
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                background: rm-btn2-ta.has-hover ? Cat.teal.with-alpha(0.14) : Cat.teal.with-alpha(0.07);
                                border-width: 1.5px;
                                border-color: Cat.teal.with-alpha(0.5);
                                clip: true;
                                animate background { duration: 80ms; }

                                VerticalLayout {
                                    alignment: center;
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: center;
                                        NavIcon {
                                            d: "M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z";
                                            icon-color: Cat.teal;
                                            width: 16px; height: 16px;
                                        }
                                    }
                                    Text {
                                        text: @tr("pacman Options");
                                        font-size: Cat.fs12; font-weight: 600;
                                        color: Cat.text; horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Configure pacman.conf flags");
                                        font-size: Cat.fs10;
                                        color: Cat.subtext0; horizontal-alignment: center;
                                    }
                                }

                                rm-btn2-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.load-pacman-opts();
                                        root.show-pacman-opts-modal = true;
                                    }
                                }
                            }

                            Rectangle {
                                height: 66px;
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                background: rm-btn3-ta.has-hover ? Cat.peach.with-alpha(0.14) : Cat.peach.with-alpha(0.07);
                                border-width: 1.5px;
                                border-color: Cat.peach.with-alpha(0.5);
                                clip: true;
                                animate background { duration: 80ms; }

                                VerticalLayout {
                                    alignment: center;
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: center;
                                        NavIcon {
                                            d: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z";
                                            icon-color: Cat.peach;
                                            width: 16px; height: 16px;
                                        }
                                    }
                                    Text {
                                        text: @tr("Edit pacman.conf");
                                        font-size: Cat.fs12; font-weight: 600;
                                        color: Cat.text; horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Advanced manual edit (Terminal)");
                                        font-size: Cat.fs10;
                                        color: Cat.subtext0; horizontal-alignment: center;
                                    }
                                }

                                rm-btn3-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-pacman-conf-editor(); }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { section-title: @tr("ABOUT"); }

                        Rectangle {
                            height: 176px;
                            border-radius: 12px;
                            background: Cat.crust;
                            border-width: 1px;
                            border-color: Cat.surface0;
                            clip: true;

                            VerticalLayout {
                                Rectangle {
                                    height: 26px;
                                    background: Cat.mantle;

                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;

                                        VerticalLayout { alignment: center;
                                            HorizontalLayout { spacing: 5px;
                                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #ed6a5e; }
                                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f4bf4f; }
                                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #61c554; }
                                            }
                                        }

                                        Text {
                                            text: "XPM  -  Version " + app-version;
                                            font-size: Cat.fs14; font-family: "monospace";
                                            color: Cat.overlay0;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        Rectangle { width: 29px; }
                                    }
                                }

                                Rectangle { height: 1px; background: Cat.divider; }

                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 16px; padding-right: 16px;
                                    padding-top: 6px; padding-bottom: 6px;
                                    spacing: 4px;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: @tr("XeroLinux Package Manager");
                                            font-size: Cat.fs15; font-family: "monospace"; font-weight: 700;
                                            color: Cat.text; horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "\u{25A0} " + stats.pacman-count + " " + @tr("pacman") + "   \u{25A0} " + stats.flatpak-count + " " + @tr("flatpak") + "   \u{25A0} " + stats.orphan-count + " " + @tr("orphans");
                                            font-size: Cat.fs13; font-family: "monospace";
                                            color: Cat.mauve.with-alpha(0.65); horizontal-alignment: center;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Cat.divider; }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Rectangle {
                                            horizontal-stretch: 1; height: 26px; border-radius: 7px;
                                            background: gh-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                            border-width: 1px; border-color: Cat.surface1;
                                            animate background { duration: 80ms; }
                                            HorizontalLayout {
                                                alignment: center; spacing: 6px;
                                                VerticalLayout { alignment: center;
                                                    NavIcon {
                                                        d: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z";
                                                        icon-color: Cat.text; width: 12px; height: 12px;
                                                    }
                                                }
                                                Text { text: @tr("GitHub"); font-size: Cat.fs11; font-weight: 600; color: Cat.text; vertical-alignment: center; }
                                            }
                                            gh-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-url("https://github.com/xerolinux"); } }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1; height: 26px; border-radius: 7px;
                                            background: kofi-ta2.has-hover ? #ff5e5b.with-alpha(0.28) : #ff5e5b.with-alpha(0.12);
                                            border-width: 1px; border-color: #ff5e5b.with-alpha(0.35);
                                            animate background { duration: 80ms; }
                                            HorizontalLayout {
                                                alignment: center; spacing: 5px;
                                                Text { text: "☕"; font-size: Cat.fs12; vertical-alignment: center; }
                                                Text { text: @tr("Ko-Fi"); font-size: Cat.fs11; font-weight: 700; color: #ff5e5b; vertical-alignment: center; }
                                            }
                                            kofi-ta2 := TouchArea { mouse-cursor: pointer; clicked => { root.open-url("https://ko-fi.com/xerolinux"); } }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1; height: 26px; border-radius: 7px;
                                            background: disc-ta.has-hover ? #5865f2.with-alpha(0.28) : #5865f2.with-alpha(0.12);
                                            border-width: 1px; border-color: #5865f2.with-alpha(0.35);
                                            animate background { duration: 80ms; }
                                            HorizontalLayout {
                                                alignment: center; spacing: 5px;
                                                VerticalLayout { alignment: center;
                                                    NavIcon {
                                                        d: "M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z";
                                                        icon-color: #5865f2; width: 12px; height: 12px;
                                                    }
                                                }
                                                Text { text: @tr("Discord"); font-size: Cat.fs11; font-weight: 700; color: #5865f2; vertical-alignment: center; }
                                            }
                                            disc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-url("https://discord.gg/5sqxTSuKZu"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Cat.divider; }

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: @tr("CREDITS");
                                            font-size: Cat.fs10; font-weight: 800; letter-spacing: 1px;
                                            color: Cat.overlay0; horizontal-alignment: center;
                                        }
                                        HorizontalLayout {
                                            alignment: center; spacing: 5px;
                                            Text {
                                                text: @tr("AppImage Update All:");
                                                font-size: Cat.fs12; color: Cat.subtext0; vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: cred-ivan-lbl.preferred-width + 4px;
                                                height: 18px;
                                                cred-ivan-lbl := Text {
                                                    text: "Ivan-HC";
                                                    font-size: Cat.fs12; font-weight: 700;
                                                    color: cred-ivan-ta.has-hover ? Cat.blue : Cat.mauve;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                                cred-ivan-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open-url("https://github.com/ivan-hc/AM"); }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: center; spacing: 5px;
                                            Text {
                                                text: @tr("AppImage Idea:");
                                                font-size: Cat.fs12; color: Cat.subtext0; vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Sharktooth";
                                                font-size: Cat.fs12; font-weight: 700; color: Cat.text; vertical-alignment: center;
                                            }
                                            Text {
                                                text: @tr("(nagged for it) 😂");
                                                font-size: Cat.fs11; color: Cat.overlay0; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if view == 12: Rectangle {
                vertical-stretch: 1;
                border-radius: 14px;
                background: Cat.base.with-alpha(0.82);
                border-width: 1px;
                border-color: Cat.surface0.with-alpha(0.5);
                clip: true;

              VerticalLayout {

                Rectangle {
                    height: 88px;
                    background: Cat.crust;

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 12px; padding-bottom: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 76px; height: 30px; border-radius: 8px;
                                background: dt-back-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                animate background { duration: 80ms; }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center; spacing: 6px;
                                        NavIcon { d: "M19 12H5M12 19l-7-7 7-7"; icon-color: Cat.subtext0; width: 14px; height: 14px; }
                                        Text { text: @tr("Back"); font-size: Cat.fs13; font-weight: 600; color: Cat.subtext0; }
                                    }
                                }
                                dt-back-ta := TouchArea { mouse-cursor: pointer; clicked => { view = 7; repos-view = 1; } }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 14px;
                            background: Cat.mauve.with-alpha(0.1);
                            border-width: 1px; border-color: Cat.mauve.with-alpha(0.28);

                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 38px; height: 38px; border-radius: 10px;
                                        background: Cat.mauve.with-alpha(0.16);
                                        NavIcon { d: icon-package; icon-color: Cat.mauve; width: 20px; height: 20px; x: 9px; y: 9px; }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: dep-tree-pkg; font-size: Cat.fs16; font-weight: 700; color: Cat.mauve; overflow: elide; }
                                    Text {
                                        text: dep-tree-loading ? "Resolving dependency tree…"
                                            : (dep-tree-root-version == "" ? "version unknown" : dep-tree-root-version);
                                        font-size: Cat.fs15; color: Cat.overlay1;
                                    }
                                }

                                if !dep-tree-loading: VerticalLayout {
                                    alignment: center; spacing: 5px;
                                    Rectangle {
                                        height: 20px; width: 82px; border-radius: 5px;
                                        background: Cat.blue.with-alpha(0.14);
                                        border-width: 1px; border-color: Cat.blue.with-alpha(0.22);
                                        Text { text: dep-tree-nodes.length + " deps"; font-size: Cat.fs14; font-weight: 600; color: Cat.blue; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 20px; width: 82px; border-radius: 5px;
                                        background: Cat.green.with-alpha(0.12);
                                        border-width: 1px; border-color: Cat.green.with-alpha(0.2);
                                        Text { text: dep-reqby-nodes.length + " req by"; font-size: Cat.fs14; font-weight: 600; color: Cat.green; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                if dep-tree-loading: VerticalLayout {
                                    alignment: center;
                                    LoadingCircle { diameter: 22px; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: Cat.mantle;

                    HorizontalLayout {
                        padding-left: 14px; spacing: 0px;

                        Rectangle {
                            width: dt-tab0-lbl.preferred-width + 28px; height: 40px;
                            background: transparent;
                            VerticalLayout {
                                alignment: center;
                                dt-tab0-lbl := Text { text: @tr("Depends On"); font-size: Cat.fs13; font-weight: dep-tree-tab == 0 ? 700 : 400; color: dep-tree-tab == 0 ? Cat.blue : Cat.overlay1; horizontal-alignment: center; }
                            }
                            if dep-tree-tab == 0: Rectangle { y: parent.height - 2px; height: 2px; background: Cat.blue; }
                            dt-tab0 := TouchArea { clicked => { dep-tree-tab = 0; } }
                        }

                        Rectangle {
                            width: dt-tab1-lbl.preferred-width + 28px; height: 40px;
                            background: transparent;
                            VerticalLayout {
                                alignment: center;
                                dt-tab1-lbl := Text { text: @tr("Required By"); font-size: Cat.fs13; font-weight: dep-tree-tab == 1 ? 700 : 400; color: dep-tree-tab == 1 ? Cat.green : Cat.overlay1; horizontal-alignment: center; }
                            }
                            if dep-tree-tab == 1: Rectangle { y: parent.height - 2px; height: 2px; background: Cat.green; }
                            dt-tab1 := TouchArea { clicked => { dep-tree-tab = 1; } }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                Rectangle {
                    height: 25px;
                    background: Cat.crust;

                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 0px;
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 16px;
                                HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3px; background: Cat.green; } } Text { text: @tr("installed"); font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; } }
                                HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3px; background: Cat.red; } } Text { text: @tr("missing"); font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; } }
                                HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3px; background: Cat.peach; } } Text { text: @tr("optional"); font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; } }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Cat.divider; }

                if dep-tree-loading: Rectangle {
                    vertical-stretch: 1;
                    Text { text: @tr("Resolving…"); horizontal-alignment: center; vertical-alignment: center; color: Cat.overlay0; font-size: Cat.fs13; }
                }

                if !dep-tree-loading && dep-tree-tab == 0: VerticalLayout {
                    vertical-stretch: 1;

                    if dep-tree-nodes.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text { text: @tr("No dependencies found."); horizontal-alignment: center; vertical-alignment: center; color: Cat.overlay0; font-size: Cat.fs14; }
                    }

                    if dep-tree-nodes.length > 0: ListView {
                        vertical-stretch: 1;

                        for node[i] in dep-tree-nodes: Rectangle {
                            height: node.depth == -1 ? 32px : 42px;
                            background: node.depth != -1 && dt-node-ta.has-hover
                                ? Cat.surface0.with-alpha(0.25) : transparent;
                            animate background { duration: 60ms; }

                            dt-node-ta := TouchArea {}

                            if node.depth == -1: HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { height: 1px; horizontal-stretch: 1; background: Cat.peach.with-alpha(0.3); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: @tr("Optional Dependencies"); font-size: Cat.fs14; font-weight: 700; color: Cat.peach.with-alpha(0.7); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { height: 1px; horizontal-stretch: 1; background: Cat.peach.with-alpha(0.3); }
                                }
                            }

                            if node.depth != -1: HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 0px;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: node.prefix;
                                        font-size: Cat.fs14;
                                        color: node.is-optional ? Cat.peach.with-alpha(0.5) : Cat.overlay0;
                                        vertical-alignment: center;
                                        width: node.depth == 1 ? 28px : 52px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center; width: 18px;
                                    Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px;
                                        background: node.is-optional ? Cat.peach
                                            : (node.installed ? Cat.green : Cat.red);
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            preferred-width: 0px;
                                            horizontal-stretch: 1;
                                            text: node.name;
                                            font-size: node.depth == 1 ? 13px : 12px;
                                            font-weight: node.depth == 1 ? 500 : 400;
                                            font-italic: node.is-optional;
                                            color: node.is-optional ? Cat.peach.with-alpha(0.85)
                                                : (node.installed
                                                    ? (node.depth == 1 ? Cat.text : Cat.subtext0)
                                                    : Cat.red);
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if !node.is-optional && node.depth == 1: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px; height: 16px; border-radius: 4px;
                                                background: Cat.blue.with-alpha(0.12);
                                                Text { text: @tr("hard"); font-size: Cat.fs13; font-weight: 700; color: Cat.blue.with-alpha(0.8); horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center; width: 80px;

                                    if node.installable && !node.installed: dt-install-btn := Rectangle {
                                        width: dt-inst-lbl.preferred-width + 20px; height: 24px;
                                        border-radius: 6px;
                                        background: dt-install-ta.has-hover ? Cat.green.with-alpha(0.25) : Cat.green.with-alpha(0.12);
                                        border-width: 1px;
                                        border-color: dt-install-ta.has-hover ? Cat.green.with-alpha(0.6) : Cat.green.with-alpha(0.3);
                                        animate background, border-color { duration: 80ms; }
                                        dt-inst-lbl := Text {
                                            text: @tr("Install");
                                            font-size: Cat.fs12; font-weight: 700;
                                            color: Cat.green;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                        dt-install-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.install-dep-package(node.name); }
                                        }
                                    }
                                }

                                if !(node.installable && !node.installed): VerticalLayout {
                                    alignment: center; width: 80px;
                                    Rectangle {
                                        height: 20px; border-radius: 5px;
                                        background: Cat.surface0.with-alpha(0.5);
                                        Text {
                                            text: node.version == "" ? "not installed" : node.version;
                                            font-size: Cat.fs14;
                                            color: node.version == "" ? Cat.red.with-alpha(0.7) : Cat.overlay1;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            if node.depth != -1: Rectangle {
                                x: 16px; y: parent.height - 1px;
                                width: parent.width - 32px; height: 1px;
                                background: Cat.surface0.with-alpha(0.35);
                            }
                        }
                    }
                }

                if !dep-tree-loading && dep-tree-tab == 1: VerticalLayout {
                    vertical-stretch: 1;

                    if dep-reqby-nodes.length == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center; spacing: 10px;
                            NavIcon { d: icon-package; icon-color: Cat.green; width: 32px; height: 29px; }
                            Text { text: @tr("Nothing depends on {0}", dep-tree-pkg); font-size: Cat.fs15; font-weight: 600; color: Cat.text; horizontal-alignment: center; }
                            Text { text: @tr("This package can be safely removed without breaking other packages."); font-size: Cat.fs13; color: Cat.overlay1; horizontal-alignment: center; }
                        }
                    }

                    if dep-reqby-nodes.length > 0: VerticalLayout {
                        vertical-stretch: 1;

                        Rectangle { height: 20px; background: transparent; }
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 20px;
                            Rectangle {
                                horizontal-stretch: 1; height: 60px;
                                border-radius: 14px;
                                background: Cat.green.with-alpha(0.08);
                                border-width: 1px; border-color: Cat.green.with-alpha(0.2);
                                HorizontalLayout {
                                    padding-left: 18px; padding-right: 18px; spacing: 12px;
                                    VerticalLayout { alignment: center; NavIcon { d: icon-package; icon-color: Cat.green; width: 20px; height: 20px; } }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        Text { text: dep-tree-pkg + " is required by " + dep-reqby-nodes.length + " installed packages"; font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                        Text { text: @tr("Removing it may break these packages"); font-size: Cat.fs14; color: Cat.overlay1; }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 14px; background: transparent; }
                        Rectangle { x: 20px; height: 1px; width: parent.width - 40px; background: Cat.surface0.with-alpha(0.6); }
                        Rectangle { height: 4px; background: transparent; }

                        ListView {
                            vertical-stretch: 1;
                            for node[i] in dep-reqby-nodes: Rectangle {
                                height: 46px;
                                background: rb-node-ta.has-hover ? Cat.surface0.with-alpha(0.25) : transparent;
                                animate background { duration: 60ms; }

                                rb-node-ta := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 24px; padding-right: 20px; spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Cat.green; }
                                    }
                                    Text {
                                        preferred-width: 0px; horizontal-stretch: 1;
                                        text: node.name; font-size: Cat.fs14; font-weight: 500; color: Cat.text; overflow: elide; vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 20px; width: 80px; border-radius: 5px;
                                            background: Cat.surface0.with-alpha(0.5);
                                            Text { text: node.version == "" ? "-" : node.version; font-size: Cat.fs14; color: Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                        }
                                    }
                                }

                                Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 32px; height: 1px; background: Cat.surface0.with-alpha(0.35); }
                            }
                        }
                    }
                }
              }
            }

            if view == 13: VerticalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                if arch-news-loading && arch-news-items.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 14px;
                    HorizontalLayout { alignment: center; LoadingCircle { diameter: 28px; } }
                    Text { text: @tr("Fetching Arch news..."); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                }

                if !arch-news-loading && arch-news-items.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    Text { text: @tr("No news loaded. Press Refresh."); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                }

                if arch-news-items.length > 0: ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 12px;
                        alignment: start;

                        for item[i] in arch-news-items: Rectangle {
                            border-radius: 10px;
                            background: i == 0 ? Cat.green.with-alpha(0.07) : Cat.surface0.with-alpha(0.45);
                            border-width: i == 0 ? 1.5px : 1px;
                            border-color: i == 0 ? Cat.green.with-alpha(0.6) : Cat.surface1.with-alpha(0.6);

                            VerticalLayout {
                                padding-left: 18px; padding-right: 18px;
                                padding-top: 14px; padding-bottom: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: item.title;
                                        font-size: Cat.fs15; font-weight: 700;
                                        color: Cat.text;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                    if i == 0: VerticalLayout { alignment: start;
                                        Rectangle {
                                            width: 44px; height: 20px; border-radius: 6px;
                                            background: Cat.green.with-alpha(0.2);
                                            Text { text: @tr("New"); font-size: Cat.fs11; font-weight: 700; color: Cat.green; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Text {
                                    text: item.date;
                                    font-size: Cat.fs12;
                                    color: Cat.overlay0;
                                }

                                if item.summary != "": Rectangle {
                                    height: 1px;
                                    background: Cat.surface1.with-alpha(0.5);
                                }

                                if item.summary != "": Text {
                                    text: item.summary;
                                    font-size: Cat.fs13;
                                    color: Cat.subtext0;
                                    wrap: word-wrap;
                                }

                                if item.link != "": HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: news-link-lbl.preferred-width + 20px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: news-link-ta.has-hover ? Cat.blue.with-alpha(0.18) : Cat.blue.with-alpha(0.08);
                                        border-width: 1px;
                                        border-color: Cat.blue.with-alpha(0.3);
                                        animate background { duration: 60ms; }
                                        news-link-lbl := Text {
                                            text: @tr("Read more");
                                            font-size: Cat.fs12; font-weight: 600;
                                            color: Cat.blue;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        news-link-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open-url(item.link); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if view == 11: VerticalLayout {
                vertical-stretch: 1;

                Rectangle {
                    height: 70px;
                    background: Cat.crust;

                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.green.with-alpha(0.15); }

                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px; height: 31px; border-radius: 8px;
                                background: Cat.green.with-alpha(0.12);
                                border-width: 1px; border-color: Cat.green.with-alpha(0.25);
                                NavIcon { d: icon-wrench; icon-color: Cat.green; width: 18px; height: 18px; x: 8px; y: 8px; }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Troubleshooting"); font-size: Cat.fs16; font-weight: 800; color: Cat.green; }
                            Text { text: @tr("System & Pacman diagnostics - repair tools for common issues"); font-size: Cat.fs14; color: Cat.overlay1; }
                        }

                        VerticalLayout {
                            alignment: center; spacing: 3px;
                            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: Cat.green; }
                            Text { text: @tr("READY"); font-size: Cat.fs9; font-weight: 700; color: Cat.green.with-alpha(0.6); horizontal-alignment: center; }
                        }
                    }
                }

                Rectangle {
                    height: 38px;
                    background: Cat.peach.with-alpha(0.08);
                    border-width: 1px; border-color: Cat.peach.with-alpha(0.2);
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 6px; alignment: center;
                        Text { text: "⚠"; font-size: Cat.fs16; color: Cat.peach; vertical-alignment: center; }
                        Text { text: @tr("Use at your own risk - these operations modify system files and may require a reboot."); font-size: Cat.fs13; color: Cat.peach.with-alpha(0.85); vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                Rectangle {
                    height: 76px;
                    background: transparent;
                    clip: true;

                    property <float> glow: 0.18;
                    animate glow { duration: 1100ms; easing: ease-in-out; }
                    Timer { interval: 1200ms; running: true; triggered => { glow = glow > 0.12 ? 0.04 : 0.22; } }

                    property <float> lp: 0.0;
                    animate lp { duration: 1600ms; easing: linear; }
                    Timer { interval: 1700ms; running: true; triggered => { lp = lp < 0.5 ? 1.0 : 0.0; } }

                    property <float> rp: 1.0;
                    animate rp { duration: 1600ms; easing: linear; }
                    Timer { interval: 1700ms; running: true; triggered => { rp = rp > 0.5 ? 0.0 : 1.0; } }

                    Rectangle {
                        x: 0; y: 37px;
                        width: parent.width / 2 - 42px;
                        height: 1px;
                        background: @linear-gradient(90deg, transparent 0%, Cat.mauve.with-alpha(0.12) 20%, Cat.mauve.with-alpha(0.38) 100%);
                    }
                    Rectangle {
                        x: lp * (parent.width / 2 - 42px) - 3px;
                        y: 35px; width: 5px; height: 5px; border-radius: 3px;
                        background: Cat.mauve.with-alpha(0.7);
                    }
                    Rectangle { x: parent.width / 2 - 130px; y: 22px; width: 32px; height: 1px; background: Cat.mauve.with-alpha(0.22); }
                    Rectangle { x: parent.width / 2 - 130px; y: 22px; width: 1px; height: 15px; background: Cat.mauve.with-alpha(0.22); }
                    Rectangle { x: parent.width / 2 - 132px; y: 20px; width: 5px; height: 5px; border-radius: 1px; background: Cat.mauve.with-alpha(0.45); }
                    Rectangle { x: parent.width / 2 - 165px; y: 38px; width: 1px; height: 16px; background: Cat.mauve.with-alpha(0.18); }
                    Rectangle { x: parent.width / 2 - 165px; y: 54px; width: 28px; height: 1px; background: Cat.mauve.with-alpha(0.18); }
                    Rectangle { x: parent.width / 2 - 167px; y: 36px; width: 5px; height: 5px; border-radius: 1px; background: Cat.mauve.with-alpha(0.35); }
                    Rectangle { x: parent.width / 2 - 210px; y: 28px; width: 20px; height: 1px; background: Cat.mauve.with-alpha(0.14); }
                    Rectangle { x: parent.width / 2 - 210px; y: 28px; width: 1px; height: 9px; background: Cat.mauve.with-alpha(0.14); }
                    Rectangle { x: parent.width / 2 - 104px; y: 19px; width: 10px; height: 6px; border-radius: 1px; border-width: 1px; border-color: Cat.mauve.with-alpha(0.3); background: Cat.mauve.with-alpha(0.08); }

                    Rectangle {
                        x: parent.width / 2 + 42px; y: 37px;
                        width: parent.width / 2 - 42px;
                        height: 1px;
                        background: @linear-gradient(90deg, Cat.mauve.with-alpha(0.38) 0%, Cat.mauve.with-alpha(0.12) 80%, transparent 100%);
                    }
                    Rectangle {
                        x: parent.width / 2 + 42px + rp * (parent.width / 2 - 42px) - 3px;
                        y: 35px; width: 5px; height: 5px; border-radius: 3px;
                        background: Cat.mauve.with-alpha(0.7);
                    }
                    Rectangle { x: parent.width / 2 + 98px; y: 22px; width: 32px; height: 1px; background: Cat.mauve.with-alpha(0.22); }
                    Rectangle { x: parent.width / 2 + 129px; y: 22px; width: 1px; height: 15px; background: Cat.mauve.with-alpha(0.22); }
                    Rectangle { x: parent.width / 2 + 127px; y: 20px; width: 5px; height: 5px; border-radius: 1px; background: Cat.mauve.with-alpha(0.45); }
                    Rectangle { x: parent.width / 2 + 137px; y: 38px; width: 1px; height: 16px; background: Cat.mauve.with-alpha(0.18); }
                    Rectangle { x: parent.width / 2 + 137px; y: 54px; width: 28px; height: 1px; background: Cat.mauve.with-alpha(0.18); }
                    Rectangle { x: parent.width / 2 + 135px; y: 36px; width: 5px; height: 5px; border-radius: 1px; background: Cat.mauve.with-alpha(0.35); }
                    Rectangle { x: parent.width / 2 + 190px; y: 28px; width: 20px; height: 1px; background: Cat.mauve.with-alpha(0.14); }
                    Rectangle { x: parent.width / 2 + 209px; y: 28px; width: 1px; height: 9px; background: Cat.mauve.with-alpha(0.14); }
                    Rectangle { x: parent.width / 2 + 94px; y: 19px; width: 10px; height: 6px; border-radius: 1px; border-width: 1px; border-color: Cat.mauve.with-alpha(0.3); background: Cat.mauve.with-alpha(0.08); }

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 46px; height: 46px; border-radius: 23px;
                        background: Cat.mauve.with-alpha(glow);
                        border-width: 1px; border-color: Cat.mauve.with-alpha(0.35);
                        NavIcon { d: icon-wrench; icon-color: Cat.mauve.with-alpha(0.75); width: 22px; height: 22px; x: 12px; y: 12px; }
                    }
                }

                ScrollView {
                VerticalLayout {
                    alignment: window-width > 1200 ? center : start;
                    padding-left: 28px; padding-right: 28px;
                    padding-top: 16px; padding-bottom: 16px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { width: 3px; border-radius: 2px; background: Cat.green; }
                        Text { text: @tr("SYSTEM"); font-size: Cat.fs10; font-weight: 800; color: Cat.green; letter-spacing: 1.2px; vertical-alignment: center; }
                        Rectangle { height: 1px; horizontal-stretch: 1; background: Cat.green.with-alpha(0.2); y: parent.height / 2; }
                    }

                    GridLayout {
                        spacing: 10px;

                        Rectangle {
                            row: 0; col: 0; height: 125px; border-radius: 12px;
                            background: ini-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            ini-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-transaction-history(); } }
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.mauve; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.mauve.with-alpha(0.12); border-width: 1px; border-color: Cat.mauve.with-alpha(0.25);
                                            NavIcon { d: "M3 3v5h5M3.05 13a9 9 0 105.5-7.6L3 8M12 7v5l4 2"; icon-color: Cat.mauve; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Transaction History"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Review and roll back past pacman updates"); font-size: Cat.fs14; color: Cat.overlay1; overflow: elide; }
                                        Text { text: @tr("reads /var/log/pacman.log"); font-size: Cat.fs13; color: Cat.mauve.with-alpha(0.7); overflow: elide; } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 62px; height: 26px; border-radius: 6px; background: ini-btn.has-hover ? Cat.mauve.with-alpha(0.25) : Cat.mauve.with-alpha(0.1); border-width: 1px; border-color: Cat.mauve.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("OPEN"); font-size: Cat.fs10; font-weight: 700; color: Cat.mauve; horizontal-alignment: center; vertical-alignment: center; }
                                            ini-btn := TouchArea { mouse-cursor: pointer; clicked => { root.open-transaction-history(); } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 0; col: 1; height: 125px; border-radius: 12px;
                            background: key-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            key-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.yellow; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.yellow.with-alpha(0.12); border-width: 1px; border-color: Cat.yellow.with-alpha(0.25);
                                            NavIcon { d: icon-refresh; icon-color: Cat.yellow; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Fix GnuPG Keyring"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Reset and repopulate pacman keys"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: "$ pacman-key --init && pacman-key --populate"; font-size: Cat.fs13; color: Cat.yellow.with-alpha(0.7); overflow: elide; } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: key-btn.has-hover ? Cat.yellow.with-alpha(0.25) : Cat.yellow.with-alpha(0.1); border-width: 1px; border-color: Cat.yellow.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.yellow; horizontal-alignment: center; vertical-alignment: center; }
                                            key-btn := TouchArea { mouse-cursor: pointer; clicked => { root.fix-keyring(); } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 1; col: 0; height: 125px; border-radius: 12px;
                            background: grb-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            grb-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.peach; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.peach.with-alpha(0.12); border-width: 1px; border-color: Cat.peach.with-alpha(0.25);
                                            NavIcon { d: icon-chip; icon-color: Cat.peach; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Rebuild Grub"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Regenerate GRUB bootloader config"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: "$ update-grub"; font-size: Cat.fs13; color: Cat.peach.with-alpha(0.7); } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: grb-btn.has-hover ? Cat.peach.with-alpha(0.25) : Cat.peach.with-alpha(0.1); border-width: 1px; border-color: Cat.peach.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.peach; horizontal-alignment: center; vertical-alignment: center; }
                                            grb-btn := TouchArea { mouse-cursor: pointer; clicked => { root.rebuild-grub(); } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 1; col: 1; height: 125px; border-radius: 12px;
                            background: orp-ts-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            orp-ts-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.red; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.red.with-alpha(0.12); border-width: 1px; border-color: Cat.red.with-alpha(0.25);
                                            NavIcon { d: icon-trash; icon-color: Cat.red; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Orphan Manager"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Review and remove orphaned packages"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: stats.orphan-count + " orphaned package(s) found"; font-size: Cat.fs13; color: stats.orphan-count > 0 ? Cat.red.with-alpha(0.8) : Cat.overlay0; } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: orp-ts-btn.has-hover ? Cat.red.with-alpha(0.25) : Cat.red.with-alpha(0.1); border-width: 1px; border-color: Cat.red.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                            orp-ts-btn := TouchArea { mouse-cursor: pointer; clicked => { root.load-orphan-list(); root.show-orphan-dialog = true; } } } }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { width: 3px; border-radius: 2px; background: Cat.blue; }
                        Text { text: @tr("PACMAN"); font-size: Cat.fs10; font-weight: 800; color: Cat.blue; letter-spacing: 1.2px; vertical-alignment: center; }
                        Rectangle { height: 1px; horizontal-stretch: 1; background: Cat.blue.with-alpha(0.2); y: parent.height / 2; }
                    }

                    GridLayout {
                        spacing: 10px;

                        Rectangle {
                            row: 0; col: 0; height: 125px; border-radius: 12px;
                            background: exp-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            exp-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.sapphire; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.sapphire.with-alpha(0.12); border-width: 1px; border-color: Cat.sapphire.with-alpha(0.25);
                                            NavIcon { d: icon-file; icon-color: Cat.sapphire; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Export Package List"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Save explicitly installed packages to a file"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: "$ pacman -Qqe > packages.txt"; font-size: Cat.fs13; color: Cat.sapphire.with-alpha(0.7); } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: exp-btn.has-hover ? Cat.sapphire.with-alpha(0.25) : Cat.sapphire.with-alpha(0.1); border-width: 1px; border-color: Cat.sapphire.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.sapphire; horizontal-alignment: center; vertical-alignment: center; }
                                            exp-btn := TouchArea { mouse-cursor: pointer; clicked => { root.export-package-list(); } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 0; col: 1; height: 125px; border-radius: 12px;
                            background: imp-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            imp-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.green; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.green.with-alpha(0.12); border-width: 1px; border-color: Cat.green.with-alpha(0.25);
                                            NavIcon { d: icon-folder; icon-color: Cat.green; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Import Package List"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Install packages from an exported list file"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: "$ pacman -S --needed $(cat packages.txt)"; font-size: Cat.fs13; color: Cat.green.with-alpha(0.7); overflow: elide; } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: imp-btn.has-hover ? Cat.green.with-alpha(0.25) : Cat.green.with-alpha(0.1); border-width: 1px; border-color: Cat.green.with-alpha(0.35); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.green; horizontal-alignment: center; vertical-alignment: center; }
                                            imp-btn := TouchArea { mouse-cursor: pointer; clicked => { root.import-package-list(); } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 1; col: 0; height: 125px; border-radius: 12px;
                            background: ulk-ta.has-hover ? Cat.surface0.with-alpha(0.7) : Cat.surface0.with-alpha(0.45);
                            animate background { duration: 80ms; }
                            ulk-ta := TouchArea {}
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.red; }
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.red.with-alpha(0.12); border-width: 1px; border-color: Cat.red.with-alpha(0.25);
                                            NavIcon { d: icon-lock; icon-color: Cat.red; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: @tr("Unlock Database"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                        Text { text: @tr("Remove stale pacman DB lock file"); font-size: Cat.fs14; color: Cat.overlay1; }
                                        Text { text: "$ rm /var/lib/pacman/db.lck"; font-size: Cat.fs13; color: Cat.red.with-alpha(0.7); } }
                                    VerticalLayout { alignment: center;
                                        Rectangle { width: 58px; height: 26px; border-radius: 6px; background: ulk-btn.has-hover ? Cat.red.with-alpha(0.3) : Cat.red.with-alpha(0.12); border-width: 1px; border-color: Cat.red.with-alpha(0.4); animate background { duration: 70ms; }
                                            Text { text: @tr("▶  RUN"); font-size: Cat.fs10; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                            ulk-btn := TouchArea { mouse-cursor: pointer; clicked => { root.show-unlock-db-confirm = true; } } } }
                                }
                            }
                        }

                        Rectangle {
                            row: 1; col: 1;
                            height: 125px;
                            border-radius: 12px;
                            background: Cat.surface0.with-alpha(0.45);
                            border-width: 1px;
                            border-color: ignorepkg-active ? Cat.peach.with-alpha(0.3) : Cat.surface0.with-alpha(0.0);
                            animate height { duration: 120ms; }
                            animate border-color { duration: 120ms; }
                            HorizontalLayout {
                                Rectangle { width: 3px; background: Cat.peach; }
                                VerticalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    padding-top: 10px; padding-bottom: 10px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout { alignment: center;
                                            Rectangle { width: 38px; height: 38px; border-radius: 19px; background: Cat.peach.with-alpha(0.12); border-width: 1px; border-color: Cat.peach.with-alpha(0.25);
                                                NavIcon { d: icon-chip; icon-color: Cat.peach; width: 18px; height: 18px; x: 10px; y: 10px; } } }
                                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                            Text { text: @tr("IgnorePkg"); font-size: Cat.fs13; font-weight: 700; color: Cat.text; }
                                            Text {
                                                text: ignorepkg-active
                                                    ? (ignorepkg-value == "" ? "Active - no packages set" : "Active: " + ignorepkg-value)
                                                    : (ignorepkg-value == "" ? "Inactive - none configured" : "Inactive: " + ignorepkg-value);
                                                font-size: Cat.fs14;
                                                color: ignorepkg-active ? Cat.peach : Cat.overlay1;
                                                overflow: elide;
                                            }
                                            Text { text: @tr("# /etc/pacman.conf IgnorePkg"); font-size: Cat.fs13; color: Cat.peach.with-alpha(0.6); }
                                        }
                                        VerticalLayout { alignment: center;
                                            Rectangle {
                                                width: ig-tog-lbl.preferred-width + 20px; height: 26px; border-radius: 6px;
                                                background: ignorepkg-active
                                                    ? (ig-tog.has-hover ? Cat.peach.with-alpha(0.3) : Cat.peach.with-alpha(0.18))
                                                    : (ig-tog.has-hover ? Cat.surface1 : Cat.surface0);
                                                border-width: 1px;
                                                border-color: ignorepkg-active ? Cat.peach.with-alpha(0.5) : Cat.surface1;
                                                animate background { duration: 80ms; }
                                                ig-tog-lbl := Text { text: ignorepkg-active ? @tr("Active") : @tr("Inactive"); font-size: Cat.fs10; font-weight: 700; color: ignorepkg-active ? Cat.peach : Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; }
                                                ig-tog := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        ignorepkg-active = !ignorepkg-active;
                                                        root.save-ignorepkg(ignorepkg-active, ignorepkg-value);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if ignorepkg-active: HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal-stretch: 1; height: 25px; border-radius: 6px;
                                            background: Cat.surface1;
                                            border-width: ig-ti.has-focus ? 1px : 0px;
                                            border-color: Cat.peach.with-alpha(0.5);
                                            clip: true; animate border-width { duration: 80ms; }

                                            TouchArea { width: 100%; height: 100%; clicked => { ig-ti.focus(); } }

                                            ig-ti := TextInput {
                                                x: 8px; y: 0;
                                                width: parent.width - 16px; height: 100%;
                                                text <=> ignorepkg-edit-text;
                                                font-size: Cat.fs14; color: Cat.text; single-line: true; vertical-alignment: center;
                                                selection-background-color: Cat.peach.with-alpha(0.3);
                                                accepted => { ignorepkg-value = ignorepkg-edit-text; root.save-ignorepkg(true, ignorepkg-edit-text); }
                                            }

                                            if ignorepkg-edit-text == "" && !ig-ti.has-focus: Text {
                                                x: 8px; y: 0;
                                                width: parent.width - 16px; height: 100%;
                                                text: @tr("Packages (space-separated)");
                                                font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: ig-save-lbl.preferred-width + 24px; height: 25px; border-radius: 6px;
                                            background: ig-save.has-hover ? Cat.peach.with-alpha(0.85) : Cat.peach;
                                            animate background { duration: 70ms; }
                                            ig-save-lbl := Text { text: @tr("Save"); font-size: Cat.fs14; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                            ig-save := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { ignorepkg-value = ignorepkg-edit-text; root.save-ignorepkg(true, ignorepkg-edit-text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            if view == 9: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 4px;
                    spacing: 20px;
                    alignment: start;

                    if !aur-pill-dismissed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: min(aur-pill-text.preferred-width + 15px + 8px + 24px + 28px, root.width - sidebar-vl.preferred-width - 12px);
                            border-radius: 8px;
                            background: Cat.yellow.with-alpha(0.08);
                            border-width: 1px;
                            border-color: Cat.yellow.with-alpha(0.35);

                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px;
                                padding-top: 9px; padding-bottom: 9px;
                                spacing: 8px;

                                VerticalLayout { alignment: center;
                                    NavIcon {
                                        d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                                        icon-color: Cat.yellow;
                                        width: 15px; height: 15px;
                                    }
                                }

                                aur-pill-text := Text {
                                    text: @tr("No AUR support. Chaotic-AUR (XeroLinux) or | paru <pkg> | instead.");
                                    font-size: Cat.fs13;
                                    color: Cat.yellow;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px; height: 20px;
                                        border-radius: 4px;
                                        background: aur-dismiss-ta.has-hover ? Cat.yellow.with-alpha(0.18) : transparent;

                                        aur-dismiss-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                aur-pill-dismissed = true;
                                                root.aur-pill-dismiss();
                                            }
                                        }

                                        NavIcon {
                                            d: "M18 6L6 18M6 6l12 12";
                                            icon-color: Cat.yellow.with-alpha(0.7);
                                            width: 12px; height: 12px;
                                            x: (parent.width - 12px) / 2;
                                            y: (parent.height - 12px) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { section-title: @tr("SYSTEM OVERVIEW"); }

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 82px;
                                border-radius: 10px;
                                background: Cat.blue.with-alpha(0.1);
                                border-width: 1px;
                                border-color: Cat.blue.with-alpha(0.25);

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    if loading: Text { text: "--"; font-size: Cat.fs30; font-weight: 700; color: Cat.blue; horizontal-alignment: center; }
                                    if !loading: Text {
                                        text: stats.pacman-count;
                                        font-size: Cat.fs30;
                                        font-weight: 700;
                                        color: Cat.blue;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Pacman Packages");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay1;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 82px;
                                border-radius: 10px;
                                background: Cat.teal.with-alpha(0.1);
                                border-width: 1px;
                                border-color: Cat.teal.with-alpha(0.25);

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    if loading: Text { text: "--"; font-size: Cat.fs30; font-weight: 700; color: Cat.teal; horizontal-alignment: center; }
                                    if !loading: Text {
                                        text: stats.flatpak-count;
                                        font-size: Cat.fs30;
                                        font-weight: 700;
                                        color: Cat.teal;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Flatpak Apps");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay1;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 82px;
                                border-radius: 10px;
                                background: total-update-count > 0 ? Cat.peach.with-alpha(0.1) : Cat.surface0.with-alpha(0.35);
                                border-width: 1px;
                                border-color: total-update-count > 0 ? Cat.peach.with-alpha(0.25) : Cat.surface0.with-alpha(0.2);

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    if loading: Text { text: "--"; font-size: Cat.fs30; font-weight: 700; color: Cat.overlay0; horizontal-alignment: center; }
                                    if !loading: Text {
                                        text: total-update-count;
                                        font-size: Cat.fs30;
                                        font-weight: 700;
                                        color: total-update-count > 0 ? Cat.peach : Cat.overlay0;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("Updates");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay1;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 82px;
                                border-radius: 10px;
                                background: Cat.mauve.with-alpha(0.1);
                                border-width: 1px;
                                border-color: Cat.mauve.with-alpha(0.25);

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    if loading: Text { text: "--"; font-size: Cat.fs30; font-weight: 700; color: Cat.mauve; horizontal-alignment: center; }
                                    if !loading: Text {
                                        text: installed-appimages.length;
                                        font-size: Cat.fs30;
                                        font-weight: 700;
                                        color: Cat.mauve;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: @tr("AppImages");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay1;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { section-title: @tr("QUICK ACTIONS"); }

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 66px;
                                border-radius: 10px;
                                background: home-appcache-touch.has-hover ? Cat.peach.with-alpha(0.18) : Cat.surface0.with-alpha(0.4);
                                animate background { duration: 100ms; }

                                home-appcache-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clean-app-cache(); }
                                }

                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Clean App Cache");
                                        font-size: Cat.fs14;
                                        font-weight: 600;
                                        color: Cat.peach;
                                    }
                                    Text {
                                        text: @tr("Clear index & restart");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay0;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 66px;
                                border-radius: 10px;
                                background: home-cache-touch.has-hover ? Cat.blue.with-alpha(0.15) : Cat.surface0.with-alpha(0.4);
                                animate background { duration: 100ms; }

                                home-cache-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clean-package-cache(); }
                                }

                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Clean Cache");
                                        font-size: Cat.fs14;
                                        font-weight: 600;
                                        color: Cat.blue;
                                    }
                                    if loading: Rectangle { width: 70px; height: 11px; border-radius: 3px; background: Cat.overlay0.with-alpha(0.1); }
                                    if !loading: Text {
                                        text: stats.cache-size + " used";
                                        font-size: Cat.fs15;
                                        color: Cat.overlay0;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 66px;
                                border-radius: 10px;
                                background: home-mirror-touch.has-hover ? Cat.teal.with-alpha(0.15) : Cat.surface0.with-alpha(0.4);
                                opacity: busy ? 0.5 : 1.0;
                                animate background { duration: 100ms; }

                                home-mirror-touch := TouchArea {
                                    mouse-cursor: busy ? default : pointer;
                                    clicked => { if !busy { root.update-mirrorlists(); } }
                                }

                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: @tr("Update Mirrorlists");
                                        font-size: Cat.fs14;
                                        font-weight: 600;
                                        color: Cat.teal;
                                    }
                                    Text {
                                        text: @tr("Re-rank fastest mirrors");
                                        font-size: Cat.fs15;
                                        color: Cat.overlay0;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;

                        SectionLabel { section-title: @tr("SYSTEM"); }

                        Rectangle {
                            border-radius: 12px;
                            background: Cat.crust.with-alpha(0.25);
                            border-width: 1px;
                            border-color: Cat.surface0;
                            clip: true;

                            VerticalLayout {
                                Rectangle {
                                    height: 31px;
                                    background: Cat.mantle.with-alpha(0.5);

                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;

                                        VerticalLayout { alignment: center;
                                            HorizontalLayout { spacing: 6px;
                                                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #ed6a5e; }
                                                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #f4bf4f; }
                                                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #61c554; }
                                            }
                                        }

                                        Text {
                                            text: @tr("System Info");
                                            font-size: Cat.fs12; font-family: "monospace";
                                            color: Cat.overlay0;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        Rectangle { width: 34px; }
                                    }
                                }

                                Rectangle { height: 1px; background: Cat.divider; }

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("HOST"); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                        Text {
                                            text: sys-info.hostname != "" ? sys-info.hostname : "localhost";
                                            font-size: Cat.fs12; font-weight: 600; font-family: "monospace";
                                            color: Cat.mauve; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                        }
                                        if sys-info.distro != "": Rectangle {
                                            width: distro-lbl2.preferred-width + 14px;
                                            height: 20px; border-radius: 4px;
                                            background: Cat.mauve.with-alpha(0.1);
                                            border-width: 1px; border-color: Cat.mauve.with-alpha(0.25);
                                            distro-lbl2 := Text {
                                                text: sys-info.distro;
                                                font-size: Cat.fs9; font-weight: 600;
                                                color: Cat.mauve;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Cat.surface0.with-alpha(0.6); }

                                    HorizontalLayout {
                                        spacing: 24px;

                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 9px;

                                            HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("OS "); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.kernel; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.teal; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            }
                                            HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("CPU"); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.cpu; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            }
                                            HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("MEM"); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.ram-used + " / " + sys-info.ram-total; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.green; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 9px;

                                            HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("UP "); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.uptime; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.yellow; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                            if sys-info.gpu != "": HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("GPU"); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.gpu; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            }
                                            if sys-info.disk-total != "": HorizontalLayout { spacing: 8px;
                                                Text { text: @tr("DSK"); font-size: Cat.fs9; font-weight: 700; color: Cat.overlay0; letter-spacing: 0.6px; vertical-alignment: center; width: 44px; }
                                                Text { text: sys-info.disk-used + " / " + sys-info.disk-total; font-size: Cat.fs12; font-weight: 500; font-family: "monospace"; color: Cat.sapphire; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;

                        SectionLabel { section-title: @tr("RECENT ACTIVITY"); }

                        VerticalLayout {
                            spacing: 0;

                            if activity-items.length == 0: Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: Cat.surface0.with-alpha(0.3);
                                Text {
                                    text: @tr("No activity found");
                                    font-size: Cat.fs15;
                                    color: Cat.overlay0;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for item[i] in activity-items: Rectangle {
                                height: 38px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Rectangle {
                                        width: action-lbl.preferred-width + 12px;
                                        height: 18px;
                                        border-radius: 5px;
                                        y: (parent.height - 18px) / 2;
                                        background: item.action == "installed" ? Cat.green.with-alpha(0.18)
                                            : item.action == "removed" ? Cat.red.with-alpha(0.18)
                                            : Cat.peach.with-alpha(0.18);

                                        action-lbl := Text {
                                            text: item.action;
                                            font-size: Cat.fs10;
                                            font-weight: 600;
                                            color: item.action == "installed" ? Cat.green
                                                : item.action == "removed" ? Cat.red
                                                : Cat.peach;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: item.package;
                                        font-size: Cat.fs13;
                                        font-weight: 500;
                                        color: Cat.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: item.date;
                                        font-size: Cat.fs14;
                                        color: Cat.overlay0;
                                        vertical-alignment: center;
                                    }
                                }

                                if i < activity-items.length - 1: Rectangle {
                                    x: 12px;
                                    y: parent.height - 1px;
                                    width: parent.width - 24px;
                                    height: 1px;
                                    background: Cat.surface0;
                                    opacity: 0.5;
                                }
                            }
                        }
                    }
                }

            if view == 2 || view == 3 || view == 4: Rectangle { vertical-stretch: 1; }
        }
    }

    }


    if selected-count > 0: Rectangle {
        x: (parent.width - 420px) / 2;
        y: parent.height - 72px;
        width: 420px;
        height: 47px;
        border-radius: 24px;
        background: Cat.surface0;
        drop-shadow-blur: 20px;
        drop-shadow-color: Cat.crust.with-alpha(0.5);
        drop-shadow-offset-y: 4px;
        border-width: 1px;
        border-color: Cat.surface1;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            padding-top: 0px;
            padding-bottom: 0px;
            spacing: 8px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                Text {
                    text: selected-count + " selected";
                    font-size: Cat.fs13;
                    font-weight: 500;
                    color: Cat.text;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 32px;
                    border-radius: 6px;
                    background: fab-clear-touch.has-hover ? Cat.surface1 : transparent;

                    Text {
                        text: @tr("Clear");
                        font-size: Cat.fs15;
                        color: Cat.subtext0;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fab-clear-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clear-selection(); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Btn {
                    label: @tr("Install");
                    primary: selected-uninstalled-count > 0;
                    enabled: selected-uninstalled-count > 0;
                    min-width: 60px;
                    clicked => {
                        if view == 10 { root.batch-flatpak-install(); }
                        else { root.bulk-install(); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Btn {
                    label: @tr("Remove");
                    danger: selected-installed-count > 0;
                    enabled: selected-installed-count > 0;
                    min-width: 64px;
                    clicked => {
                        if view == 10 { root.batch-flatpak-remove(); }
                        else { root.bulk-remove(); }
                    }
                }
            }
        }
    }

    if show-addons-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: Cat.crust.with-alpha(0.65);

        TouchArea { clicked => { root.show-addons-modal = false; root.addon-select-all(false); } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: min(560px, parent.height - 60px);
            background: Cat.base;
            border-radius: 14px;
            border-width: 1px;
            border-color: Cat.surface1;
            drop-shadow-blur: 40px;
            drop-shadow-color: Cat.crust.with-alpha(0.7);
            drop-shadow-offset-y: 10px;

            TouchArea {}

            property <bool> all-selected: flatpak-addons.length > 0 && addon-selected-count == flatpak-addons.length;

            VerticalLayout {
                padding: 24px;
                spacing: 0;

                HorizontalLayout {
                    spacing: 10px;

                    NavIcon {
                        d: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5";
                        icon-color: Cat.mauve; width: 20px; height: 20px;
                    }
                    Text {
                        text: @tr("Add-Ons & Extensions");
                        font-size: Cat.fs17; font-weight: 700; color: Cat.text;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                    if flatpak-addons.length > 0: Rectangle {
                        width: sel-all-lbl.preferred-width + 24px; height: 32px; border-radius: 6px;
                        background: sel-all-t.has-hover
                            ? (all-selected ? Cat.peach.with-alpha(0.2) : Cat.mauve.with-alpha(0.2))
                            : (all-selected ? Cat.peach.with-alpha(0.1) : Cat.mauve.with-alpha(0.1));
                        border-width: 1px;
                        border-color: all-selected ? Cat.peach.with-alpha(0.4) : Cat.mauve.with-alpha(0.35);
                        animate background { duration: 60ms; }
                        sel-all-lbl := Text {
                            text: all-selected ? "Deselect All" : "Select All";
                            font-size: Cat.fs15; font-weight: 600;
                            color: all-selected ? Cat.peach : Cat.mauve;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        sel-all-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.addon-select-all(!all-selected); }
                        }
                    }
                    Rectangle { width: 6px; }
                    Rectangle {
                        width: 28px; height: 25px; border-radius: 6px;
                        background: close-modal-t.has-hover ? Cat.surface1 : transparent;
                        NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                        close-modal-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-addons-modal = false; root.addon-select-all(false); }
                        }
                    }
                }

                Rectangle { height: 14px; }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 0;

                        if flatpak-addons.length > 0: Rectangle {
                            height: 25px;
                            background: Cat.surface0.with-alpha(0.4);
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                Text {
                                    text: @tr("Available to Install");
                                    font-size: Cat.fs14; font-weight: 700;
                                    color: Cat.subtext0; vertical-alignment: center;
                                    letter-spacing: 0.5px;
                                }
                            }
                        }

                        for addon[ai] in flatpak-addons: Rectangle {
                            property <bool> is-checked: ai < addon-selected.length && addon-selected[ai];
                            height: 56px;
                            border-radius: 6px;
                            animate background { duration: 60ms; }
                            background: arow-ta.has-hover ? Cat.surface0.with-alpha(0.6) : transparent;

                            arow-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-addon-selected(ai); }
                            }

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 18px; height: 18px; border-radius: 5px;
                                        border-width: 1.5px;
                                        border-color: is-checked ? Cat.mauve : Cat.surface2;
                                        background: is-checked ? Cat.mauve : transparent;
                                        animate background { duration: 80ms; }
                                        if is-checked: NavIcon {
                                            d: "M20 6L9 17l-5-5"; icon-color: Cat.crust;
                                            width: 10px; height: 10px; x: 4px; y: 4px;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 3px; alignment: center;
                                    Text {
                                        text: addon.display-name;
                                        font-size: Cat.fs14; font-weight: 600; color: Cat.text; overflow: elide;
                                    }
                                    Text {
                                        text: addon.description;
                                        font-size: Cat.fs15; color: Cat.overlay1; overflow: elide;
                                    }
                                }
                            }

                            if ai < flatpak-addons.length - 1: Rectangle {
                                x: 10px; y: parent.height - 1px;
                                width: parent.width - 20px; height: 1px;
                                background: Cat.surface0; opacity: 0.6;
                            }
                        }

                        if flatpak-addons.length > 0 && flatpak-addons-installed.length > 0: Rectangle {
                            height: 8px; background: transparent;
                        }
                        if flatpak-addons-installed.length > 0: Rectangle {
                            height: 25px;
                            background: Cat.green.with-alpha(0.08);
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                Text {
                                    text: @tr("Already Installed");
                                    font-size: Cat.fs14; font-weight: 700;
                                    color: Cat.green; vertical-alignment: center;
                                    letter-spacing: 0.5px;
                                }
                            }
                        }

                        for inst[ii] in flatpak-addons-installed: Rectangle {
                            height: 56px;
                            border-radius: 6px;
                            animate background { duration: 60ms; }
                            background: inst-row-ta.has-hover ? Cat.red.with-alpha(0.06) : transparent;

                            inst-row-ta := TouchArea { mouse-cursor: pointer; }

                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 18px; height: 18px; border-radius: 9px;
                                        background: Cat.green.with-alpha(0.15);
                                        NavIcon {
                                            d: "M20 6L9 17l-5-5"; icon-color: Cat.green;
                                            width: 10px; height: 10px; x: 4px; y: 4px;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 3px; alignment: center;
                                    Text {
                                        text: inst.display-name;
                                        font-size: Cat.fs14; font-weight: 600; color: Cat.subtext1; overflow: elide;
                                    }
                                    Text {
                                        text: inst.description;
                                        font-size: Cat.fs15; color: Cat.overlay0; overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 64px; height: 26px; border-radius: 6px;
                                        background: rem-ta.has-hover ? Cat.red.with-alpha(0.25) : Cat.red.with-alpha(0.12);
                                        border-width: 1px; border-color: Cat.red.with-alpha(0.3);
                                        animate background { duration: 60ms; }
                                        Text {
                                            text: @tr("Remove");
                                            font-size: Cat.fs11; font-weight: 600; color: Cat.red;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                        rem-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.remove-addon(inst.name);
                                                root.show-addons-modal = false;
                                            }
                                        }
                                    }
                                }
                            }

                            if ii < flatpak-addons-installed.length - 1: Rectangle {
                                x: 10px; y: parent.height - 1px;
                                width: parent.width - 20px; height: 1px;
                                background: Cat.surface0; opacity: 0.6;
                            }
                        }
                    }
                }

                Rectangle { height: 16px; }

                HorizontalLayout {
                    alignment: end; spacing: 8px;

                    Rectangle {
                        width: 80px; height: 31px; border-radius: 8px;
                        background: close-btn-t.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.6);
                        animate background { duration: 60ms; }
                        Text { text: @tr("Close"); font-size: Cat.fs13; font-weight: 500; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                        close-btn-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-addons-modal = false; root.addon-select-all(false); }
                        }
                    }

                    if addon-selected-count > 0: Rectangle {
                        width: inst-sel-lbl.preferred-width + 28px; height: 31px; border-radius: 8px;
                        background: inst-sel-t.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85);
                        animate background { duration: 60ms; }
                        inst-sel-lbl := Text {
                            text: @tr("Install {0} Add-On | Install {0} Add-Ons", addon-selected-count);
                            font-size: Cat.fs13; font-weight: 600; color: Cat.crust;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        inst-sel-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.install-selected-addons();
                                root.show-addons-modal = false;
                                root.addon-select-all(false);
                            }
                        }
                    }
                }
            }
        }
    }

    if show-local-install: Rectangle {
        width: 100%;
        height: 100%;
        background: Cat.crust.with-alpha(0.7);

        TouchArea { clicked => { root.cancel-local-install(); } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 300px;
            background: Cat.base;
            border-radius: 12px;
            border-width: 1px;
            border-color: Cat.surface0;
            drop-shadow-blur: 30px;
            drop-shadow-color: Cat.crust.with-alpha(0.6);
            drop-shadow-offset-y: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    NavIcon {
                        d: icon-package;
                        icon-color: Cat.mauve;
                        width: 24px;
                        height: 24px;
                    }
                    Text {
                        text: @tr("Install Local Package");
                        font-size: Cat.fs17;
                        font-weight: 600;
                        color: Cat.text;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Cat.divider; }

                VerticalLayout {
                    spacing: 8px;
                    DetailProperty { prop-label: @tr("Name"); prop-value: local-package.display-name != "" ? local-package.display-name : "Unknown"; }
                    DetailProperty { prop-label: @tr("Version"); prop-value: local-package.version; }
                    DetailProperty { prop-label: @tr("Size"); prop-value: local-package.installed-size; }
                    DetailProperty { prop-label: @tr("File"); prop-value: local-package-path; }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Btn {
                        label: @tr("Cancel");
                        clicked => { root.cancel-local-install(); }
                    }

                    Btn {
                        label: @tr("Install");
                        primary: true;
                        enabled: !busy;
                        clicked => { root.install-local-package(local-package-path); }
                    }
                }
            }
        }
    }

    if show-progress-popup: ProgressDialog {
        width: 100%;
        height: 100%;
        title: progress-popup-title;
        stage: progress-popup-stage;
        percent: progress-popup-percent;
        done: progress-popup-done;
        success: progress-popup-success;
        details-open <=> progress-show-details;
        output: progress-popup-output;
        error-summary: progress-error-summary;
        prompt: progress-popup-prompt;
        show-input: progress-popup-show-input;
        show-buttons: progress-popup-show-buttons;
        cancellable: progress-popup-cancellable;
        upgrade: terminal-is-upgrade;
        input-focus-pending <=> progress-input-focus-pending;
        close => { root.close-progress-popup(); }
        cancel => { root.cancel-operation(); }
        send-input(text) => { root.progress-popup-send-input(text); }
        proceed => { root.progress-popup-proceed(); }
        reboot => { root.terminal-reboot(); }
    }

    if fp-confirm-open: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.70);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px; height: fp-dlg-layout.min-height;
            background: Cat.base;
            border-radius: 14px;
            border-width: 1px;
            border-color: Cat.red.with-alpha(0.3);
            drop-shadow-blur: 28px;
            drop-shadow-color: Cat.crust.with-alpha(0.6);
            drop-shadow-offset-y: 8px;

            fp-dlg-layout := VerticalLayout {
                padding: 24px; spacing: 16px;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px; height: 32px; border-radius: 10px;
                            background: Cat.red.with-alpha(0.12);
                            NavIcon { d: "M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"; icon-color: Cat.red; width: 18px; height: 18px; x: 9px; y: 9px; }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1; spacing: 3px;
                        Text { text: @tr("Remove {0}?", fp-confirm-name); font-size: Cat.fs15; font-weight: 700; color: Cat.text; overflow: elide; }
                        Text { text: @tr("This will uninstall the application from your system."); font-size: Cat.fs13; color: Cat.overlay1; }
                    }
                }

                Rectangle {
                    height: 40px; border-radius: 8px;
                    background: Cat.surface0;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text { text: @tr("Also remove leftover user data?"); font-size: Cat.fs13; color: Cat.subtext1; }
                            Text { text: @tr("Saved settings, files, and app data will be deleted."); font-size: Cat.fs14; color: Cat.overlay0; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1; height: 29px; border-radius: 7px;
                        background: fp-cancel-ta.has-hover ? Cat.surface1 : Cat.surface0;
                        animate background { duration: 60ms; }
                        VerticalLayout { alignment: center; Text { text: @tr("Cancel"); font-size: Cat.fs13; font-weight: 600; color: Cat.subtext0; horizontal-alignment: center; } }
                        fp-cancel-ta := TouchArea { mouse-cursor: pointer; clicked => { root.fp-confirm-open = false; } }
                    }

                    Rectangle {
                        horizontal-stretch: 1; height: 29px; border-radius: 7px;
                        background: fp-remonly-ta.has-hover ? Cat.red.with-alpha(0.25) : Cat.red.with-alpha(0.14);
                        animate background { duration: 60ms; }
                        VerticalLayout { alignment: center; Text { text: @tr("Remove Only"); font-size: Cat.fs13; font-weight: 600; color: Cat.red; horizontal-alignment: center; } }
                        fp-remonly-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.fp-confirm-open = false;
                                root.remove-flatpak(root.fp-confirm-id, false);
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1; height: 29px; border-radius: 7px;
                        background: fp-remdata-ta.has-hover ? Cat.red.with-alpha(0.5) : Cat.red.with-alpha(0.3);
                        animate background { duration: 60ms; }
                        VerticalLayout { alignment: center; Text { text: @tr("Remove + Data"); font-size: Cat.fs13; font-weight: 700; color: Cat.red; horizontal-alignment: center; } }
                        fp-remdata-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.fp-confirm-open = false;
                                root.remove-flatpak(root.fp-confirm-id, true);
                            }
                        }
                    }
                }
            }
        }
    }

    if pkg-info-open: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.72);
        TouchArea { clicked => { root.pkg-info-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 620px;
            height: 560px;
            background: Cat.base;
            border-radius: 14px;
            border-width: 1px;
            border-color: Cat.blue.with-alpha(0.25);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.crust.with-alpha(0.65);
            drop-shadow-offset-y: 8px;
            clip: true;

            VerticalLayout {

                Rectangle {
                    height: 68px;
                    background: Cat.mantle;

                    HorizontalLayout {
                        padding-left: 20px; padding-right: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 10px;
                                background: Cat.blue.with-alpha(0.12);
                                NavIcon {
                                    d: "M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 16v-4M12 8h.01";
                                    icon-color: Cat.blue;
                                    width: 18px; height: 18px;
                                    x: 9px; y: 9px;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1; spacing: 3px;
                            Text { text: pkg-info-name; font-size: Cat.fs16; font-weight: 700; color: Cat.text; overflow: elide; }
                            Text { text: pkg-info-subtitle; font-size: Cat.fs13; color: Cat.overlay1; }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px; height: 30px; border-radius: 8px;
                                background: pi-close-ta.has-hover ? Cat.surface1 : transparent;
                                animate background { duration: 60ms; }
                                NavIcon {
                                    d: "M18 6L6 18M6 6l12 12";
                                    icon-color: Cat.overlay1;
                                    width: 14px; height: 14px;
                                    x: 8px; y: 8px;
                                }
                                pi-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pkg-info-open = false; }
                                }
                            }
                        }
                    }

                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Cat.surface0.with-alpha(0.6); }
                }

                if pkg-info-loading: VerticalLayout {
                    vertical-stretch: 1; alignment: center; spacing: 12px;
                    HorizontalLayout { alignment: center; LoadingCircle { diameter: 28px; } }
                    Text { text: @tr("Loading…"); font-size: Cat.fs13; color: Cat.overlay0; horizontal-alignment: center; }
                }

                if !pkg-info-loading: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: pkg-info-files;
                            font-size: Cat.fs13;
                            font-family: "JetBrains Mono";
                            color: Cat.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    if show-orphan-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: Cat.crust.with-alpha(0.75);

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 40px);
            height: min(580px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.red.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 56px;
                    background: Cat.red.with-alpha(0.1);

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Cat.red.with-alpha(0.25);
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                                icon-color: Cat.red;
                                width: 20px;
                                height: 20px;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: @tr("Remove Orphaned Packages");
                                font-size: Cat.fs15;
                                font-weight: 700;
                                color: Cat.text;
                            }
                            Text {
                                text: orphan-list.length + " packages found";
                                font-size: Cat.fs11;
                                color: Cat.subtext0;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: oph-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                oph-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-orphan-dialog = false; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Cat.red.with-alpha(0.07);
                    border-width: 0;

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Cat.red.with-alpha(0.18);
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px; height: 29px; border-radius: 8px;
                                background: Cat.red.with-alpha(0.18);
                                NavIcon {
                                    d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                                    icon-color: Cat.red;
                                    width: 18px; height: 18px; x: 7px; y: 7px;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: @tr("DANGER - Read before proceeding");
                                font-size: Cat.fs15;
                                font-weight: 800;
                                color: Cat.red;
                                letter-spacing: 0.5px;
                            }
                            Text {
                                text: @tr("Orphans are packages no longer required as dependencies. Some may still be needed by manually installed software or config. Removing them can break your system. Review carefully.");
                                font-size: Cat.fs14;
                                color: Cat.subtext0;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: Cat.surface0.with-alpha(0.3);

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Cat.surface1.with-alpha(0.5);
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px; height: 16px; border-radius: 4px;
                                background: all-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                border-width: 1px;
                                border-color: Cat.overlay0;
                                NavIcon {
                                    visible: orphan-selected-count == orphan-list.length && orphan-list.length > 0;
                                    d: "M5 13l4 4L19 7";
                                    icon-color: Cat.red;
                                    width: 10px; height: 10px; x: 3px; y: 3px;
                                }
                                all-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.orphan-select-all(!(orphan-selected-count == orphan-list.length && orphan-list.length > 0));
                                    }
                                }
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Select / Deselect All");
                            font-size: Cat.fs15;
                            color: Cat.subtext0;
                            vertical-alignment: center;
                        }

                        Text {
                            text: orphan-selected-count + " selected";
                            font-size: Cat.fs11;
                            color: Cat.overlay1;
                            vertical-alignment: center;
                        }
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for pkg[i] in orphan-list: Rectangle {
                        height: 47px;
                        background: row-ta.has-hover ? Cat.surface0.with-alpha(0.4) : transparent;
                        animate background { duration: 60ms; }

                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.orphan-toggle(i); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 16px; height: 16px; border-radius: 4px;
                                    background: orphan-checked[i] ? Cat.red.with-alpha(0.2) : Cat.surface0;
                                    border-width: 1px;
                                    border-color: orphan-checked[i] ? Cat.red : Cat.overlay0;
                                    animate background { duration: 60ms; }
                                    NavIcon {
                                        visible: orphan-checked[i];
                                        d: "M5 13l4 4L19 7";
                                        icon-color: Cat.red;
                                        width: 10px; height: 10px; x: 3px; y: 3px;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: pkg.name;
                                    font-size: Cat.fs13;
                                    font-weight: 600;
                                    color: Cat.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: pkg.description;
                                    font-size: Cat.fs14;
                                    color: Cat.subtext0;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: pkg.version;
                                    font-size: Cat.fs10;
                                    color: Cat.overlay1;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: orphan-tag-lbl.preferred-width + 16px;
                                    height: 18px;
                                    border-radius: 5px;
                                    background: tag-ta.has-hover
                                        ? (pkg.explicit ? Cat.mauve.with-alpha(0.3) : Cat.sapphire.with-alpha(0.3))
                                        : (pkg.explicit ? Cat.mauve.with-alpha(0.18) : Cat.sapphire.with-alpha(0.18));
                                    border-width: 1px;
                                    border-color: pkg.explicit ? Cat.mauve.with-alpha(0.4) : Cat.sapphire.with-alpha(0.4);
                                    animate background { duration: 60ms; }
                                    orphan-tag-lbl := Text {
                                        text: pkg.explicit ? @tr("Explicit") : @tr("Dep");
                                        font-size: Cat.fs9;
                                        font-weight: 600;
                                        color: pkg.explicit ? Cat.mauve : Cat.sapphire;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    tag-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            orphan-dep-info-title = pkg.name;
                                            orphan-dep-info-text = "Loading...";
                                            show-orphan-dep-info = true;
                                            root.load-orphan-dep-info(pkg.name);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 32px;
                            height: 1px;
                            background: Cat.surface0;
                            opacity: 0.4;
                        }
                    }
                }

                if show-orphan-dep-info: Rectangle {
                    height: 80px;
                    background: Cat.surface0.with-alpha(0.5);
                    border-width: 1px;
                    border-color: Cat.sapphire.with-alpha(0.3);

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: orphan-dep-info-title + " - required by:";
                                font-size: Cat.fs11;
                                font-weight: 700;
                                color: Cat.sapphire;
                            }
                            Text {
                                text: orphan-dep-info-text;
                                font-size: Cat.fs11;
                                color: Cat.subtext0;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 22px; height: 22px; border-radius: 6px;
                                background: di-close.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 10px; height: 10px; x: 6px; y: 6px; }
                                di-close := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { show-orphan-dep-info = false; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 60px;
                    background: Cat.surface0.with-alpha(0.3);

                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 1px;
                        background: Cat.surface1.with-alpha(0.5);
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: end;

                        Rectangle {
                            width: 88px; height: 32px; border-radius: 8px;
                            background: oph-cancel-ta.has-hover ? Cat.surface1 : Cat.surface0;
                            animate background { duration: 80ms; }
                            Text {
                                text: @tr("Cancel");
                                font-size: Cat.fs13;
                                font-weight: 600;
                                color: Cat.subtext0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            oph-cancel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-orphan-dialog = false; }
                            }
                        }

                        Rectangle {
                            width: 150px; height: 32px; border-radius: 8px;
                            background: orphan-selected-count == 0 ? Cat.red.with-alpha(0.3) :
                                (oph-rm-ta.has-hover ? Cat.red : Cat.red.with-alpha(0.85));
                            animate background { duration: 80ms; }
                            Text {
                                text: @tr("Remove Selected");
                                font-size: Cat.fs13;
                                font-weight: 700;
                                color: Cat.crust;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            oph-rm-ta := TouchArea {
                                mouse-cursor: orphan-selected-count > 0 ? pointer : default;
                                clicked => {
                                    if orphan-selected-count > 0 {
                                        root.show-orphan-dialog = false;
                                        root.remove-selected-orphans();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-unlock-db-confirm: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, parent.width - 40px);
            height: 240px;
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.red.with-alpha(0.4);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.crust.with-alpha(0.7);
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                spacing: 0;
                Rectangle {
                    height: 47px;
                    background: Cat.red.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.red.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            NavIcon { d: icon-lock; icon-color: Cat.red; width: 20px; height: 20px; }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Unlock Pacman Database");
                            font-size: Cat.fs15; font-weight: 700; color: Cat.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: ulk-cl.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                ulk-cl := TouchArea { mouse-cursor: pointer; clicked => { root.show-unlock-db-confirm = false; } }
                            }
                        }
                    }
                }
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    padding-left: 24px; padding-right: 24px;
                    spacing: 10px;
                    Text {
                        text: @tr("Only do this if pacman is NOT running. Removing the lock while pacman is active will corrupt your database.");
                        font-size: Cat.fs12; color: Cat.subtext0;
                        wrap: word-wrap; horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 30px; border-radius: 6px;
                        background: Cat.red.with-alpha(0.08);
                        border-width: 1px; border-color: Cat.red.with-alpha(0.25);
                        Text {
                            text: "$ rm /var/lib/pacman/db.lck";
                            font-size: Cat.fs11; color: Cat.red.with-alpha(0.8);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    background: Cat.surface0.with-alpha(0.3);
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.surface1.with-alpha(0.5); }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: end;
                        Rectangle {
                            width: 88px; height: 32px; border-radius: 8px;
                            background: ulk-cancel.has-hover ? Cat.surface1 : Cat.surface0;
                            animate background { duration: 80ms; }
                            Text { text: @tr("Cancel"); font-size: Cat.fs13; font-weight: 600; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                            ulk-cancel := TouchArea { mouse-cursor: pointer; clicked => { root.show-unlock-db-confirm = false; } }
                        }
                        Rectangle {
                            width: 130px; height: 32px; border-radius: 8px;
                            background: ulk-confirm.has-hover ? Cat.red : Cat.red.with-alpha(0.85);
                            animate background { duration: 80ms; }
                            Text { text: @tr("Unlock DB"); font-size: Cat.fs13; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                            ulk-confirm := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-unlock-db-confirm = false;
                                    root.unlock-db();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-conflict-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: Cat.crust.with-alpha(0.72);

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(540px, parent.width - 40px);
            height: min(420px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.yellow.with-alpha(0.35);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.crust.with-alpha(0.7);
            drop-shadow-offset-y: 10px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 47px;
                    background: Cat.yellow.with-alpha(0.08);

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Cat.yellow.with-alpha(0.25);
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01";
                                icon-color: Cat.yellow;
                                width: 20px;
                                height: 20px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: @tr("Conflict Detected");
                                font-size: Cat.fs16;
                                font-weight: 700;
                                color: Cat.text;
                            }

                            Text {
                                text: conflict-can-force ? "File already exists in filesystem" : "Package dependency conflict";
                                font-size: Cat.fs15;
                                color: Cat.yellow;
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Cat.crust;

                    ScrollView {
                        VerticalLayout {
                            padding: 14px;

                            Text {
                                text: conflict-summary;
                                font-size: Cat.fs12;
                                font-family: "monospace";
                                color: Cat.text;
                                opacity: 0.85;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: conflict-can-force ? Cat.yellow.with-alpha(0.06) : Cat.red.with-alpha(0.06);

                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }

                    Text {
                        x: 18px;
                        width: parent.width - 36px;
                        height: parent.height;
                        text: conflict-can-force
                            ? "Force overwrite will replace the conflicting files. Use with caution."
                            : "This conflict requires manual resolution. Remove the conflicting package first.";
                        font-size: Cat.fs11;
                        color: conflict-can-force ? Cat.yellow : Cat.red;
                        opacity: 0.8;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: 47px;
                    background: Cat.mantle;

                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: end;

                        Rectangle {
                            width: cancel-conf-label.preferred-width + 24px;
                            height: 30px;
                            border-radius: 7px;
                            background: cancel-conf-touch.has-hover ? Cat.surface1 : Cat.surface0;
                            animate background { duration: 80ms; }

                            cancel-conf-label := Text {
                                text: @tr("Cancel");
                                font-size: Cat.fs13;
                                font-weight: 500;
                                color: Cat.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-conf-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.conflict-cancel(); }
                            }
                        }

                        if conflict-can-force: Rectangle {
                            width: force-label.preferred-width + 24px;
                            height: 30px;
                            border-radius: 7px;
                            background: force-touch.has-hover ? Cat.yellow : Cat.yellow.with-alpha(0.85);
                            animate background { duration: 80ms; }

                            force-label := Text {
                                text: @tr("Force Overwrite");
                                font-size: Cat.fs13;
                                font-weight: 700;
                                color: Cat.crust;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            force-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.conflict-force-overwrite(); }
                            }
                        }
                    }
                }
            }
        }
    }


    if show-distro-warning: Rectangle {
        width: 100%; height: 100%;
        background: #000000.with-alpha(0.72);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(500px, parent.width - 48px);
            height: layout.min-height;
            border-radius: 14px;
            background: #1a0a0a;
            border-width: 2px;
            border-color: Cat.red.with-alpha(0.7);
            drop-shadow-blur: 40px;
            drop-shadow-color: Cat.red.with-alpha(0.35);
            drop-shadow-offset-y: 8px;

            layout := VerticalLayout {
                padding: 28px;
                spacing: 20px;
                property <bool> never-show-checked: false;

                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: @linear-gradient(90deg, Cat.red, Cat.red.with-alpha(0.3));
                }

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        NavIcon {
                            d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                            icon-color: Cat.red;
                            width: 28px; height: 28px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: @tr("⚠  UNSUPPORTED DISTRIBUTION");
                            font-size: Cat.fs16; font-weight: 800;
                            color: Cat.red;
                            letter-spacing: 0.5px;
                        }
                        Text {
                            text: @tr("xPackageManager is built exclusively for XeroLinux");
                            font-size: Cat.fs11; font-weight: 400;
                            color: #aa7777;
                        }
                    }
                }

                Rectangle { height: 1px; background: Cat.red.with-alpha(0.2); }

                Text {
                    text: @tr("This application was built specifically for XeroLinux.\n\nUsing it on any other Arch-based distribution is entirely at your own risk. No support, warranty, or guarantees of any kind are provided. \n\nFunctionality may be incomplete or incorrect on unsupported systems.");
                    font-size: Cat.fs14;
                    color: #e8c8c8;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Cat.red.with-alpha(0.2); }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 18px;
                                    border-radius: 4px;
                                    border-width: 1.5px;
                                    border-color: layout.never-show-checked ? Cat.red.with-alpha(0.8) : Cat.red.with-alpha(0.35);
                                    background: layout.never-show-checked ? Cat.red.with-alpha(0.18) : transparent;
                                    animate background { duration: 60ms; }

                                    if layout.never-show-checked: NavIcon {
                                        d: "M5 12l4 4L19 7";
                                        icon-color: Cat.red;
                                        width: 12px; height: 12px;
                                        x: (parent.width - 12px) / 2;
                                        y: (parent.height - 12px) / 2;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { layout.never-show-checked = !layout.never-show-checked; }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Don't show this again");
                                    font-size: Cat.fs13;
                                    color: #aa7777;
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: src-lbl.preferred-width + 28px;
                        height: 36px;
                        border-radius: 8px;
                        background: src-ta.has-hover ? Cat.blue.with-alpha(0.22) : Cat.blue.with-alpha(0.1);
                        border-width: 1px;
                        border-color: Cat.blue.with-alpha(0.4);
                        animate background { duration: 60ms; }
                        src-lbl := Text {
                            text: @tr("View Source");
                            font-size: Cat.fs13; font-weight: 600;
                            color: Cat.blue;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        src-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://github.com/xerolinux/xPackageManager"); }
                        }
                    }

                    Rectangle {
                        width: ack-lbl.preferred-width + 28px;
                        height: 36px;
                        border-radius: 8px;
                        background: ack-ta.has-hover ? Cat.red.with-alpha(0.35) : Cat.red.with-alpha(0.18);
                        border-width: 1px;
                        border-color: Cat.red.with-alpha(0.55);
                        animate background { duration: 60ms; }
                        ack-lbl := Text {
                            text: @tr("I Understand, Proceed");
                            font-size: Cat.fs13; font-weight: 700;
                            color: Cat.red;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ack-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if layout.never-show-checked {
                                    root.distro-warning-dismissed = true;
                                    root.distro-warning-dismiss();
                                }
                                root.show-distro-warning = false;
                            }
                        }
                    }
                }
            }
        }
    }

    if show-repo-enable-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(540px, parent.width - 40px);
            height: min(580px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.green.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 56px;
                    background: Cat.green.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.green.with-alpha(0.25); }

                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: "M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11";
                                icon-color: Cat.green; width: 20px; height: 20px;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Enable / Disable Repositories"); font-size: Cat.fs15; font-weight: 700; color: Cat.text; }
                            Text { text: repo-mgr-list.length + " repositories"; font-size: Cat.fs11; color: Cat.subtext0; }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: ren-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                ren-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-repo-enable-modal = false; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Cat.blue.with-alpha(0.06);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.divider; }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                        VerticalLayout { alignment: center; padding-top: 1px;
                            NavIcon {
                                d: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z";
                                icon-color: Cat.blue; width: 14px; height: 14px;
                            }
                        }
                        Text {
                            text: @tr("After applying changes, run 'sudo pacman -Sy' to sync the updated repo list.");
                            font-size: Cat.fs11; color: Cat.blue.with-alpha(0.85);
                            vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                        }
                    }
                }

                if repo-mgr-loading: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout { alignment: center; LoadingCircle { diameter: 32px; } }
                    }
                }

                if !repo-mgr-loading: ListView {
                    vertical-stretch: 1;

                    for repo[i] in repo-mgr-list: Rectangle {
                        height: 52px;
                        background: ren-row-ta.has-hover ? Cat.surface0.with-alpha(0.5) : transparent;
                        animate background { duration: 60ms; }

                        ren-row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.repo-mgr-toggle(i); }
                        }

                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 18px; border-radius: 5px;
                                    background: repo-mgr-enabled[i] ? Cat.green.with-alpha(0.2) : Cat.surface0;
                                    border-width: 1px;
                                    border-color: repo-mgr-enabled[i] ? Cat.green : Cat.overlay0;
                                    animate background { duration: 60ms; }
                                    NavIcon {
                                        visible: repo-mgr-enabled[i];
                                        d: "M5 13l4 4L19 7";
                                        icon-color: Cat.green;
                                        width: 11px; height: 11px; x: 3.5px; y: 3.5px;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: repo.name; font-size: Cat.fs13; font-weight: 600; color: Cat.text; overflow: elide; }
                                Text { text: repo.server; font-size: Cat.fs11; color: Cat.subtext0; overflow: elide; }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 20px; border-radius: 5px;
                                    background: repo-mgr-enabled[i] ? Cat.green.with-alpha(0.18) : Cat.surface1;
                                    border-width: 1px;
                                    border-color: repo-mgr-enabled[i] ? Cat.green.with-alpha(0.4) : Cat.overlay0.with-alpha(0.3);
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        VerticalLayout { alignment: center;
                                            Text {
                                                text: repo-mgr-enabled[i] ? @tr("Enabled") : @tr("Disabled");
                                                font-size: Cat.fs9; font-weight: 600;
                                                color: repo-mgr-enabled[i] ? Cat.green : Cat.overlay1;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            x: 16px; y: parent.height - 1px;
                            width: parent.width - 32px; height: 1px;
                            background: Cat.surface0; opacity: 0.4;
                        }
                    }
                }

                Rectangle {
                    height: 60px; background: Cat.mantle;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 0; padding-bottom: 0;
                        spacing: 8px; alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 90px; height: 34px; border-radius: 8px;
                                background: ren-cancel-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                animate background { duration: 80ms; }
                                Text { text: @tr("Cancel"); font-size: Cat.fs13; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                ren-cancel-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-repo-enable-modal = false; }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 130px; height: 34px; border-radius: 8px;
                                background: ren-apply-ta.has-hover ? Cat.green.with-alpha(0.28) : Cat.green.with-alpha(0.18);
                                border-width: 1px; border-color: Cat.green.with-alpha(0.5);
                                animate background { duration: 80ms; }
                                Text { text: @tr("Apply Changes"); font-size: Cat.fs13; font-weight: 700; color: Cat.green; horizontal-alignment: center; vertical-alignment: center; }
                                ren-apply-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.repo-apply-changes();
                                        root.show-repo-enable-modal = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-repo-manage-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 40px);
            height: min(640px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.blue.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 56px;
                    background: Cat.blue.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.blue.with-alpha(0.25); }

                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            NavIcon { d: "M12 5v14M5 12h14"; icon-color: Cat.blue; width: 20px; height: 20px; }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Add / Remove Repositories"); font-size: Cat.fs15; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Changes are written directly to /etc/pacman.conf"); font-size: Cat.fs11; color: Cat.subtext0; }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: rm2-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                rm2-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-repo-manage-modal = false;
                                        root.show-repo-delete-confirm = false;
                                        root.repo-delete-target = "";
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Cat.red.with-alpha(0.07);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.red.with-alpha(0.18); }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                        VerticalLayout { alignment: center;
                            NavIcon {
                                d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                                icon-color: Cat.red; width: 14px; height: 14px;
                            }
                        }
                        Text {
                            text: @tr("Removing a repo permanently deletes its section from /etc/pacman.conf and cannot be undone. NOT intended for repos that use separate keyrings or mirrorlists - use 'Edit pacman.conf' for those.");
                            font-size: Cat.fs11; color: Cat.red.with-alpha(0.9);
                            vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                        }
                    }
                }

                if show-repo-delete-confirm: Rectangle {
                    height: 48px;
                    background: Cat.red.with-alpha(0.12);
                    border-width: 1px; border-color: Cat.red.with-alpha(0.35);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.red.with-alpha(0.25); }

                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("Delete '{0}'? This cannot be undone.", repo-delete-target);
                                font-size: Cat.fs12; font-weight: 600; color: Cat.red;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 65px; height: 28px; border-radius: 6px;
                                background: rdel-no-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                animate background { duration: 60ms; }
                                Text { text: @tr("Cancel"); font-size: Cat.fs11; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                rdel-no-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-repo-delete-confirm = false;
                                        root.repo-delete-target = "";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 65px; height: 28px; border-radius: 6px;
                                background: rdel-yes-ta.has-hover ? Cat.red.with-alpha(0.5) : Cat.red.with-alpha(0.3);
                                border-width: 1px; border-color: Cat.red.with-alpha(0.6);
                                animate background { duration: 60ms; }
                                Text { text: @tr("Delete"); font-size: Cat.fs11; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                rdel-yes-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.repo-remove(root.repo-delete-target);
                                        root.show-repo-delete-confirm = false;
                                        root.repo-delete-target = "";
                                    }
                                }
                            }
                        }
                    }
                }

                if repo-mgr-loading: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout { alignment: center; LoadingCircle { diameter: 32px; } }
                    }
                }

                if !repo-mgr-loading: ListView {
                    height: min(repo-mgr-list.length * 52px, 280px);

                    for repo[i] in repo-mgr-list: Rectangle {
                        height: 52px;
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: repo.name; font-size: Cat.fs13; font-weight: 600; color: Cat.text; overflow: elide; }
                                Text { text: repo.server; font-size: Cat.fs11; color: Cat.subtext0; overflow: elide; }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 20px; border-radius: 5px;
                                    background: repo-mgr-enabled[i] ? Cat.green.with-alpha(0.18) : Cat.surface1;
                                    border-width: 1px;
                                    border-color: repo-mgr-enabled[i] ? Cat.green.with-alpha(0.4) : Cat.overlay0.with-alpha(0.3);
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        VerticalLayout { alignment: center;
                                            Text {
                                                text: repo-mgr-enabled[i] ? @tr("Enabled") : @tr("Disabled");
                                                font-size: Cat.fs9; font-weight: 600;
                                                color: repo-mgr-enabled[i] ? Cat.green : Cat.overlay1;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 62px; height: 26px; border-radius: 6px;
                                    background: rm2-del-ta.has-hover ? Cat.red.with-alpha(0.28) : Cat.red.with-alpha(0.12);
                                    border-width: 1px; border-color: Cat.red.with-alpha(0.4);
                                    animate background { duration: 60ms; }
                                    Text { text: @tr("Remove"); font-size: Cat.fs10; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                    rm2-del-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.repo-delete-target = repo.name;
                                            root.show-repo-delete-confirm = true;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            x: 16px; y: parent.height - 1px;
                            width: parent.width - 32px; height: 1px;
                            background: Cat.surface0; opacity: 0.4;
                        }
                    }
                }

                Rectangle {
                    background: Cat.surface0.with-alpha(0.3);
                    border-width: 1px; border-color: Cat.surface1;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }

                    VerticalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 10px; padding-bottom: 10px;
                        spacing: 7px;

                        Text { text: @tr("Add New Repository"); font-size: Cat.fs12; font-weight: 700; color: Cat.subtext0; }

                        HorizontalLayout {
                            spacing: 6px;

                            Rectangle {
                                width: 150px; height: 30px; border-radius: 6px;
                                background: Cat.surface1; clip: true;
                                border-width: 1px;
                                border-color: add-name-ti.has-focus ? Cat.blue.with-alpha(0.6) : transparent;
                                add-name-ti := TextInput {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text <=> root.new-repo-name-text;
                                    font-size: Cat.fs12; color: Cat.text;
                                    single-line: true; vertical-alignment: center;
                                }
                                if new-repo-name-text == "" && !add-name-ti.has-focus: Text {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text: @tr("Name (e.g. myrepo)");
                                    font-size: Cat.fs11; color: Cat.overlay0; vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1; height: 30px; border-radius: 6px;
                                background: Cat.surface1; clip: true;
                                border-width: 1px;
                                border-color: add-srv-ti.has-focus ? Cat.blue.with-alpha(0.6) : transparent;
                                add-srv-ti := TextInput {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text <=> root.new-repo-server-text;
                                    font-size: Cat.fs12; color: Cat.text;
                                    single-line: true; vertical-alignment: center;
                                }
                                if new-repo-server-text == "" && !add-srv-ti.has-focus: Text {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text: @tr("Server URL or /etc/pacman.d/mirrorfile");
                                    font-size: Cat.fs11; color: Cat.overlay0; vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center; width: 70px;
                                Text {
                                    text: @tr("SigLevel =");
                                    font-size: Cat.fs11; color: Cat.overlay1;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1; height: 30px; border-radius: 6px;
                                background: Cat.surface1; clip: true;
                                border-width: 1px;
                                border-color: add-sig-ti.has-focus ? Cat.blue.with-alpha(0.6) : transparent;
                                add-sig-ti := TextInput {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text <=> root.new-repo-siglevel-text;
                                    font-size: Cat.fs12; color: Cat.text;
                                    single-line: true; vertical-alignment: center;
                                }
                                if new-repo-siglevel-text == "" && !add-sig-ti.has-focus: Text {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text: @tr("Optional (e.g. Required DatabaseOptional)");
                                    font-size: Cat.fs11; color: Cat.overlay0; vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 52px; height: 30px; border-radius: 6px;
                                background: add-repo-ta.has-hover ? Cat.blue.with-alpha(0.35) : Cat.blue.with-alpha(0.2);
                                border-width: 1px; border-color: Cat.blue.with-alpha(0.5);
                                animate background { duration: 80ms; }
                                Text { text: @tr("Add"); font-size: Cat.fs12; font-weight: 700; color: Cat.blue; horizontal-alignment: center; vertical-alignment: center; }
                                add-repo-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.new-repo-name-text != "" && root.new-repo-server-text != "" {
                                            root.repo-add(root.new-repo-name-text, root.new-repo-server-text, root.new-repo-siglevel-text);
                                            root.new-repo-name-text = "";
                                            root.new-repo-server-text = "";
                                            root.new-repo-siglevel-text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 52px; background: Cat.mantle;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 8px; alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px; height: 32px; border-radius: 8px;
                                background: rm2-done-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                animate background { duration: 80ms; }
                                Text { text: @tr("Done"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; horizontal-alignment: center; vertical-alignment: center; }
                                rm2-done-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-repo-manage-modal = false;
                                        root.show-repo-delete-confirm = false;
                                        root.repo-delete-target = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-pacman-opts-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.65);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 40px);
            height: opts-card-layout.preferred-height;
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.teal.with-alpha(0.35);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.teal.with-alpha(0.15);
            drop-shadow-offset-y: 8px;

            opts-card-layout := VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Cat.teal.with-alpha(0.12);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.teal.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: start;
                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: "M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z";
                                icon-color: Cat.teal; width: 18px; height: 18px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("pacman.conf Options"); font-size: Cat.fs14; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Toggle pacman behaviour flags"); font-size: Cat.fs11; color: Cat.subtext0; }
                        }
                    }
                }

                VerticalLayout {
                    padding-left: 16px; padding-right: 16px;
                    padding-top: 8px; padding-bottom: 4px;
                    spacing: 0px;

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("Color"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Colorize pacman output in terminal"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-color-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-color = !root.opt-color; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-color ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-color ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("ILoveCandy"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Pac-Man progress bar easter egg"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-candy-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-love-candy = !root.opt-love-candy; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-love-candy ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-love-candy ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("VerbosePkgLists"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Show old and new versions in package lists"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-verbose-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-verbose-pkg-lists = !root.opt-verbose-pkg-lists; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-verbose-pkg-lists ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-verbose-pkg-lists ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("DisableDownloadTimeout"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("No timeout on slow mirrors"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-timeout-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-disable-dl-timeout = !root.opt-disable-dl-timeout; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-disable-dl-timeout ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-disable-dl-timeout ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("CheckSpace"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Verify disk space before installing (recommended)"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-checksp-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-check-space = !root.opt-check-space; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-check-space ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-check-space ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("DisableSandbox"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Disable download sandbox (use if having issues)"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-sandbox-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-disable-sandbox = !root.opt-disable-sandbox; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-disable-sandbox ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-disable-sandbox ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.surface0.with-alpha(0.5); }
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("NoProgressBar"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Suppress progress bar in terminal output"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-nopbar-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-no-progress-bar = !root.opt-no-progress-bar; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-no-progress-bar ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-no-progress-bar ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px; background: transparent;
                        HorizontalLayout {
                            alignment: stretch; spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: @tr("UseSyslog"); font-size: Cat.fs13; font-weight: 600; color: Cat.text; }
                                Text { text: @tr("Log pacman operations to syslog"); font-size: Cat.fs11; color: Cat.subtext0; }
                            }
                            VerticalLayout {
                                alignment: center;
                                opt-syslog-ta := TouchArea {
                                    width: 44px; height: 24px; mouse-cursor: pointer;
                                    clicked => { root.opt-use-syslog = !root.opt-use-syslog; }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: root.opt-use-syslog ? Cat.teal.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 120ms; }
                                        Rectangle {
                                            x: root.opt-use-syslog ? parent.width - self.width - 3px : 3px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: white;
                                            animate x { duration: 120ms; easing: ease-in-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Cat.surface0.with-alpha(0.3);
                    border-width: 1px; border-color: Cat.surface1;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }
                    VerticalLayout {
                        padding: 12px; spacing: 8px;
                        Text { text: @tr("CleanMethod"); font-size: Cat.fs12; font-weight: 700; color: Cat.subtext0; }
                        Text { text: @tr("Which cached packages to keep when cleaning cache"); font-size: Cat.fs11; color: Cat.overlay1; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 32px; horizontal-stretch: 1; border-radius: 7px;
                                background: opt-clean-method == 0 ? Cat.teal.with-alpha(0.22) : Cat.surface1;
                                border-width: 1px;
                                border-color: opt-clean-method == 0 ? Cat.teal.with-alpha(0.6) : Cat.surface2;
                                animate background { duration: 100ms; }
                                Text { text: @tr("KeepInstalled"); font-size: Cat.fs12; font-weight: 600; color: opt-clean-method == 0 ? Cat.teal : Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.opt-clean-method = 0; } }
                            }
                            Rectangle {
                                height: 32px; horizontal-stretch: 1; border-radius: 7px;
                                background: opt-clean-method == 1 ? Cat.teal.with-alpha(0.22) : Cat.surface1;
                                border-width: 1px;
                                border-color: opt-clean-method == 1 ? Cat.teal.with-alpha(0.6) : Cat.surface2;
                                animate background { duration: 100ms; }
                                Text { text: @tr("KeepCurrent"); font-size: Cat.fs12; font-weight: 600; color: opt-clean-method == 1 ? Cat.teal : Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.opt-clean-method = 1; } }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 56px; background: Cat.mantle;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 8px; alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px; height: 32px; border-radius: 8px;
                                background: opts-cancel-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                animate background { duration: 80ms; }
                                Text { text: @tr("Cancel"); font-size: Cat.fs13; font-weight: 600; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                opts-cancel-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-pacman-opts-modal = false;
                                        root.load-pacman-opts();
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 100px; height: 32px; border-radius: 8px;
                                background: opts-apply-ta.has-hover ? Cat.teal.with-alpha(0.85) : Cat.teal.with-alpha(0.7);
                                animate background { duration: 80ms; }
                                Text { text: @tr("Apply"); font-size: Cat.fs13; font-weight: 700; color: Cat.base; horizontal-alignment: center; vertical-alignment: center; }
                                opts-apply-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.save-pacman-opts();
                                        root.show-pacman-opts-modal = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-pd-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.65);
        TouchArea { clicked => { root.show-pd-modal = false; } }

        pd-card-area := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(460px, parent.width - 40px);
            height: pd-card.preferred-height;
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.mauve.with-alpha(0.35);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.mauve.with-alpha(0.15);
            drop-shadow-offset-y: 8px;

            TouchArea {}

            property <bool> is-preset: setting-parallel-downloads == 5
                || setting-parallel-downloads == 10
                || setting-parallel-downloads == 15
                || setting-parallel-downloads == 20
                || setting-parallel-downloads == 25;

            pd-card := VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Cat.mauve.with-alpha(0.12);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.mauve.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: start;
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Parallel Downloads"); font-size: Cat.fs14; font-weight: 700; color: Cat.text; }
                            Text {
                                text: @tr("Current: {0}", setting-parallel-downloads) + (pd-card-area.is-preset ? "" : "  (Custom)");
                                font-size: Cat.fs11; color: pd-card-area.is-preset ? Cat.subtext0 : Cat.peach;
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for opt[i] in [5, 10, 15, 20, 25]: Rectangle {
                            width: 44px; height: 34px; border-radius: 6px;
                            background: (setting-parallel-downloads == opt && pd-card-area.is-preset) ?
                                Cat.mauve : (pdm-touch.has-hover ? Cat.surface1 : Cat.surface0);
                            animate background { duration: 80ms; }
                            Text {
                                text: opt;
                                font-size: Cat.fs15;
                                font-weight: (setting-parallel-downloads == opt && pd-card-area.is-preset) ? 700 : 400;
                                color: (setting-parallel-downloads == opt && pd-card-area.is-preset) ? Cat.crust : Cat.subtext0;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            pdm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    setting-parallel-downloads = opt;
                                    setting-pd-custom-mode = false;
                                    setting-pd-custom-text = "";
                                    root.save-settings();
                                    root.set-parallel-downloads(opt);
                                }
                            }
                        }
                        Rectangle {
                            width: pdm-custom-lbl.preferred-width + 20px; height: 34px; border-radius: 6px;
                            background: setting-pd-custom-mode ?
                                Cat.peach : (pdm-custom-ta.has-hover ? Cat.surface1 : Cat.surface0);
                            animate background { duration: 80ms; }
                            pdm-custom-lbl := Text {
                                text: @tr("Custom");
                                font-size: Cat.fs15;
                                font-weight: setting-pd-custom-mode ? 700 : 400;
                                color: setting-pd-custom-mode ? Cat.crust : Cat.subtext0;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            pdm-custom-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { setting-pd-custom-mode = !setting-pd-custom-mode; }
                            }
                        }
                    }

                    if setting-pd-custom-mode: HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 32px; border-radius: 6px;
                            background: Cat.surface1;
                            border-width: pdm-input.has-focus ? 1px : 0px;
                            border-color: Cat.peach.with-alpha(0.5);
                            clip: true;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                if setting-pd-custom-text == "" && !pdm-input.has-focus: Text {
                                    height: 32px; text: @tr("Enter number (e.g. 8)");
                                    font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center;
                                }
                                pdm-input := TextInput {
                                    height: 32px;
                                    text <=> setting-pd-custom-text;
                                    font-size: Cat.fs13; color: Cat.text; single-line: true; vertical-alignment: center;
                                    accepted => {
                                        if setting-pd-custom-text != "" {
                                            setting-parallel-downloads = setting-pd-custom-text.to-float();
                                            root.save-settings();
                                            root.set-parallel-downloads(setting-parallel-downloads);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            width: pdm-apply-lbl.preferred-width + 24px; height: 32px; border-radius: 6px;
                            background: pdm-apply-ta.has-hover ? Cat.peach.with-alpha(0.85) : Cat.peach;
                            animate background { duration: 80ms; }
                            pdm-apply-lbl := Text { text: @tr("Apply"); font-size: Cat.fs15; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                            pdm-apply-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if setting-pd-custom-text != "" {
                                        setting-parallel-downloads = setting-pd-custom-text.to-float();
                                        root.save-settings();
                                        root.set-parallel-downloads(setting-parallel-downloads);
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px; border-radius: 6px;
                            background: Cat.peach.with-alpha(0.08);
                            border-width: 1px; border-color: Cat.peach.with-alpha(0.3);
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 8px;
                                VerticalLayout { alignment: center;
                                    NavIcon { d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"; icon-color: Cat.peach; width: 14px; height: 14px; }
                                }
                                Text {
                                    text: @tr("Above 25 can overload mirrors, use at own risk.");
                                    font-size: Cat.fs11; color: Cat.peach; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 56px; background: Cat.mantle;
                    Rectangle { y: 0; width: 100%; height: 1px; background: Cat.divider; }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; alignment: end;
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 90px; height: 32px; border-radius: 8px;
                                background: pdm-done-ta.has-hover ? Cat.mauve.with-alpha(0.85) : Cat.mauve.with-alpha(0.7);
                                animate background { duration: 80ms; }
                                Text { text: @tr("Done"); font-size: Cat.fs13; font-weight: 700; color: Cat.base; horizontal-alignment: center; vertical-alignment: center; }
                                pdm-done-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-pd-modal = false; } }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-warning-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: Cat.crust.with-alpha(0.65);

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 40px);
            height: warn-layout.preferred-height + 32px;
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.yellow.with-alpha(0.35);
            drop-shadow-blur: 32px;
            drop-shadow-color: Cat.yellow.with-alpha(0.18);
            drop-shadow-offset-y: 8px;

            warn-layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        NavIcon {
                            d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z";
                            icon-color: Cat.yellow;
                            width: 20px;
                            height: 20px;
                        }
                    }
                    Text {
                        text: @tr("Package Required");
                        font-size: Cat.fs16;
                        font-weight: 700;
                        color: Cat.yellow;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-warn-ta.has-hover ? Cat.surface1 : transparent;
                        animate background { duration: 80ms; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                NavIcon {
                                    d: icon-close;
                                    icon-color: close-warn-ta.has-hover ? Cat.text : Cat.subtext0;
                                    width: 14px;
                                    height: 14px;
                                }
                            }
                        }
                        close-warn-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-warning-popup = false;
                                root.dismiss-warning-popup();
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Cat.yellow.with-alpha(0.22); }

                Text {
                    text: warning-popup-message;
                    font-size: Cat.fs13;
                    color: Cat.text;
                    wrap: word-wrap;
                }

                if warning-popup-chaotic-aur: Rectangle {
                    background: Cat.green.with-alpha(0.08);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Cat.green.with-alpha(0.25);
                    height: chaotic-hint.preferred-height + 16px;

                    chaotic-hint := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text {
                            text: @tr("Chaotic-AUR is enabled on this system.");
                            font-size: Cat.fs11;
                            color: Cat.green.with-alpha(0.85);
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Click Install Downgrade below to install it now.");
                            font-size: Cat.fs11;
                            color: Cat.subtext0;
                        }
                    }
                }

                if !warning-popup-chaotic-aur: Rectangle {
                    background: Cat.yellow.with-alpha(0.06);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Cat.yellow.with-alpha(0.18);
                    height: aur-hint.preferred-height + 16px;

                    aur-hint := VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: @tr("Install via your AUR helper:");
                            font-size: Cat.fs11;
                            color: Cat.yellow.with-alpha(0.8);
                            font-weight: 600;
                        }
                        Text {
                            text: "paru -S downgrade";
                            font-size: Cat.fs12;
                            color: Cat.green;
                            font-family: "monospace";
                        }
                        Text {
                            text: "yay -S downgrade";
                            font-size: Cat.fs12;
                            color: Cat.green;
                            font-family: "monospace";
                        }
                    }
                }

                if warning-popup-chaotic-aur: Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: install-dg-ta.has-hover ? Cat.green.with-alpha(0.28) : Cat.green.with-alpha(0.15);
                    border-width: 1px;
                    border-color: Cat.green.with-alpha(0.5);
                    animate background { duration: 100ms; }

                    Text {
                        text: @tr("Install Downgrade");
                        font-size: Cat.fs13;
                        font-weight: 700;
                        color: Cat.green;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    install-dg-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-warning-popup = false;
                            root.install-downgrade();
                        }
                    }
                }
            }
        }
    }

    if show-history-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(1000px, parent.width - 40px);
            height: min(700px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.mauve.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;
                // Header
                Rectangle {
                    height: 56px;
                    background: Cat.mauve.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.mauve.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        VerticalLayout { alignment: center;
                            NavIcon { d: "M3 3v5h5M3.05 13a9 9 0 105.5-7.6L3 8M12 7v5l4 2"; icon-color: Cat.mauve; width: 20px; height: 20px; }
                        }
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Transaction History"); font-size: Cat.fs15; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Review and roll back pacman transactions"); font-size: Cat.fs11; color: Cat.subtext0; }
                        }
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: hist-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                hist-close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-history-modal = false; } }
                            }
                        }
                    }
                }

                if history-loading: VerticalLayout { alignment: center; LoadingCircle { diameter: 26px; } }

                if !history-loading: HorizontalLayout {
                    spacing: 0;
                    // Left: transaction timeline
                    Rectangle {
                        width: 420px;
                        background: Cat.mantle;
                        Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Cat.surface0; }
                        ScrollView {
                            VerticalLayout {
                                padding: 8px; spacing: 3px; alignment: start;
                                for tx[i] in history-txns: Rectangle {
                                    height: 68px; border-radius: 8px;
                                    background: i == history-selected ? Cat.mauve.with-alpha(0.18) : (htx-ta.has-hover ? Cat.surface0 : transparent);
                                    animate background { duration: 60ms; }
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 8px;
                                        VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                            Text { text: tx.when; font-size: Cat.fs14; font-weight: 700; color: Cat.text; overflow: elide; }
                                            Text { text: tx.command == "" ? @tr("(direct transaction)") : tx.command; font-size: Cat.fs13; font-weight: 600; color: Cat.subtext0; overflow: elide; }
                                            Text { text: tx.summary; font-size: Cat.fs13; color: Cat.overlay1; overflow: elide; }
                                        }
                                        if tx.rollbackable: VerticalLayout { alignment: center;
                                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Cat.mauve; }
                                        }
                                    }
                                    htx-ta := TouchArea { mouse-cursor: pointer; clicked => { root.select-transaction(i); } }
                                }
                                if history-txns.length == 0: VerticalLayout { alignment: center; padding-top: 20px;
                                    Text { text: @tr("No transactions found"); font-size: Cat.fs13; color: Cat.overlay0; horizontal-alignment: center; }
                                }
                            }
                        }
                    }

                    // Right: detail + rollback
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Cat.base;
                        if history-selected < 0: VerticalLayout { alignment: center;
                            Text { text: @tr("Select a transaction to see its changes"); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                        }
                        if history-selected >= 0: VerticalLayout {
                            spacing: 0;
                            Rectangle {
                                height: 48px; background: Cat.surface0.with-alpha(0.4);
                                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.divider; }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 8px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Text { text: history-detail-title; font-size: Cat.fs15; font-weight: 700; color: Cat.text; overflow: elide; }
                                    }
                                    if history-can-rollback: VerticalLayout { alignment: center;
                                        Rectangle {
                                            width: hrb-lbl.preferred-width + 26px; height: 30px; border-radius: 8px;
                                            background: hrb-ta.has-hover ? Cat.red.with-alpha(0.28) : Cat.red.with-alpha(0.15);
                                            border-width: 1px; border-color: Cat.red.with-alpha(0.5);
                                            animate background { duration: 70ms; }
                                            hrb-lbl := Text { text: @tr("Roll back upgrades"); font-size: Cat.fs12; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                            hrb-ta := TouchArea { mouse-cursor: pointer; clicked => { root.confirm-rollback(); } }
                                        }
                                    }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 8px; spacing: 1px; alignment: start;
                                    for a in history-actions: Rectangle {
                                        height: 34px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                                            VerticalLayout { alignment: center;
                                                Rectangle {
                                                    width: 72px; height: 20px; border-radius: 4px;
                                                    background: a.kind == "removed" ? Cat.red.with-alpha(0.15) : (a.kind == "installed" ? Cat.green.with-alpha(0.15) : Cat.mauve.with-alpha(0.15));
                                                    Text { text: a.kind; font-size: Cat.fs11; font-weight: 700; color: a.kind == "removed" ? Cat.red : (a.kind == "installed" ? Cat.green : Cat.mauve); horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                            VerticalLayout { alignment: center; horizontal-stretch: 1;
                                                Text { text: a.pkg; font-size: Cat.fs14; font-weight: 500; color: Cat.text; overflow: elide; }
                                            }
                                            VerticalLayout { alignment: center;
                                                Text { text: a.change; font-size: Cat.fs13; color: Cat.subtext0; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }
    }

    // Transaction-history entry warning (gate before opening; persisted opt-out).
    if history-warn-open: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.78);
        TouchArea {}
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(640px, parent.width - 60px);
            height: warn-col.preferred-height + 48px;
            background: Cat.base;
            border-radius: 12px;
            border-width: 1px; border-color: Cat.red.with-alpha(0.55);
            drop-shadow-blur: 32px; drop-shadow-color: Cat.crust.with-alpha(0.85);
            warn-col := VerticalLayout {
                padding: 24px; spacing: 18px;
                HorizontalLayout { spacing: 12px;
                    VerticalLayout { alignment: start;
                        NavIcon { d: "M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01"; icon-color: Cat.red; width: 28px; height: 28px; }
                    }
                    VerticalLayout { horizontal-stretch: 1; alignment: center;
                        Text { text: @tr("Before you use rollback"); font-size: Cat.fs17; font-weight: 800; color: Cat.text; }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("This tool is built to be safe: rollbacks are atomic, signature-verified, and never force-downgrade past dependency checks.");
                        font-size: Cat.fs14; color: Cat.subtext0; wrap: word-wrap;
                    }
                    Text {
                        text: @tr("But it cannot foresee everything, and rolling packages back can still have unintended effects on your system.");
                        font-size: Cat.fs14; color: Cat.subtext0; wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Strongly recommended: take a Timeshift or Btrfs snapshot first.");
                        font-size: Cat.fs14; font-weight: 700; color: Cat.text; wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Backups are your responsibility; the tool cannot guarantee against every outcome.");
                        font-size: Cat.fs14; font-weight: 700; color: Cat.text; wrap: word-wrap;
                    }
                }
                // What happens after a rollback (Option 2: no hold, repeatable).
                Rectangle {
                    background: Cat.mauve.with-alpha(0.1);
                    border-radius: 8px;
                    border-width: 1px; border-color: Cat.mauve.with-alpha(0.3);
                    VerticalLayout {
                        padding: 12px; spacing: 7px;
                        Text {
                            text: @tr("After rolling back: these packages stay at the OLDER version only until your next update. A normal update will upgrade them again and re-apply the change.");
                            font-size: Cat.fs13; color: Cat.subtext0; wrap: word-wrap;
                        }
                        Text {
                            text: @tr("So do NOT run a full system update until you have figured out and fixed the cause, or taken a Timeshift / Btrfs snapshot. If the newer version still breaks things, just roll back again.");
                            font-size: Cat.fs13; font-weight: 600; color: Cat.mauve; wrap: word-wrap;
                        }
                    }
                }
                if history-snapshot-note != "": Text {
                    text: history-snapshot-note; font-size: Cat.fs13; font-weight: 600; color: Cat.mauve; wrap: word-wrap;
                }
                // Don't-show-again checkbox
                HorizontalLayout {
                    spacing: 9px;
                    VerticalLayout { alignment: center;
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 5px;
                            background: history-warn-dontshow ? Cat.mauve : Cat.surface0;
                            border-width: 1px; border-color: history-warn-dontshow ? Cat.mauve : Cat.overlay0.with-alpha(0.5);
                            if history-warn-dontshow: NavIcon { d: "M20 6L9 17l-5-5"; icon-color: Cat.crust; width: 13px; height: 13px; x: 3px; y: 3px; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.history-warn-dontshow = !root.history-warn-dontshow; } }
                        }
                    }
                    VerticalLayout { alignment: center;
                        Text { text: @tr("Don't show this warning again"); font-size: Cat.fs13; color: Cat.subtext0; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 90px; height: 36px; border-radius: 8px;
                        background: warn-cancel.has-hover ? Cat.surface1 : Cat.surface0;
                        border-width: 1px; border-color: Cat.overlay0.with-alpha(0.4);
                        Text { text: @tr("Cancel"); font-size: Cat.fs14; font-weight: 600; color: Cat.text; horizontal-alignment: center; vertical-alignment: center; }
                        warn-cancel := TouchArea { mouse-cursor: pointer; clicked => { root.history-warn-open = false; } }
                    }
                    Rectangle {
                        width: 200px; height: 36px; border-radius: 8px;
                        background: warn-ok.has-hover ? Cat.red : Cat.red.with-alpha(0.85);
                        Text { text: @tr("I understand, continue"); font-size: Cat.fs14; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                        warn-ok := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.history-warn-open = false; root.proceed-history-warning(root.history-warn-dontshow); }
                        }
                    }
                }
            }
        }
    }

    if show-flatpak-perms-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        property <string> fs-add-path: "";
        property <string> fs-add-mode: "rw";
        property <string> bus-add-name: "";
        property <string> env-add-key: "";
        property <string> env-add-val: "";
        property <string> persist-add: "";

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(1080px, parent.width - 40px);
            height: min(740px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.mauve.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                // Header
                Rectangle {
                    height: 56px;
                    background: Cat.mauve.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.mauve.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        VerticalLayout { alignment: center;
                            NavIcon { d: "M3 6h18M3 12h18M3 18h18"; icon-color: Cat.mauve; width: 20px; height: 20px; }
                        }
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Flatpak Permissions"); font-size: Cat.fs15; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Control what installed Flatpak apps are allowed to access"); font-size: Cat.fs11; color: Cat.subtext0; }
                        }
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: fperm-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                fperm-close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-flatpak-perms-modal = false; } }
                            }
                        }
                    }
                }

                // Body: left app list | right permission panel
                HorizontalLayout {
                    spacing: 0;

                    // Left: installed app list + search (hidden when opened for a single app)
                    if !perm-single-app: Rectangle {
                        width: 280px;
                        background: Cat.mantle;
                        Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Cat.surface0; }
                        VerticalLayout {
                            padding: 10px; spacing: 8px;
                            Rectangle {
                                height: 34px; border-radius: 8px; background: Cat.surface0;
                                border-width: fperm-search.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                clip: true;
                                if perm-app-filter == "" && !fperm-search.has-focus: Text { x: 10px; height: 100%; text: @tr("Search apps..."); font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center; }
                                fperm-search := TextInput {
                                    x: 10px; width: parent.width - 20px; height: 100%;
                                    text <=> perm-app-filter; font-size: Cat.fs13; color: Cat.text; single-line: true; vertical-alignment: center;
                                    edited => { root.filter-perm-apps(self.text); }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 2px; alignment: start;
                                    for a in perm-apps: Rectangle {
                                        height: 44px; border-radius: 8px;
                                        background: a.id == perm-selected-id ? Cat.mauve.with-alpha(0.18) : (pa-ta.has-hover ? Cat.surface0 : transparent);
                                        animate background { duration: 60ms; }
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                                            VerticalLayout { alignment: center;
                                                AppAvatar { initial: a.initial; category: "System"; width: 28px; height: 28px; border-radius: 7px; }
                                            }
                                            VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
                                                Text { text: a.name; font-size: Cat.fs13; font-weight: 600; color: Cat.text; overflow: elide; }
                                                Text { text: a.id; font-size: Cat.fs10; color: Cat.overlay1; overflow: elide; }
                                            }
                                        }
                                        pa-ta := TouchArea { mouse-cursor: pointer; clicked => { root.select-perm-app(a.id); } }
                                    }
                                }
                            }
                        }
                    }

                    // Right: permission panel
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Cat.base;

                        if perm-selected-id == "": VerticalLayout {
                            alignment: center;
                            Text { text: @tr("Select an app to edit its permissions"); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; }
                        }

                        if perm-selected-id != "": VerticalLayout {
                            spacing: 0;

                            // Scope / reset / apply bar
                            Rectangle {
                                height: 48px;
                                background: Cat.surface0.with-alpha(0.4);
                                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.divider; }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 8px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Text { text: perm-selected-name; font-size: Cat.fs14; font-weight: 700; color: Cat.text; overflow: elide; }
                                    }
                                    // User/System scope toggle
                                    VerticalLayout { alignment: center;
                                        Rectangle {
                                            width: 150px; height: 30px; border-radius: 8px; background: Cat.surface0;
                                            HorizontalLayout {
                                                padding: 3px; spacing: 3px;
                                                Rectangle {
                                                    horizontal-stretch: 1; border-radius: 6px;
                                                    background: !perm-scope-system ? Cat.mauve.with-alpha(0.85) : transparent;
                                                    Text { text: @tr("User"); font-size: Cat.fs12; font-weight: 600; color: !perm-scope-system ? Cat.crust : Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.set-perm-scope(false); } }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1; border-radius: 6px;
                                                    background: perm-scope-system ? Cat.mauve.with-alpha(0.85) : transparent;
                                                    Text { text: @tr("System"); font-size: Cat.fs12; font-weight: 600; color: perm-scope-system ? Cat.crust : Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.set-perm-scope(true); } }
                                                }
                                            }
                                        }
                                    }
                                    if perm-scope-system && perm-dirty: VerticalLayout { alignment: center;
                                        Rectangle {
                                            width: 70px; height: 30px; border-radius: 8px;
                                            background: papply-ta.has-hover ? Cat.green : Cat.green.with-alpha(0.85);
                                            Text { text: @tr("Apply"); font-size: Cat.fs13; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                            papply-ta := TouchArea { mouse-cursor: pointer; clicked => { root.apply-perm-system(); } }
                                        }
                                    }
                                    VerticalLayout { alignment: center;
                                        Rectangle {
                                            width: 64px; height: 30px; border-radius: 8px;
                                            background: preset-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                            border-width: 1px; border-color: Cat.overlay0.with-alpha(0.4);
                                            Text { text: @tr("Reset"); font-size: Cat.fs12; font-weight: 600; color: Cat.text; horizontal-alignment: center; vertical-alignment: center; }
                                            preset-ta := TouchArea { mouse-cursor: pointer; clicked => { root.reset-perm(); } }
                                        }
                                    }
                                }
                            }

                            if perm-loading: VerticalLayout { alignment: center; LoadingCircle { diameter: 26px; } }

                            if !perm-loading: ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 10px; spacing: 2px; alignment: start;

                                    PermSectionLabel { text-value: @tr("SHARED"); }
                                    for t in perm-shares: PermToggleRow { t: t; changed(v) => { root.toggle-perm("shared", t.key, v); } }

                                    PermSectionLabel { text-value: @tr("SOCKETS"); }
                                    for t in perm-sockets: PermToggleRow { t: t; changed(v) => { root.toggle-perm("socket", t.key, v); } }

                                    PermSectionLabel { text-value: @tr("DEVICES"); }
                                    for t in perm-devices: PermToggleRow { t: t; changed(v) => { root.toggle-perm("device", t.key, v); } }

                                    PermSectionLabel { text-value: @tr("FEATURES"); }
                                    for t in perm-features: PermToggleRow { t: t; changed(v) => { root.toggle-perm("feature", t.key, v); } }

                                    PermSectionLabel { text-value: @tr("FILESYSTEMS"); }
                                    for t in perm-filesystems: PermToggleRow { t: t; changed(v) => { root.toggle-perm("filesystem", t.key, v); } }
                                    for e in perm-filesystems-custom: PermEntryRow { e: e; removed() => { root.remove-perm-fs(e.value); } }
                                    // Add custom filesystem path
                                    Rectangle {
                                        height: 36px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 30px; border-radius: 6px; background: Cat.surface0; clip: true;
                                                border-width: fsin.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                                if fs-add-path == "" && !fsin.has-focus: Text { x: 8px; height: 100%; text: @tr("Add path (e.g. ~/Games or /data)"); font-size: Cat.fs12; color: Cat.overlay0; vertical-alignment: center; }
                                                fsin := TextInput { x: 8px; width: parent.width - 16px; height: 100%; text <=> fs-add-path; font-size: Cat.fs12; color: Cat.text; single-line: true; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                width: 60px; height: 30px; border-radius: 6px; background: fsmode-ta.has-hover ? Cat.surface1 : Cat.surface0;
                                                border-width: 1px; border-color: Cat.overlay0.with-alpha(0.3);
                                                Text { text: fs-add-mode; font-size: Cat.fs12; color: Cat.subtext0; horizontal-alignment: center; vertical-alignment: center; }
                                                fsmode-ta := TouchArea { mouse-cursor: pointer; clicked => { fs-add-mode = fs-add-mode == "rw" ? "ro" : (fs-add-mode == "ro" ? "create" : "rw"); } }
                                            }
                                            Rectangle {
                                                width: 54px; height: 30px; border-radius: 6px; background: fsadd-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85);
                                                Text { text: @tr("Add"); font-size: Cat.fs12; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                                fsadd-ta := TouchArea { mouse-cursor: pointer; clicked => { if fs-add-path != "" { root.add-perm-fs(fs-add-path, fs-add-mode); fs-add-path = ""; } } }
                                            }
                                        }
                                    }

                                    PermSectionLabel { text-value: @tr("SESSION BUS (talk)"); }
                                    for e in perm-session-bus: PermEntryRow { e: e; removed() => { root.remove-perm-bus(false, e.value); } }
                                    Rectangle {
                                        height: 36px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 30px; border-radius: 6px; background: Cat.surface0; clip: true;
                                                border-width: busin.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                                if bus-add-name == "" && !busin.has-focus: Text { x: 8px; height: 100%; text: @tr("Add bus name (e.g. org.freedesktop.Flatpak)"); font-size: Cat.fs12; color: Cat.overlay0; vertical-alignment: center; }
                                                busin := TextInput { x: 8px; width: parent.width - 16px; height: 100%; text <=> bus-add-name; font-size: Cat.fs12; color: Cat.text; single-line: true; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                width: 54px; height: 30px; border-radius: 6px; background: busadd-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85);
                                                Text { text: @tr("Add"); font-size: Cat.fs12; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                                busadd-ta := TouchArea { mouse-cursor: pointer; clicked => { if bus-add-name != "" { root.add-perm-bus(false, bus-add-name); bus-add-name = ""; } } }
                                            }
                                        }
                                    }

                                    PermSectionLabel { text-value: @tr("SYSTEM BUS (talk)"); }
                                    for e in perm-system-bus: PermEntryRow { e: e; removed() => { root.remove-perm-bus(true, e.value); } }

                                    PermSectionLabel { text-value: @tr("ENVIRONMENT"); }
                                    for e in perm-env: PermEntryRow { e: e; removed() => { root.remove-perm-env(e.value); } }
                                    Rectangle {
                                        height: 36px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            Rectangle {
                                                width: 40%; height: 30px; border-radius: 6px; background: Cat.surface0; clip: true;
                                                border-width: envk.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                                if env-add-key == "" && !envk.has-focus: Text { x: 8px; height: 100%; text: @tr("KEY"); font-size: Cat.fs12; color: Cat.overlay0; vertical-alignment: center; }
                                                envk := TextInput { x: 8px; width: parent.width - 16px; height: 100%; text <=> env-add-key; font-size: Cat.fs12; color: Cat.text; single-line: true; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1; height: 30px; border-radius: 6px; background: Cat.surface0; clip: true;
                                                border-width: envv.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                                if env-add-val == "" && !envv.has-focus: Text { x: 8px; height: 100%; text: @tr("value"); font-size: Cat.fs12; color: Cat.overlay0; vertical-alignment: center; }
                                                envv := TextInput { x: 8px; width: parent.width - 16px; height: 100%; text <=> env-add-val; font-size: Cat.fs12; color: Cat.text; single-line: true; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                width: 54px; height: 30px; border-radius: 6px; background: envadd-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85);
                                                Text { text: @tr("Set"); font-size: Cat.fs12; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                                envadd-ta := TouchArea { mouse-cursor: pointer; clicked => { if env-add-key != "" { root.add-perm-env(env-add-key, env-add-val); env-add-key = ""; env-add-val = ""; } } }
                                            }
                                        }
                                    }

                                    PermSectionLabel { text-value: @tr("PERSISTENT"); }
                                    for e in perm-persist: PermEntryRow { e: e; removed() => { } }
                                    Rectangle {
                                        height: 36px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 30px; border-radius: 6px; background: Cat.surface0; clip: true;
                                                border-width: persin.has-focus ? 1px : 0px; border-color: Cat.mauve.with-alpha(0.5);
                                                if persist-add == "" && !persin.has-focus: Text { x: 8px; height: 100%; text: @tr("Add persisted relative path (e.g. .mozilla)"); font-size: Cat.fs12; color: Cat.overlay0; vertical-alignment: center; }
                                                persin := TextInput { x: 8px; width: parent.width - 16px; height: 100%; text <=> persist-add; font-size: Cat.fs12; color: Cat.text; single-line: true; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                width: 54px; height: 30px; border-radius: 6px; background: persadd-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85);
                                                Text { text: @tr("Add"); font-size: Cat.fs12; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                                persadd-ta := TouchArea { mouse-cursor: pointer; clicked => { if persist-add != "" { root.add-perm-persist(persist-add); persist-add = ""; } } }
                                            }
                                        }
                                    }

                                    Rectangle { height: 8px; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-flatpak-remotes-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(500px, parent.width - 40px);
            height: min(560px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.teal.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 56px;
                    background: Cat.teal.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.teal.with-alpha(0.25); }

                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        VerticalLayout { alignment: center;
                            NavIcon { d: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4 4 0 003 15z"; icon-color: Cat.teal; width: 20px; height: 20px; }
                        }
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: @tr("Flatpak Remotes"); font-size: Cat.fs15; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Add or remove Flatpak remote repositories"); font-size: Cat.fs11; color: Cat.subtext0; }
                        }
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 28px; height: 25px; border-radius: 8px;
                                background: fr-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 14px; height: 14px; x: 7px; y: 7px; }
                                fr-close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-flatpak-remotes-modal = false; } }
                            }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        alignment: start;

                        if flatpak-mgr-remotes-loading: VerticalLayout {
                            alignment: center;
                            padding-top: 20px;
                            LoadingCircle { diameter: 24px; }
                        }

                        if !flatpak-mgr-remotes-loading && flatpak-mgr-remotes.length == 0: Rectangle {
                            height: 60px;
                            Text {
                                text: @tr("No remotes configured");
                                font-size: Cat.fs13; color: Cat.overlay0;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }

                        for remote[i] in flatpak-mgr-remotes: Rectangle {
                            height: 52px;
                            border-radius: 8px;
                            background: Cat.surface0.with-alpha(0.5);
                            border-width: 1px; border-color: Cat.surface1;

                            HorizontalLayout {
                                padding-left: 14px; padding-right: 12px; spacing: 10px;
                                VerticalLayout { alignment: center;
                                    NavIcon { d: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4 4 0 003 15z"; icon-color: Cat.teal; width: 16px; height: 16px; }
                                }
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    HorizontalLayout { alignment: start; spacing: 6px;
                                        Text { text: remote.name; font-size: Cat.fs14; font-weight: 600; color: remote.enabled ? Cat.text : Cat.overlay0; overflow: elide; }
                                        VerticalLayout { alignment: center;
                                            Rectangle {
                                                width: rem-tag-lbl.preferred-width + 12px; height: 16px; border-radius: 4px;
                                                background: Cat.surface1;
                                                rem-tag-lbl := Text { text: remote.system ? @tr("System") : @tr("User"); font-size: Cat.fs10; font-weight: 700; color: Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        if !remote.enabled: VerticalLayout { alignment: center;
                                            Rectangle {
                                                width: dis-lbl.preferred-width + 12px; height: 16px; border-radius: 4px;
                                                background: Cat.red.with-alpha(0.15);
                                                dis-lbl := Text { text: @tr("Disabled"); font-size: Cat.fs10; font-weight: 700; color: Cat.red; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    Text { text: remote.url; font-size: Cat.fs13; color: Cat.overlay1; overflow: elide; }
                                }
                                // Enable/disable toggle. The default remote (flathub)
                                // cannot be disabled, so it shows no toggle.
                                if remote.name != "flathub": VerticalLayout { alignment: center;
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: remote.enabled ? Cat.green.with-alpha(0.85) : Cat.surface1;
                                        animate background { duration: 90ms; }
                                        Rectangle {
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: Cat.text;
                                            y: 3px;
                                            x: remote.enabled ? parent.width - self.width - 3px : 3px;
                                            animate x { duration: 110ms; easing: ease-out; }
                                        }
                                        fr-tog-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.set-flatpak-remote-enabled(remote.name, remote.system, !remote.enabled); }
                                        }
                                    }
                                }
                                VerticalLayout { alignment: center;
                                    if remote.name == "flathub": Rectangle {
                                        width: 60px; height: 22px; border-radius: 6px;
                                        background: Cat.teal.with-alpha(0.15);
                                        Text { text: @tr("Default"); font-size: Cat.fs11; font-weight: 700; color: Cat.teal; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    if remote.name != "flathub": Rectangle {
                                        width: 26px; height: 26px; border-radius: 6px;
                                        background: fr-del-ta.has-hover ? Cat.red.with-alpha(0.25) : Cat.surface1;
                                        animate background { duration: 70ms; }
                                        NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.red; width: 12px; height: 12px; x: 7px; y: 7px; }
                                        fr-del-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-flatpak-remote(remote.name, remote.system); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px; background: Cat.divider;
                }

                Rectangle {
                    height: 106px;
                    background: Cat.mantle;

                    VerticalLayout {
                        padding: 12px; spacing: 8px;

                        Text { text: @tr("Add Remote"); font-size: Cat.fs13; font-weight: 700; color: Cat.subtext0; }

                        HorizontalLayout {
                            spacing: 6px;

                            Rectangle {
                                horizontal-stretch: 0; width: 120px; height: 30px; border-radius: 6px;
                                background: Cat.surface1;
                                border-width: fr-name-in.has-focus ? 1px : 0px; border-color: Cat.teal.with-alpha(0.5);
                                clip: true;
                                if new-remote-name == "" && !fr-name-in.has-focus: Text { x: 8px; height: 100%; text: @tr("Name"); font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center; }
                                fr-name-in := TextInput {
                                    x: 8px; width: parent.width - 16px; height: 100%;
                                    text <=> new-remote-name; font-size: Cat.fs13; color: Cat.text; single-line: true; vertical-alignment: center;
                                    selection-background-color: Cat.teal.with-alpha(0.3);
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1; height: 30px; border-radius: 6px;
                                background: Cat.surface1;
                                border-width: fr-url-in.has-focus ? 1px : 0px; border-color: Cat.teal.with-alpha(0.5);
                                clip: true;
                                if new-remote-url == "" && !fr-url-in.has-focus: Text { x: 8px; height: 100%; text: @tr("URL (https://...)"); font-size: Cat.fs13; color: Cat.overlay0; vertical-alignment: center; }
                                fr-url-in := TextInput {
                                    x: 8px; width: parent.width - 16px; height: 100%;
                                    text <=> new-remote-url; font-size: Cat.fs13; color: Cat.text; single-line: true; vertical-alignment: center;
                                    selection-background-color: Cat.teal.with-alpha(0.3);
                                }
                            }

                            Rectangle {
                                width: 60px; height: 30px; border-radius: 6px;
                                background: fr-add-ta.has-hover ? Cat.teal.with-alpha(0.85) : Cat.teal;
                                animate background { duration: 70ms; }
                                Text { text: @tr("Add"); font-size: Cat.fs14; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                fr-add-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if new-remote-name != "" && new-remote-url != "" {
                                            root.add-flatpak-remote(new-remote-name, new-remote-url);
                                            new-remote-name = "";
                                            new-remote-url = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-appimage-mgr-modal: Rectangle {
        width: 100%; height: 100%;
        background: Cat.crust.with-alpha(0.75);
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(660px, parent.width - 40px);
            height: min(740px, parent.height - 40px);
            background: Cat.base;
            border-radius: 12px;
            clip: true;
            border-width: 1px;
            border-color: Cat.blue.with-alpha(0.4);
            drop-shadow-blur: 36px;
            drop-shadow-color: Cat.crust.with-alpha(0.8);
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 66px;
                    background: Cat.blue.with-alpha(0.1);
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Cat.blue.with-alpha(0.25); }
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; spacing: 14px;
                        VerticalLayout { alignment: center; NavIcon { d: icon-image; icon-color: Cat.blue; width: 24px; height: 24px; } }
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                            Text { text: @tr("Manage AppImages"); font-size: Cat.fs17; font-weight: 700; color: Cat.text; }
                            Text { text: @tr("Install location and catalog sources"); font-size: Cat.fs13; color: Cat.subtext0; }
                        }
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 34px; height: 32px; border-radius: 8px;
                                background: aim-close-ta.has-hover ? Cat.surface1 : transparent;
                                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.overlay1; width: 16px; height: 16px; x: 9px; y: 8px; }
                                aim-close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-appimage-mgr-modal = false; } }
                            }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 20px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("Install / Download Location"); font-size: Cat.fs15; font-weight: 700; color: Cat.subtext0; }
                            Rectangle {
                                height: 58px;
                                border-radius: 8px;
                                background: Cat.surface0.with-alpha(0.5);
                                border-width: 1px; border-color: Cat.surface1;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 14px; spacing: 10px;
                                    Text {
                                        text: setting-appimage-dir == "" ? @tr("Default: ~/.local/share/xpm/appimages") : setting-appimage-dir;
                                        font-size: Cat.fs14; color: Cat.subtext1; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                    }
                                    VerticalLayout { alignment: center; Btn { label: @tr("Change…"); width: 100px; horizontal-stretch: 0; clicked => { root.change-appimage-dir(); } } }
                                    if setting-appimage-dir != "": VerticalLayout { alignment: center; Btn { label: @tr("Reset"); width: 78px; horizontal-stretch: 0; clicked => { root.reset-appimage-dir(); } } }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("GitHub Token (optional)"); font-size: Cat.fs15; font-weight: 700; color: Cat.subtext0; }
                            Text { text: @tr("Unauthenticated GitHub allows 60 update checks/hour. A personal access token (read-only, no scopes needed) raises this to 5000/hour."); font-size: Cat.fs13; color: Cat.overlay1; wrap: word-wrap; }
                            Rectangle {
                                height: 50px;
                                border-radius: 8px;
                                background: Cat.surface0.with-alpha(0.5);
                                border-width: 1px;
                                border-color: aim-tok-ti.has-focus ? Cat.mauve : Cat.surface1;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 14px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        aim-tok-ti := TextInput {
                                            width: 100%; height: 100%;
                                            text <=> setting-appimage-github-token;
                                            font-size: Cat.fs14;
                                            color: Cat.text;
                                            single-line: true;
                                            input-type: password;
                                            vertical-alignment: center;
                                            selection-background-color: Cat.mauve.with-alpha(0.3);
                                            edited => { root.save-settings(); }
                                        }
                                        if setting-appimage-github-token == "" && !aim-tok-ti.has-focus: Text {
                                            width: 100%; height: 100%;
                                            text: @tr("ghp_… (leave empty to stay unauthenticated)");
                                            font-size: Cat.fs14;
                                            color: Cat.subtext0.with-alpha(0.5);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text { text: @tr("Catalog Sources"); font-size: Cat.fs15; font-weight: 700; color: Cat.subtext0; }
                            Text { text: @tr("Feed-JSON catalogs (appimage.github.io format). Merged and de-duplicated."); font-size: Cat.fs13; color: Cat.overlay1; }

                            if appimage-sources.length == 0: Rectangle {
                                height: 48px;
                                Text { text: @tr("No sources configured"); font-size: Cat.fs14; color: Cat.overlay0; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            }

                            for src[i] in appimage-sources: Rectangle {
                                height: 60px;
                                border-radius: 8px;
                                background: Cat.surface0.with-alpha(0.5);
                                border-width: 1px; border-color: Cat.surface1;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 14px; spacing: 12px;
                                    VerticalLayout { alignment: center; NavIcon { d: icon-image; icon-color: Cat.blue; width: 18px; height: 18px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                        Text { text: src.name; font-size: Cat.fs15; font-weight: 600; color: Cat.text; overflow: elide; }
                                        Text { text: src.url; font-size: Cat.fs13; color: Cat.overlay1; overflow: elide; }
                                    }
                                    VerticalLayout { alignment: center;
                                        if src.url == "https://appimage.github.io/feed.json": Rectangle {
                                            width: 68px; height: 26px; border-radius: 6px;
                                            background: Cat.blue.with-alpha(0.15);
                                            Text { text: @tr("Default"); font-size: Cat.fs13; font-weight: 700; color: Cat.blue; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if src.url != "https://appimage.github.io/feed.json": Rectangle {
                                            width: 30px; height: 30px; border-radius: 6px;
                                            background: aim-src-del-ta.has-hover ? Cat.red.with-alpha(0.25) : Cat.surface1;
                                            animate background { duration: 70ms; }
                                            NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.red; width: 13px; height: 13px; x: 8px; y: 8px; }
                                            aim-src-del-ta := TouchArea { mouse-cursor: pointer; clicked => { root.remove-appimage-source(src.name); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Cat.divider; }

                Rectangle {
                    height: 122px;
                    background: Cat.mantle;
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Text { text: @tr("Add Source"); font-size: Cat.fs15; font-weight: 700; color: Cat.subtext0; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 0; width: 150px; height: 38px; border-radius: 6px;
                                background: Cat.surface1;
                                border-width: aim-name-in.has-focus ? 1px : 0px; border-color: Cat.blue.with-alpha(0.5);
                                clip: true;
                                if new-appimage-source-name == "" && !aim-name-in.has-focus: Text { x: 10px; height: 100%; text: @tr("Name"); font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; }
                                aim-name-in := TextInput {
                                    x: 10px; width: parent.width - 20px; height: 100%;
                                    text <=> new-appimage-source-name; font-size: Cat.fs14; color: Cat.text; single-line: true; vertical-alignment: center;
                                    selection-background-color: Cat.blue.with-alpha(0.3);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 38px; border-radius: 6px;
                                background: Cat.surface1;
                                border-width: aim-url-in.has-focus ? 1px : 0px; border-color: Cat.blue.with-alpha(0.5);
                                clip: true;
                                if new-appimage-source-url == "" && !aim-url-in.has-focus: Text { x: 10px; height: 100%; text: @tr("Feed URL (https://…/feed.json)"); font-size: Cat.fs14; color: Cat.overlay0; vertical-alignment: center; }
                                aim-url-in := TextInput {
                                    x: 10px; width: parent.width - 20px; height: 100%;
                                    text <=> new-appimage-source-url; font-size: Cat.fs14; color: Cat.text; single-line: true; vertical-alignment: center;
                                    selection-background-color: Cat.blue.with-alpha(0.3);
                                }
                            }
                            Rectangle {
                                width: 72px; height: 38px; border-radius: 6px;
                                background: aim-add-ta.has-hover ? Cat.blue.with-alpha(0.85) : Cat.blue;
                                animate background { duration: 70ms; }
                                Text { text: @tr("Add"); font-size: Cat.fs15; font-weight: 700; color: Cat.crust; horizontal-alignment: center; vertical-alignment: center; }
                                aim-add-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if new-appimage-source-url != "" {
                                            root.add-appimage-source(new-appimage-source-name, new-appimage-source-url);
                                            new-appimage-source-name = "";
                                            new-appimage-source-url = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if NavTooltip.text != "": Rectangle {
        x: sidebar-vl.preferred-width + 10px;
        y: NavTooltip.y;
        width: nav-tt-lbl.preferred-width + 18px;
        height: 28px;
        background: Cat.surface2;
        border-radius: 6px;
        border-width: 1px;
        border-color: Cat.overlay0;
        drop-shadow-color: Cat.crust.with-alpha(0.4);
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        nav-tt-lbl := Text {
            text: NavTooltip.text;
            font-size: Cat.fs13;
            color: Cat.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
