import { ListView, ScrollView, Palette } from "std-widgets.slint";

export struct PackageData {
    name: string,
    display-name: string,
    version: string,
    description: string,
    repository: string,
    backend: int,
    installed: bool,
    has-update: bool,
    installed-size: string,
    licenses: string,
    url: string,
    dependencies: string,
    required-by: string,
    selected: bool,
    explicit: bool,
}

export struct AppImageCard {
    github: string,
    name: string,
    description: string,
    initial: string,
    category: string,
    icon: image,
    has-icon: bool,
    installed: bool,
    installed-id: string,
}

export struct AppImageSource { name: string, url: string }

export struct AppImageInstalled {
    id: string,
    name: string,
    detail: string,
    supports-update: bool,
    update-available: bool,
    initial: string,
    icon: image,
    has-icon: bool,
}

export struct StatsData {
    pacman-count: int,
    flatpak-count: int,
    orphan-count: int,
    update-count: int,
    cache-size: string,
}

export struct ActivityItem {
    action: string,
    package: string,
    date: string,
}

export struct SysInfo {
    kernel: string,
    uptime: string,
    cpu: string,
    ram-used: string,
    ram-total: string,
    gpu: string,
    disk-used: string,
    disk-total: string,
    hostname: string,
    distro: string,
}

export struct AppRow {
    a: PackageData,
    b: PackageData,
    c: PackageData,
    count: int,
}

export struct DepNode {
    name: string,
    version: string,
    depth: int,
    installed: bool,
    is-optional: bool,
    prefix: string,
    is-root: bool,
    installable: bool,
}

export struct ArchNewsItem {
    title: string,
    date: string,
    link: string,
    summary: string,
}


export struct RepoEntry {
    name: string,
    server: string,
}

export struct FlatpakRemote { name: string, url: string, enabled: bool, system: bool }

// Flatpak permission editor models.
export struct PermApp { id: string, name: string, initial: string, system: bool }
// A boolean permission toggle. `overridden` = differs from the app default.
export struct PermToggle { key: string, label: string, value: bool, overridden: bool }
// A list-type permission entry: filesystem path (mode=ro/rw/create), bus name
// (mode=policy), env var (value in `mode`), or persist path (mode empty).
export struct PermEntry { value: string, mode: string, overridden: bool }

// Transaction history models.
export struct HistTxn { when: string, command: string, summary: string, rollbackable: bool }
export struct HistAction { kind: string, pkg: string, change: string }

export struct ShotItem { image: image, caption: string }
export struct ReleaseItem { version: string, date: string, notes: string }


export global Cat {
    out property <color> base: Palette.background;
    out property <color> mantle: Palette.background.darker(0.06);
    out property <color> crust: Palette.background.darker(0.14);
    out property <color> sidebar: Palette.background.brighter(0.5);
    out property <color> panel: Palette.background.brighter(0.12);
    out property <color> divider: Palette.foreground.with-alpha(0.16);
    out property <color> surface0: Palette.background.brighter(0.08);
    out property <color> surface1: Palette.background.brighter(0.16);
    out property <color> surface2: Palette.background.brighter(0.26);
    out property <color> overlay0: Palette.foreground.with-alpha(0.38);
    out property <color> overlay1: Palette.foreground.with-alpha(0.55);
    out property <color> overlay2: Palette.foreground.with-alpha(0.7);
    out property <color> subtext0: Palette.foreground.with-alpha(0.8);
    out property <color> subtext1: Palette.foreground.with-alpha(0.9);
    out property <color> text: Palette.foreground;
    out property <color> mauve: #c6a0f6;
    out property <color> blue: #8aadf4;
    out property <color> lavender: #b7bdf8;
    out property <color> red: #e06c75;
    out property <color> green: #98c379;
    out property <color> yellow: #e5c07b;
    out property <color> peach: #d19a66;
    out property <color> teal: #56b6c2;
    out property <color> pink: #c678dd;
    out property <color> flamingo: #e06c75;
    out property <color> rosewater: #e5c0c0;
    out property <color> sapphire: #61afef;
    out property <color> sky: #56b6c2;
    out property <color> maroon: #be5046;

    in-out property <float> font-scale: 1.0;
    out property <length> fs9:  9px  * font-scale;
    out property <length> fs10: 10px * font-scale;
    out property <length> fs11: 11px * font-scale;
    out property <length> fs12: 12px * font-scale;
    out property <length> fs13: 13px * font-scale;
    out property <length> fs14: 14px * font-scale;
    out property <length> fs15: 15px * font-scale;
    out property <length> fs16: 16px * font-scale;
    out property <length> fs17: 17px * font-scale;
    out property <length> fs22: 22px * font-scale;
    out property <length> fs24: 24px * font-scale;
    out property <length> fs25: 25px * font-scale;
    out property <length> fs30: 30px * font-scale;
}

global NavTooltip {
    in-out property <string> text: "";
    in-out property <length> y: 0px;
}

component WarnBadge inherits Rectangle {
    in property <length> size: 18px;
    in property <color> fill: #f5a623;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M10.3 3.2 a2 2 0 0 1 3.4 0 L23 19.5 a2 2 0 0 1 -1.7 3 H2.7 a2 2 0 0 1 -1.7 -3 Z";
        fill: root.fill;
    }
    Text {
        text: "!";
        font-size: size * 0.6;
        font-weight: 900;
        color: #2b2b2b;
        horizontal-alignment: center;
        vertical-alignment: center;
        y: size * 0.14;
        width: 100%;
    }
}

component NavIcon inherits Rectangle {
    in property <brush> icon-color: Cat.text;
    in property <string> d;
    in property <bool> filled: false;
    width: 18px;
    height: 18px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: d;
        fill: filled ? icon-color : transparent;
        stroke: filled ? transparent : icon-color;
        stroke-width: 1.5px;
    }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: 70px;
    border-radius: 8px;
    background: !enabled ? Cat.surface0 :
                danger ? (btn-touch.has-hover ? Cat.red : Cat.red.with-alpha(0.85)) :
                primary ? (btn-touch.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.85)) :
                btn-touch.has-hover ? Cat.surface1 : Cat.surface0;
    animate background { duration: 100ms; }

    Text {
        text: label;
        font-size: Cat.fs13;
        font-weight: 600;
        color: !enabled ? Cat.overlay0 :
               (primary || danger) ? Cat.crust : Cat.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
}

// Shared refresh control: small glyph + "Refresh" pill with a visible outline,
// identical on every page. Width hugs its content (sits compact in the corner).
component RefreshButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> loading: false;
    callback clicked;

    height: 30px;
    width: rb-row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: !enabled ? Cat.surface0.with-alpha(0.5) : (rb-touch.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.6));
    border-width: 1px;
    border-color: rb-touch.has-hover ? Cat.mauve.with-alpha(0.7) : Cat.overlay0.with-alpha(0.45);
    animate background, border-color { duration: 100ms; }

    rb-row := HorizontalLayout {
        alignment: center;
        padding-left: 10px; padding-right: 11px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            NavIcon {
                d: "M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15";
                icon-color: enabled ? Cat.subtext0 : Cat.overlay0;
                width: 13px; height: 13px;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: loading ? @tr("Refreshing...") : @tr("Refresh");
                font-size: Cat.fs12;
                font-weight: 600;
                color: enabled ? Cat.text : Cat.overlay0;
                vertical-alignment: center;
            }
        }
    }

    rb-touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
}

component LoadingCircle inherits Rectangle {
    in property <length> diameter: 28px;
    in property <color> dot-color: Cat.mauve;
    width: diameter;
    height: diameter;

    property <int> step: 0;
    Timer {
        interval: 100ms;
        triggered => { root.step = root.step + 1; }
    }
    property <float> phase: mod(root.step * 1.0, 8.0);

    for i in 8: Rectangle {
        property <float> rel: mod(i - root.phase + 8.0, 8.0);
        property <angle> a: (i / 8.0) * 360deg;
        width: root.diameter * 0.17;
        height: self.width;
        border-radius: self.width / 2;
        background: root.dot-color;
        opacity: 0.15 + 0.85 * ((8.0 - rel) / 8.0);
        x: root.width / 2 - self.width / 2 + (root.width * 0.38) * cos(a);
        y: root.height / 2 - self.height / 2 + (root.height * 0.38) * sin(a);
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-path: "";
    in property <bool> icon-filled: false;
    in property <bool> active: false;
    in property <string> badge: "";
    in property <string> tooltip-text: "";
    callback clicked;

    height: 40px;
    border-radius: 8px;
    background: active ? Cat.mauve.with-alpha(0.2) : (touch.has-hover ? Cat.surface0.with-alpha(0.6) : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tooltip-text != "" {
                NavTooltip.text = root.tooltip-text;
                NavTooltip.y = root.y + root.height / 2 - 14px;
            } else {
                NavTooltip.text = "";
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        if icon-path != "": VerticalLayout {
            alignment: center;
            NavIcon {
                d: icon-path;
                icon-color: active ? Cat.mauve : Cat.subtext0;
                filled: icon-filled;
            }
        }

        Text {
            text: label;
            font-size: Cat.fs14;
            font-weight: active ? 600 : 400;
            color: active ? Cat.mauve : Cat.text;
            opacity: active ? 1.0 : 0.85;
            vertical-alignment: center;
        }

        if badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 24px;
                border-radius: 12px;
                background: Cat.red;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: badge;
                        font-size: Cat.fs14;
                        font-weight: 700;
                        color: Cat.crust;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

component CheckBox inherits Rectangle {
    in property <bool> checked: false;
    callback toggled(bool);

    width: 24px;
    height: 24px;
    border-radius: 6px;
    border-width: checked ? 0 : 2px;
    border-color: Cat.overlay1;
    background: checked ? Cat.mauve : Cat.surface0;
    animate background { duration: 100ms; }

    if checked: NavIcon {
        d: "M20 6L9 17l-5-5";
        icon-color: Cat.crust;
        width: 14px;
        height: 14px;
        x: 5px;
        y: 5px;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component FpCard inherits Rectangle {
    background: Cat.surface0.with-alpha(0.4);
    border-radius: 16px;
    border-width: 1px;
    border-color: Cat.divider;
}

component FpTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Cat.text;
    horizontal-stretch: 1;
    preferred-width: 160px;
    min-width: 0px;
    height: 74px;
    border-radius: 14px;
    background: Cat.surface0.with-alpha(0.4);
    border-width: 1px;
    border-color: Cat.divider;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 5px;
        alignment: center;
        Text { text: root.label; font-size: Cat.fs11; font-weight: 700; color: Cat.overlay1; letter-spacing: 0.7px; }
        Text { text: root.value; font-size: Cat.fs15; font-weight: 700; color: root.accent; overflow: elide; }
    }
}

component FpLink inherits Rectangle {
    in property <string> label;
    in property <string> icon-d;
    in property <color> accent: Cat.blue;
    callback clicked;
    height: 36px;
    width: fl-label.preferred-width + 52px;
    border-radius: 18px;
    background: fl-touch.has-hover ? root.accent.with-alpha(0.24) : root.accent.with-alpha(0.1);
    border-width: 1px;
    border-color: root.accent.with-alpha(0.38);
    animate background { duration: 80ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            NavIcon { d: root.icon-d; icon-color: root.accent; width: 14px; height: 14px; }
        }
        fl-label := Text { text: root.label; font-size: Cat.fs14; font-weight: 600; color: root.accent; vertical-alignment: center; }
    }
    fl-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FpArrow inherits Rectangle {
    in property <bool> forward;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: black.with-alpha(fa-touch.has-hover ? 0.7 : 0.45);
    animate background { duration: 80ms; }
    NavIcon {
        d: root.forward ? "M9 18l6-6-6-6" : "M15 18l-6-6 6-6";
        icon-color: white;
        width: 18px;
        height: 18px;
        x: 11px;
        y: 11px;
    }
    fa-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export global IconStore {
    in-out property <int> epoch: 0;
    pure callback lookup(string, int) -> image;
}

component AppAvatar inherits Rectangle {
    in property <string> initial;
    in property <string> category;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: category == "AudioVideo" ? Cat.pink.with-alpha(0.18) :
                category == "Development" ? Cat.blue.with-alpha(0.18) :
                category == "Game" ? Cat.green.with-alpha(0.18) :
                category == "Graphics" ? Cat.peach.with-alpha(0.18) :
                category == "Network" ? Cat.teal.with-alpha(0.18) :
                category == "Office" ? Cat.sapphire.with-alpha(0.18) :
                category == "Science" ? Cat.sky.with-alpha(0.18) :
                category == "System" ? Cat.overlay1.with-alpha(0.18) :
                category == "Utility" ? Cat.yellow.with-alpha(0.18) :
                Cat.mauve.with-alpha(0.18);
    Text {
        text: initial;
        font-size: Cat.fs24;
        font-weight: 800;
        color: category == "AudioVideo" ? Cat.pink :
               category == "Development" ? Cat.blue :
               category == "Game" ? Cat.green :
               category == "Graphics" ? Cat.peach :
               category == "Network" ? Cat.teal :
               category == "Office" ? Cat.sapphire :
               category == "Science" ? Cat.sky :
               category == "System" ? Cat.overlay2 :
               category == "Utility" ? Cat.yellow :
               Cat.mauve;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PkgIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 40px;
    in property <string> fallback-initial;
    in property <string> category;
    property <image> icon: IconStore.lookup(root.name, IconStore.epoch);
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.24;
    clip: true;
    background: root.icon.width > 0 ? transparent : Cat.surface0.with-alpha(0.55);

    if root.icon.width > 0: Image {
        source: root.icon;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if root.icon.width == 0 && root.fallback-initial != "": AppAvatar {
        initial: root.fallback-initial;
        category: root.category;
        width: root.size;
        height: root.size;
        border-radius: root.size * 0.24;
    }
    if root.icon.width == 0 && root.fallback-initial == "": NavIcon {
        d: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4";
        icon-color: Cat.overlay0;
        width: root.size * 0.5;
        height: root.size * 0.5;
        x: root.size * 0.25;
        y: root.size * 0.25;
    }
}

component PackageRow inherits Rectangle {
    in property <PackageData> pkg;
    in property <bool> show-separator: true;
    in property <bool> show-checkbox: false;
    in property <bool> show-action-button: true;
    callback clicked;
    callback install;
    callback remove;
    callback toggle-selected(bool);

    height: 70px;
    background: pkg.selected ? Cat.mauve.with-alpha(0.07) :
                (touch.has-hover ? Cat.surface0.with-alpha(0.45) : transparent);
    animate background { duration: 80ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 14px;

        if show-checkbox: VerticalLayout {
            alignment: center;
            CheckBox {
                checked: pkg.selected;
                toggled(val) => { root.toggle-selected(val); }
            }
        }

        VerticalLayout {
            alignment: center;
            PkgIcon { name: pkg.backend == 0 ? pkg.name : (pkg.backend == 1 ? "flatpak:" + pkg.name : "appimage:" + pkg.name); size: 42px; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;

            Text {
                text: pkg.display-name;
                font-size: Cat.fs15;
                font-weight: 600;
                color: pkg.has-update ? Cat.peach : Cat.text;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: pkg.version;
                    font-size: Cat.fs13;
                    font-weight: 500;
                    color: pkg.has-update ? Cat.peach.with-alpha(0.8) : Cat.mauve.with-alpha(0.7);
                    vertical-alignment: center;
                }

                if pkg.description != "": Text {
                    text: "·";
                    font-size: Cat.fs13;
                    color: Cat.overlay0;
                    vertical-alignment: center;
                }

                if pkg.description != "": Text {
                    text: pkg.description;
                    font-size: Cat.fs13;
                    color: Cat.subtext0;
                    opacity: 0.9;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        if pkg.explicit: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 58px;
                height: 22px;
                border-radius: 4px;
                background: Cat.mauve.with-alpha(0.18);
                border-width: 1px;
                border-color: Cat.mauve.with-alpha(0.35);
                Text {
                    text: @tr("explicit");
                    font-size: Cat.fs11;
                    font-weight: 600;
                    color: Cat.mauve;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if pkg.repository != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: repo-text.preferred-width + 14px;
                height: 22px;
                border-radius: 4px;
                background: pkg.backend == 1
                    ? Cat.teal.with-alpha(0.15)
                    : (pkg.backend == 3 ? Cat.yellow.with-alpha(0.15) : Cat.surface0);
                border-width: pkg.backend == 1 ? 1px : 0px;
                border-color: Cat.teal.with-alpha(0.3);

                repo-text := Text {
                    text: pkg.repository;
                    font-size: Cat.fs11;
                    color: pkg.backend == 1 ? Cat.teal : Cat.overlay1;
                    font-weight: pkg.backend == 1 ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if show-action-button: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 88px;
                height: 34px;
                border-radius: 6px;
                background: pkg.has-update
                    ? Cat.teal.with-alpha(0.15)
                    : (pkg.installed ? Cat.red.with-alpha(0.15) : Cat.mauve.with-alpha(0.15));

                Text {
                    text: pkg.has-update ? "Update" : (pkg.installed ? "Remove" : "Install");
                    font-size: Cat.fs13;
                    font-weight: 600;
                    color: pkg.has-update ? Cat.teal : (pkg.installed ? Cat.red : Cat.mauve);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if pkg.has-update { root.install(); }
                        else if pkg.installed { root.remove(); }
                        else { root.install(); }
                    }
                }
            }
        }
    }

    if show-separator: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Cat.surface0;
        opacity: 0.6;
    }
}

component CategoryPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: pill-lbl.preferred-height + 10px;
    width: pill-lbl.preferred-width + 22px;
    border-radius: 10px;
    background: active ? Cat.mauve : (pill-t.has-hover ? Cat.surface1 : Cat.surface0.with-alpha(0.6));
    animate background { duration: 80ms; }

    pill-lbl := Text {
        text: label;
        font-size: Cat.fs15;
        font-weight: active ? 700 : 400;
        color: active ? Cat.crust : Cat.subtext0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    pill-t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RepoRow inherits Rectangle {
    in property <PackageData> pkg;
    in property <bool> show-checkbox: false;
    in property <bool> checked: false;
    callback install();
    callback remove();
    callback show-tree();
    callback show-info();
    callback toggle-selected(bool);

    height: 62px;
    background: pkg.selected ? Cat.mauve.with-alpha(0.07) : (row-touch.has-hover ? Cat.surface0.with-alpha(0.3) : transparent);
    animate background { duration: 60ms; }

    row-touch := TouchArea {
        clicked => { if show-checkbox { root.toggle-selected(!pkg.selected); } }
    }

    HorizontalLayout {
        padding-left: 16px; padding-right: 14px; spacing: 12px;

        if show-checkbox: VerticalLayout {
            alignment: center;
            CheckBox {
                checked: pkg.selected;
                toggled(val) => { root.toggle-selected(val); }
            }
            width: 32px;
        }

        VerticalLayout {
            alignment: center;
            PkgIcon { name: pkg.name; size: 38px; }
        }

        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 4px;
            Text { text: pkg.display-name; font-size: Cat.fs15; font-weight: 600; color: Cat.text; overflow: elide; }
            if pkg.description != "": Text { text: pkg.description; font-size: Cat.fs13; color: Cat.subtext0; opacity: 0.85; overflow: elide; }
        }

        Rectangle {
            width: 120px;
            Text { text: pkg.version; font-size: Cat.fs13; color: Cat.mauve.with-alpha(0.75); overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
        }

        Rectangle {
            width: 80px;
            Rectangle {
                width: rep-t.preferred-width + 14px; height: 22px; border-radius: 4px; background: Cat.surface0;
                x: parent.width - self.width; y: (parent.height - self.height) / 2;
                rep-t := Text { text: pkg.repository; font-size: Cat.fs11; color: Cat.overlay1; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        VerticalLayout {
            alignment: center; width: 235px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 64px; height: 32px; border-radius: 6px;
                    background: rr-tree-ta.has-hover ? Cat.teal.with-alpha(0.25) : Cat.teal.with-alpha(0.12);
                    border-width: 1px; border-color: Cat.teal.with-alpha(0.35);
                    animate background { duration: 60ms; }
                    VerticalLayout { alignment: center; Text { text: @tr("Tree"); font-size: Cat.fs13; font-weight: 600; color: Cat.teal; horizontal-alignment: center; } }
                    rr-tree-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-tree(); } }
                }
                Rectangle {
                    width: 64px; height: 32px; border-radius: 6px;
                    background: rr-info-ta.has-hover ? Cat.blue.with-alpha(0.25) : Cat.blue.with-alpha(0.12);
                    border-width: 1px; border-color: Cat.blue.with-alpha(0.35);
                    animate background { duration: 60ms; }
                    VerticalLayout { alignment: center; Text { text: @tr("Info"); font-size: Cat.fs13; font-weight: 600; color: Cat.blue; horizontal-alignment: center; } }
                    rr-info-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-info(); } }
                }
                if !pkg.installed: Rectangle {
                    width: 90px; height: 32px; border-radius: 6px;
                    background: rr-inst-ta.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.75);
                    animate background { duration: 60ms; }
                    VerticalLayout { alignment: center; Text { text: @tr("Install"); font-size: Cat.fs13; font-weight: 600; color: #fff; horizontal-alignment: center; } }
                    rr-inst-ta := TouchArea { mouse-cursor: pointer; clicked => { root.install(); } }
                }
                if pkg.installed: Rectangle {
                    width: 90px; height: 32px; border-radius: 6px;
                    background: rr-rm-ta.has-hover ? Cat.red : Cat.red.with-alpha(0.75);
                    animate background { duration: 60ms; }
                    VerticalLayout { alignment: center; Text { text: @tr("Remove"); font-size: Cat.fs13; font-weight: 600; color: #fff; horizontal-alignment: center; } }
                    rr-rm-ta := TouchArea { mouse-cursor: pointer; clicked => { root.remove(); } }
                }
            }
        }
    }

    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width - 20px; x: 10px; background: Cat.surface0.with-alpha(0.5); }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> subtitle: "";
    in property <bool> checked: false;
    in property <color> accent: Cat.mauve;
    callback toggled(bool);

    height: 66px;
    border-radius: 8px;
    background: accent.with-alpha(0.07);
    border-width: 1.5px;
    border-color: accent.with-alpha(0.5);
    preferred-width: 0px;
    clip: true;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: label;
                font-size: Cat.fs14;
                color: Cat.text;
                overflow: elide;
            }

            if subtitle != "": Text {
                text: subtitle;
                font-size: Cat.fs13;
                color: Cat.overlay0;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            CheckBox {
                checked: root.checked;
                toggled(val) => { root.toggled(val); }
            }
        }
    }
}

component SettingsLinkRow inherits Rectangle {
    in property <string> label;
    in property <string> subtitle: "";
    in property <color> accent: Cat.mauve;
    callback clicked;

    height: 66px;
    border-radius: 8px;
    background: link-ta.has-hover ? accent.with-alpha(0.14) : accent.with-alpha(0.07);
    border-width: 1.5px;
    border-color: accent.with-alpha(0.5);
    preferred-width: 0px;
    clip: true;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: label; font-size: Cat.fs14; color: Cat.text; overflow: elide; }
            if subtitle != "": Text { text: subtitle; font-size: Cat.fs13; color: Cat.overlay0; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            NavIcon { d: "M9 18l6-6-6-6"; icon-color: Cat.overlay0; width: 14px; height: 14px; }
        }
    }

    link-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}



component SectionLabel inherits Text {
    in property <string> section-title;
    text: section-title;
    font-size: Cat.fs15;
    font-weight: 700;
    color: Cat.overlay0;
    letter-spacing: 0.8px;
}

component Paginator inherits Rectangle {
    in property <int> current-page;
    in property <int> total-pages;
    callback go-to-page(int);

    height: 40px;

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        Rectangle {
            width: 32px;
            height: 25px;
            border-radius: 6px;
            background: current-page > 0 ? (prev-touch.has-hover ? Cat.surface1 : Cat.surface0) : Cat.surface0.with-alpha(0.3);

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    NavIcon {
                        d: "M15 18l-6-6 6-6";
                        icon-color: current-page > 0 ? Cat.text : Cat.overlay0;
                        width: 14px;
                        height: 14px;
                    }
                }
            }

            prev-touch := TouchArea {
                mouse-cursor: current-page > 0 ? pointer : default;
                clicked => { if current-page > 0 { root.go-to-page(current-page - 1); } }
            }
        }

        Text {
            text: (current-page + 1) + " / " + total-pages;
            font-size: Cat.fs13;
            font-weight: 500;
            color: Cat.subtext0;
            vertical-alignment: center;
            min-width: 60px;
            horizontal-alignment: center;
        }

        Rectangle {
            width: 32px;
            height: 25px;
            border-radius: 6px;
            background: current-page < total-pages - 1 ? (next-touch.has-hover ? Cat.surface1 : Cat.surface0) : Cat.surface0.with-alpha(0.3);

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    NavIcon {
                        d: "M9 18l6-6-6-6";
                        icon-color: current-page < total-pages - 1 ? Cat.text : Cat.overlay0;
                        width: 14px;
                        height: 14px;
                    }
                }
            }

            next-touch := TouchArea {
                mouse-cursor: current-page < total-pages - 1 ? pointer : default;
                clicked => { if current-page < total-pages - 1 { root.go-to-page(current-page + 1); } }
            }
        }
    }
}

component DetailProperty inherits HorizontalLayout {
    in property <string> prop-label;
    in property <string> prop-value;
    spacing: 8px;

    Text {
        text: prop-label;
        width: 80px;
        font-size: Cat.fs12;
        color: Cat.overlay0;
        vertical-alignment: top;
    }

    Text {
        text: prop-value;
        font-size: Cat.fs12;
        color: Cat.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}


// One boolean permission row: marker dot (overridden) + label + switch.
component PermToggleRow inherits Rectangle {
    in property <PermToggle> t;
    callback changed(bool);
    height: 36px;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        VerticalLayout { alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: t.overridden ? Cat.mauve : transparent; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: t.label; font-size: Cat.fs13; color: Cat.text; overflow: elide; }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: 40px; height: 22px; border-radius: 11px;
                background: t.value ? Cat.green.with-alpha(0.85) : Cat.surface1;
                animate background { duration: 90ms; }
                Rectangle {
                    width: 16px; height: 16px; border-radius: 8px; background: Cat.text; y: 3px;
                    x: t.value ? parent.width - self.width - 3px : 3px;
                    animate x { duration: 100ms; easing: ease-out; }
                }
                ptr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.changed(!t.value); } }
            }
        }
    }
}

// One list-type permission row (filesystem/bus/env/persist): text + remove.
component PermEntryRow inherits Rectangle {
    in property <PermEntry> e;
    callback removed();
    height: 32px;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        VerticalLayout { alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: e.overridden ? Cat.mauve : transparent; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: e.mode == "" ? e.value : e.value + "  (" + e.mode + ")"; font-size: Cat.fs13; color: Cat.text; overflow: elide; }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: 24px; height: 24px; border-radius: 6px;
                background: per-rm.has-hover ? Cat.red.with-alpha(0.25) : Cat.surface1;
                animate background { duration: 60ms; }
                NavIcon { d: "M18 6L6 18M6 6l12 12"; icon-color: Cat.red; width: 11px; height: 11px; x: 6px; y: 6px; }
                per-rm := TouchArea { mouse-cursor: pointer; clicked => { root.removed(); } }
            }
        }
    }
}

// Section heading inside the permission panel.
component PermSectionLabel inherits Rectangle {
    in property <string> text-value;
    height: 28px;
    HorizontalLayout {
        padding-left: 8px;
        VerticalLayout { alignment: center;
            Text { text: text-value; font-size: Cat.fs11; font-weight: 700; color: Cat.mauve; letter-spacing: 0.6px; }
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <string> kind: "secondary";
    callback clicked;

    height: 34px;
    width: max(92px, db-label.preferred-width + 32px);
    border-radius: 8px;
    border-width: kind == "secondary" ? 1px : 0px;
    border-color: Cat.divider;
    background: kind == "primary" ? (db-touch.has-hover ? Cat.mauve : Cat.mauve.with-alpha(0.9))
        : kind == "danger" ? (db-touch.has-hover ? Cat.red.with-alpha(0.3) : Cat.red.with-alpha(0.16))
        : (db-touch.has-hover ? Cat.surface1 : Cat.surface0);
    animate background { duration: 100ms; }

    db-label := Text {
        text: root.label;
        font-size: Cat.fs13;
        font-weight: 600;
        color: kind == "primary" ? Cat.crust : kind == "danger" ? Cat.red : Cat.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    db-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ProgressTrack inherits Rectangle {
    in property <int> percent;
    in property <bool> indeterminate;
    in property <bool> done;
    in property <bool> success;
    in property <int> tick;

    height: 6px;
    border-radius: 3px;
    background: Cat.surface1;
    clip: true;

    Rectangle {
        visible: !root.indeterminate;
        x: 0px;
        height: parent.height;
        width: parent.width * (root.done ? 1.0 : clamp(root.percent / 100.0, 0.0, 1.0));
        border-radius: 3px;
        background: root.done ? (root.success ? Cat.green : Cat.red) : Cat.mauve;
        animate width { duration: 180ms; easing: ease-out; }
    }

    Rectangle {
        visible: root.indeterminate;
        width: parent.width * 0.3;
        height: parent.height;
        border-radius: 3px;
        background: Cat.mauve;
        x: parent.width * 1.3 * (mod(root.tick * 1.0, 30.0) / 30.0) - parent.width * 0.3;
    }
}

component ProgressDialog inherits Rectangle {
    in property <string> title;
    in property <string> stage;
    in property <int> percent;
    in property <bool> done;
    in property <bool> success;
    in-out property <bool> details-open;
    in property <string> output;
    in property <string> error-summary;
    in property <string> prompt;
    in property <bool> show-input;
    in property <bool> show-buttons;
    in property <bool> cancellable;
    in property <bool> upgrade;
    in-out property <bool> input-focus-pending;
    callback close();
    callback cancel();
    callback send-input(string);
    callback proceed();
    callback reboot();

    property <int> tick: 0;
    Timer {
        interval: 60ms;
        running: !root.done;
        triggered => { root.tick += 1; }
    }

    background: black.with-alpha(0.6);
    TouchArea {}

    Rectangle {
        width: min(680px, parent.width - 40px);
        height: min(parent.height - 40px, root.details-open ? 580px : dlg-layout.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        animate height { duration: 200ms; easing: ease-in-out; }
        background: Cat.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: Cat.divider;
        clip: true;
        drop-shadow-blur: 32px;
        drop-shadow-color: black.with-alpha(0.5);
        drop-shadow-offset-y: 10px;

        dlg-layout := VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 68px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 14px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: root.done
                                ? (root.success ? Cat.green.with-alpha(0.16) : Cat.red.with-alpha(0.16))
                                : Cat.mauve.with-alpha(0.14);
                            if !root.done: LoadingCircle { diameter: 22px; x: 8px; y: 8px; }
                            if root.done: NavIcon {
                                d: root.success ? "M20 6L9 17l-5-5" : "M18 6L6 18M6 6l12 12";
                                icon-color: root.success ? Cat.green : Cat.red;
                                width: 18px;
                                height: 18px;
                                x: 10px;
                                y: 10px;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.title;
                            font-size: Cat.fs16;
                            font-weight: 700;
                            color: Cat.text;
                            overflow: elide;
                        }
                        Text {
                            text: root.done
                                ? (root.success ? @tr("Completed successfully") : @tr("Finished with errors"))
                                : root.stage;
                            font-size: Cat.fs12;
                            color: root.done ? (root.success ? Cat.green : Cat.red) : Cat.overlay1;
                            overflow: elide;
                        }
                    }

                    if root.done: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: dlg-x-touch.has-hover ? Cat.surface1 : transparent;
                            NavIcon {
                                d: "M18 6L6 18M6 6l12 12";
                                icon-color: Cat.overlay1;
                                width: 12px;
                                height: 12px;
                                x: 9px;
                                y: 9px;
                            }
                            dlg-x-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Cat.divider; }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        ProgressTrack {
                            percent: root.percent;
                            indeterminate: !root.done && root.percent < 3;
                            done: root.done;
                            success: root.success;
                            tick: root.tick;
                        }
                    }
                    Text {
                        width: 44px;
                        text: (!root.done && root.percent >= 3) ? root.percent + "%" : "";
                        font-size: Cat.fs12;
                        font-weight: 600;
                        color: Cat.overlay2;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                if root.show-input: Rectangle {
                    border-radius: 10px;
                    background: Cat.yellow.with-alpha(0.08);
                    border-width: 1px;
                    border-color: Cat.yellow.with-alpha(0.35);

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                NavIcon {
                                    d: "M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 14v-4m0-4h.01";
                                    icon-color: Cat.yellow;
                                    width: 15px;
                                    height: 15px;
                                }
                            }
                            Text {
                                text: root.prompt;
                                font-size: Cat.fs13;
                                font-weight: 600;
                                color: Cat.yellow;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if !root.show-buttons: HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 8px;
                                background: Cat.surface0;
                                border-width: 1px;
                                border-color: prompt-ti.has-focus ? Cat.yellow.with-alpha(0.7) : Cat.divider;
                                animate border-color { duration: 80ms; }

                                Timer {
                                    interval: 8ms;
                                    running: root.input-focus-pending;
                                    triggered => {
                                        root.input-focus-pending = false;
                                        prompt-ti.focus();
                                    }
                                }
                                TouchArea { clicked => { prompt-ti.focus(); } }
                                prompt-ti := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    color: Cat.text;
                                    font-size: Cat.fs13;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        root.send-input(self.text);
                                        self.text = "";
                                    }
                                }
                                if prompt-ti.text == "" && !prompt-ti.has-focus: Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: @tr("Type response and press Enter…");
                                    font-size: Cat.fs13;
                                    color: Cat.overlay0;
                                    vertical-alignment: center;
                                }
                            }

                        }
                    }
                }

                if root.error-summary != "" && !root.details-open: Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: Cat.red.with-alpha(0.1);
                    border-width: 1px;
                    border-color: Cat.red.with-alpha(0.3);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z";
                                icon-color: Cat.red;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text {
                            text: root.error-summary;
                            font-size: Cat.fs12;
                            color: Cat.red;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.details-open = true; }
                    }
                }

                Rectangle {
                    height: 24px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: root.details-open ? @tr("Hide details") : @tr("Show details");
                            font-size: Cat.fs12;
                            font-weight: 600;
                            color: det-touch.has-hover ? Cat.mauve : Cat.overlay2;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            NavIcon {
                                d: root.details-open ? "M6 15l6-6 6 6" : "M6 9l6 6 6-6";
                                icon-color: det-touch.has-hover ? Cat.mauve : Cat.overlay2;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                    det-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.details-open = !root.details-open; }
                    }
                }
            }

            if root.details-open: Rectangle {
                vertical-stretch: 1;
                background: Cat.crust;

                VerticalLayout {
                    ScrollView {
                        vertical-stretch: 1;
                        content-y: { let _ = root.tick; min(0px, self.visible-height - self.content-height); }
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.output;
                                font-size: Cat.fs12;
                                font-family: "JetBrains Mono";
                                color: Cat.text;
                                wrap: no-wrap;
                            }
                        }
                    }

                }
            }

            Rectangle { height: 1px; background: Cat.divider; }

            Rectangle {
                height: 62px;
                background: Cat.surface0.with-alpha(0.3);
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 10px;
                    alignment: end;

                    if root.done && root.success && root.upgrade: VerticalLayout {
                        alignment: center;
                        DialogButton { label: @tr("Reboot System"); clicked => { root.reboot(); } }
                    }
                    if !root.done && !(root.show-input && root.show-buttons): VerticalLayout {
                        alignment: center;
                        DialogButton {
                            label: root.cancellable ? @tr("Cancel") : @tr("Hide");
                            kind: root.cancellable ? "danger" : "secondary";
                            clicked => { if root.cancellable { root.cancel(); } else { root.close(); } }
                        }
                    }
                    if !root.done && root.show-input && root.show-buttons: VerticalLayout {
                        alignment: center;
                        DialogButton { label: @tr("No"); kind: "danger"; clicked => { root.send-input("n"); } }
                    }
                    if !root.done && root.show-input && root.show-buttons: VerticalLayout {
                        alignment: center;
                        DialogButton { label: @tr("Yes"); kind: "primary"; clicked => { root.proceed(); } }
                    }
                    if root.done: VerticalLayout {
                        alignment: center;
                        DialogButton { label: @tr("Close"); kind: "primary"; clicked => { root.close(); } }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("XeroLinux Package Manager GUI");
    default-font-family: "Noto Sans";
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 960px;
    min-height: 600px;
    background: Palette.background;

    in-out property <int> view: 9;
    in-out property <[PackageData]> installed-packages: [];
    in-out property <[PackageData]> update-packages: [];
    in-out property <[PackageData]> flatpak-update-packages: [];
